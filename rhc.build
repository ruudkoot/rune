(* rhc, the Haskell 98 compiler of the haskell98 roadmap
   (docs/plans/language/haskell98.md): its front end and Core from
   lib/language/haskell, the parts of the compiler's library it is written
   on, which that library names it a friend to use (D41), and its driver.
   src/rhc/config.sml, rhc's own version and identity, is what make writes
   with `scripts/gen-version.sh --config rhc.plan src/rhc/config.sml`
   (docs/building.md, The compiler's identity), so that an edit of rhc's
   sources changes its identity and not rune's. Rune alone builds it (D42):
   rhc.plan is read by no host. *)
libraries language/haskell unicode json end
src/rhc/config.sml
use lib/compiler/mid.build
files
  src/rhc/options.sml
  src/rhc/library.sml
  src/rhc/graph.sml
  src/rhc/names.sml
  src/rhc/world.sml
  src/rhc/lint.sml
  src/rhc/desugar.sml
  src/rhc/syntax.sml
  src/rhc/store.sml
  src/rhc/storeconfig.sml
  src/rhc/main.sml
end
src/main/rhc-main.sml
