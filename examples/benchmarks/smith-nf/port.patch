+structure Benchmark=struct val name="smith-nf"
+fun one n=let fun entry(i,j)=List.nth(List.nth(Table.table,i),j)
+val big=Matrix.map(Matrix.make(n,n,entry),IntInf.fromInt)
+val result=SmithNormalForm.smithNormalForm big
+fun check(i,j)=if i=n then()else if j=n then check(i+1,0)else(if i<>j andalso Matrix.fetch(result,i,j)<>0 then raise Fail "Smith off-diagonal"else();check(i,j+1))
+val _=check(0,0)
+in String.concatWith ","(List.tabulate(n,fn i=>IntInf.toString(Matrix.fetch(result,i,i))))end
+fun run [dimension,reps]=let val n=BenchInput.between(2,33)(BenchInput.integer dimension)val r=BenchInput.between(1,5)(BenchInput.integer reps)
+fun loop(0,acc)=String.concatWith ";"(List.rev acc)|loop(k,acc)=loop(k-1,one n::acc)
+in loop(r,[])end |run _=raise Fail "Smith expects dimension repetitions"end
