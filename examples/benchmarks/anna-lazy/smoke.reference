   Leaf ::                   (tree a)
   Branch ::                 (tree a) ->  a ->  (tree a) ->  (tree a)
   NilAssoc ::               (assoc a b)
   Assoc ::                  a ->  b ->  (assoc a b) ->  (assoc a b)
   True ::                   bool
   False ::                  bool


