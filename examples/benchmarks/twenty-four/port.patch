+structure Benchmark =
+struct
+  val name="twenty-four"
+  fun allHands curr left=if left<0 orelse left>curr then [] else if curr=0 then [[]]
+    else List.@(List.map(fn y=>curr::y)(allHands(curr-1)(left-1)),allHands(curr-1)left)
+  fun solutions hand=TwentyFour.solve hand (fn(_,resume)=>1+resume())(fn()=>0)
+  fun run [mode,deck,reps]=
+    let val n=BenchInput.between(4,10)(BenchInput.integer deck)
+        val count=BenchInput.between(1,250)(BenchInput.integer reps)
+        val hands=if mode="sample" then [[4,7,8,8]] else if mode="deck" then allHands n 4 else raise Fail "hand mode"
+        fun one()=List.foldl(fn(hand,sum)=>sum+solutions hand)0 hands
+    in IntInf.toString(BenchInput.repeat count one) end
+  | run _=raise Fail "twenty-four expects mode deck-bound repetitions"
+end
