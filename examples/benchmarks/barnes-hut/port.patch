+
+structure BH = Main(Vector3)
+structure Benchmark =
+struct
+  val name="barnes-hut"
+  fun realArg s = case Real.fromString s of SOME r=>r | NONE=>raise Fail "invalid real argument"
+  fun bodies n stop =
+    let val _=BH.srand 123
+        val bodies=BH.testdata n
+        val calls=ref 0
+        val _=BH.go{output=fn _=>calls:= !calls+1,bodies=bodies,tnow=0.0,tstop=stop,
+          dtime=0.025,eps=0.05,tol=1.0,rmin=BH.S.V.tabulate(fn _=> ~2.0),rsize=4.0}
+    in (bodies,!calls) end
+  fun coordinates (BH.S.Body{pos,vel,...}) = BH.S.V.explode(!pos) @ BH.S.V.explode(!vel)
+  fun run [size,until,file] =
+    let val n=BenchInput.between(2,8192)(BenchInput.integer size)
+        val stop=realArg until
+        val _=if stop>=0.05 andalso stop<=2.0 then () else raise Fail "stop time"
+        val _=if List.exists(fn p=>p=file)["expected/smoke.tsv","expected/normal.tsv","expected/large.tsv"] then () else raise Fail "reference file"
+        val(actual,calls)=bodies n stop
+        val input=TextIO.openIn file
+        fun read ()=case TextIO.inputLine input of NONE=>NONE | SOME line=>SOME(List.map realArg(String.tokens Char.isSpace line))
+        fun equal ([],[])=true
+          | equal(x::xs,y::ys)=BenchInput.closeReal(x,y,0.00000001,0.000001) andalso equal(xs,ys)
+          | equal _=false
+        fun check []=if Option.isSome(read()) then raise Fail "extra reference body" else ()
+          | check(b::bs)=case read() of NONE=>raise Fail "missing reference body" | SOME values=>
+              if equal(coordinates b,values) then check bs else raise Fail "body state differs"
+        val _=(check actual handle e=>(TextIO.closeIn input;raise e))
+        val _=TextIO.closeIn input
+    in Int.toString(List.length actual)^" "^Int.toString calls end
+  | run _=raise Fail "barnes-hut expects body-count stop-time reference"
+end
