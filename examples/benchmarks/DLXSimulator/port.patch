+
+structure Benchmark =
+struct
+  val name="DLXSimulator"
+  fun one (instructions,inputs) =
+    let fun inputFn {state=(inputs,outputs)}=case inputs of []=>{input=0,state=([],outputs)} | x::xs=>{input=x,state=(xs,outputs)}
+        fun outputFn {output,state=(inputs,outputs)}={state=(inputs,output::outputs)}
+        val {state=(_,outputs),statistics}=DLXSimulatorC1.run_prog{instructions=instructions,trap={inputFn=inputFn,outputFn=outputFn,state=(inputs,[])}}
+    in List.map Int.toString outputs end
+  fun run [reps] =
+    let val n=BenchInput.between(1,1000)(BenchInput.integer reps)
+        fun loop(0,acc)=String.concatWith " " (List.rev acc)
+          | loop(k,acc)=let val result=List.concat(List.map one [(Simple,[]),(Twos,[10]),(Abs,[~10]),(Fact,[12]),(GCD,[123456789,98765])])
+                       in loop(k-1,List.revAppend(result,acc)) end
+    in loop(n,[]) end
+  | run _=raise Fail "DLXSimulator expects repetitions"
+end
