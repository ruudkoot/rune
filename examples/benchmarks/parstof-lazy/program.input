main ip =
  i2str (optim (myMain deciem))
;

TYPE tJobdef    = [ JOBDEF, int, int, int, tJobdef, tJobdef ] ;
TYPE tJobstat   = [ JOBSTAT, int, int, int, int, tJobdef ] ;
TYPE tTree      = [ LEAF, int |
                    TREE, tTree, tTree ] ;
TYPE tProc      = [ PROC, int, tJobstat ] ;



emptyjobdef     = [JOBDEF, 0     , 0 , 0, emptyjobdef, emptyjobdef] ;
solo            = [JOBDEF, 1     , 0, 10, emptyjobdef, emptyjobdef] ;
trio            = [JOBDEF, 1    , 10, 20     , child1     , child2] ;

child1          = [JOBDEF, 2     , 0, 30, emptyjobdef, emptyjobdef] ;
child2          = [JOBDEF, 3     , 0, 10, emptyjobdef, emptyjobdef] ;

