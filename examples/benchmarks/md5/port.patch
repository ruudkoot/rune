+
+structure Benchmark =
+struct
+  val name = "md5"
+  fun run [length,blocks] =
+        let val n = BenchInput.between (1,10000) (BenchInput.integer length)
+            val count = BenchInput.between (1,100000) (BenchInput.integer blocks)
+            val block = Word8Vector.tabulate(n,Word8.fromInt)
+            fun loop(0,state)=state | loop(k,state)=loop(k-1,MD5.update(state,block))
+        in MD5.toHexString(MD5.final(loop(count,MD5.init))) end
+    | run _ = raise Fail "md5 expects block bytes count"
+end
