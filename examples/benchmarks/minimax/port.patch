+
+structure Benchmark =
+struct
+  val name="minimax"
+  fun summary (TicTacToe.Rose((_,score),kids)) =
+    let fun child(tree,(count,depth))=let val(n,d,_)=summary tree in(count+n,Int.max(depth,d))end
+        val(count,depth)=List.foldl child (0,0)kids
+    in(count+1,depth+1,score)end
+  fun one() =
+    let val(n,d,s)=summary(TicTacToe.gameTree())
+        val(n2,d2,s2)=summary(TicTacToe.gameTreeWithTT())
+        val _=if s=0 andalso s2=0 then () else raise Fail "tic-tac-toe root score"
+    in String.concatWith " "(List.map Int.toString[n,d,s,n2,d2,s2])end
+  fun run [reps]=
+    let val count=BenchInput.between(1,10)(BenchInput.integer reps)
+        fun loop(0,values)=String.concatWith ";"(List.rev values)
+          | loop(k,values)=loop(k-1,one()::values)
+    in loop(count,[])end
+  | run _=raise Fail "minimax expects full-tree repetitions"
+end
