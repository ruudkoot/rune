  _nasty = \x -> _loop
in let
  _concat2 = \ -> _foldr _append Nil
in let
  _add)245 = \x y -> _+ x y
in let
  _sum2 = \ -> _foldr _add)245 0
in let
  _hd = \l -> case l of
                Nil  -> _nasty 0;
                Cons x xs -> x
              end
in letrec
  _rev = \acc lisp -> case lisp of
                        Nil  -> acc;
