                        Cons f fs -> Cons (f v) (_backMap fs v)
                      end
in let
  _g = \ -> _backMap (Cons _not (Cons _not Nil)) False
in let
  _add1 = \x -> _+ 1 x
in let
  _hof = \f y -> _+ 1 (f y)
in let
  _id = \x -> x
in let
  _useHOF = \ -> _hof _id (_hof (_id _id _add1) 43)
in letrec
  _loop = \ -> _loop
