                                          True  -> _dropWhile p xsp;
                                          False  -> xl
                                        end
                        end
in letrec
  _span = \p xs -> case xs of
                     Nil  -> Pair Nil Nil;
                     Cons x xsp -> case p x of
                                     False  -> Pair Nil xs;
                                     True  -> case _span p xsp of
