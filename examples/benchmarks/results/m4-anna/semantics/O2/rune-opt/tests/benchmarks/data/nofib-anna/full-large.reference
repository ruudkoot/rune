letrec
  _error = \ -> _error
in let
  _dot)1 = \f g x -> f (g x)
in let
  _flip = \f x y -> f y x
in let
  _max = \x y -> case _> x y of
                   True  -> x;
                   False  -> y
                 end
in let
  _min = \x y -> case _< x y of
                   True  -> x;
                   False  -> y
                 end
in let
  _head = \l -> case l of
                  Cons x xs -> x;
                  Nil  -> _error
                end
in letrec
  _last = \l -> case l of
                  Nil  -> _error;
                  Cons x xs -> case xs of
                                 Nil  -> x;
                                 Cons y ys -> _last xs
                               end
                end
in let
