structure AnnaDemand : 
  sig
    structure L : <sig>
    structure F : <sig>
    structure C : <sig>
    structure W : <sig>
    structure S : <sig>
    type integer = Word64.word BenchNeed.t
    type nameNode = char F.node
    type name = char F.seq
    datatype ('a,'b) treeNode
      = ABranch of ('a,'b) treeNode D.t * 'a D.t * 'b D.t
                    * ('a,'b) treeNode D.t * integer
    | ALeaf
    datatype ('a,'b) replyNode = Failed of 'b D.t | Ok of 'a D.t
    datatype 'a setNode = MkSet of 'a F.seq
    datatype 'a maybeNode = Just of 'a D.t | Nothing
    datatype flagNode
      = DryRun
    | ForceAll
    | LowerLim of integer
    | MonoLim of integer
    | NoBaraki
    | NoCaseOpt
    | NoFormat
    | NoPretty
    | PolyLim of integer
    | ScaleUp of integer
    | ShowHExpr
    | Simp
    | SimpleInv
    | Typecheck
    | UpperLim of integer
    type flags = flagNode F.seq
    datatype tdefNode = TDefCons of name * tdefNode F.seq | TDefVar of name
    type typeDef = name * nameNode F.seq * (name * tdefNode F.seq) F.seq
    datatype 'a coreNode
      = EAp of 'a coreNode D.t * 'a coreNode D.t
    | ECase of 'a coreNode D.t
                * (name * ('a F.seq * 'a coreNode D.t) D.t) F.seq
    | EConstr of name
    | ELam of 'a F.seq * 'a coreNode D.t
    | ELet of bool D.t * ('a D.t * 'a coreNode D.t) F.seq * 'a coreNode D.t
    | ENum of integer
    | EVar of name
    datatype eqnNode
      = EqnNVC of name * nameNode setNode D.t * nameNode setNode D.t
    type core = nameNode coreNode BenchNeed.t
    type coreProgram =
      typeDef F.seq * (name * (nameNode F.seq * core) BenchNeed.t) F.seq
    type atomicProgram = typeDef F.seq * core
    datatype ('a,'b) annNode
      = AAp of ('a,'b) ann * ('a,'b) ann
    | ACase of ('a,'b) ann * (name * ('a F.seq * ('a,'b) ann) D.t) F.seq
    | AConstr of name
    | ALam of 'a F.seq * ('a,'b) ann
    | ALet of bool D.t * ('a D.t * ('a,'b) ann) F.seq * ('a,'b) ann
    | ANum of integer
    | AVar of name
    type ('a,'b) ann =
      ('b BenchNeed.t * ('a,'b) annNode BenchNeed.t) BenchNeed.t
    type tvname = Word64.word F.seq * Word64.word F.seq
    datatype typeNode
      = TArr of typeNode D.t * typeNode D.t
    | TCons of name * typeNode F.seq
    | TVar of tvname D.t
    type texpr = typeNode BenchNeed.t
    datatype schemeNode = Scheme of tvname F.seq * texpr
    type typeEnv = (name * schemeNode BenchNeed.t) F.seq
    type subst = (tvname BenchNeed.t * texpr) F.seq
    type fullTypeEnv = (name * texpr) F.seq
    datatype domainNode
      = Func of domainNode F.seq * domainNode D.t
    | Lift1 of domainNode F.seq
    | Lift2 of domainNode F.seq
    | Two
    type domain = domainNode BenchNeed.t
    datatype routeNode
      = One
    | Rep of repNode D.t
    | Stop1
    | Stop2
    | Up1 of routeNode F.seq
    | Up2
    | UpUp2 of routeNode F.seq
    | Zero
    datatype repNode
      = Rep1 of frontierNode D.t * repNode F.seq
    | Rep2 of frontierNode D.t * frontierNode D.t * repNode F.seq
    | RepTwo of frontierNode D.t
    datatype frontierNode
      = Min1Max0 of integer * frontierElemNode F.seq * frontierElemNode F.seq
    datatype frontierElemNode = MkFrel of routeNode F.seq
    type route = routeNode BenchNeed.t
    type representation = repNode BenchNeed.t
    type frontier = frontierNode BenchNeed.t
    type frontierElem = frontierElemNode BenchNeed.t
    type point = domain * route
    datatype dexprNode
      = DXFunc of dexprNode F.seq * dexprNode D.t
    | DXLift1 of dexprNode F.seq
    | DXLift2 of dexprNode F.seq
    | DXTwo
    | DXVar of name
    type dexpr = dexprNode BenchNeed.t
    datatype constructorNode = ConstrRec | ConstrVar of integer
    datatype acMode = Live | Safe
    datatype appInfoNode
      = A2
    | AHi1 of integer * integer * domain
    | AHi2 of integer * integer * domain
    | ALo1
    | ALo2
    | AMid2
    datatype 'a hexprNode
      = HApp of 'a hexprNode D.t * 'a hexprNode D.t
    | HLam of 'a F.seq * 'a hexprNode D.t
    | HMeet of 'a hexprNode F.seq
    | HPoint of route
    | HTable of (route * 'a hexprNode D.t) F.seq
    | HVAp of 'a hexprNode D.t * 'a hexprNode F.seq
    | HVar of 'a D.t
    type hexpr = nameNode hexprNode BenchNeed.t
    datatype 'a exceptionIntNode = MkExInt of integer * 'a F.seq
    type domainInt = domainNode exceptionIntNode BenchNeed.t
    type oneFuncSize = integer * domainNode F.seq
    datatype infoNode
      = SAGiveUp of nameNode F.seq
    | SAHExpr of name * hexpr
    | SAResult of name * domain * route
    | SASL of routeNode F.seq * routeNode F.seq
