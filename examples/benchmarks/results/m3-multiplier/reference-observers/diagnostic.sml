structure P=BenchMultiplierFn(struct val eagerBinary=false end)
val(a,b,r,ra,rb,product)=P.multsys 4(P.inputs 1)
fun out name value=(print(name^" "^value^"\n");TextIO.flushOut TextIO.stdOut)
val _=out "ready0"(Int.toString(BenchStream.head r))
val _=out "a0"(P.signed(BenchStream.head(P.intrep a)))
val _=out "b0"(P.signed(BenchStream.head(P.intrep b)))
val _=out "ra0"(P.signed(BenchStream.head(P.intrep ra)))
val _=out "rb0"(P.signed(BenchStream.head(P.intrep rb)))
val _=out "product0"(P.signed(BenchStream.head(P.intrep product)))
val _=List.app(fn i=>out("ready"^Int.toString i)(Int.toString(BenchStream.nth r i)))(List.tabulate(16,fn i=>i))
