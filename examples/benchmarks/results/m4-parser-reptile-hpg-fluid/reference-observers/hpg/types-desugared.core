Rec {
$fShowArgtype = C:Show $cshowsPrec_a1Lf $cshow_a1M0 $cshowList_a1M7

$cshow_a1M0 = \ x_a1Sq -> showsPrec $fShowArgtype (I# 0#) x_a1Sq []

$cshowList_a1M7
  = \ ls_a1Sl s_a1Sm ->
      showList__ (showsPrec $fShowArgtype (I# 0#)) ls_a1Sl s_a1Sm

$cshowsPrec_a1Lf
  = \ ds_d1S8 ds_d1S9 ->
      case ds_d1S9 of {
        Name_type tn_aWQ -> showString tn_aWQ;
        Basic_type bt_aWR -> shows $fShowBase_type bt_aWR;
        List_type at_aWS -> . lsq (. (shows $fShowArgtype at_aWS) rsq);
        Tuple_type ats_aWT ->
          . lbrack
            (. (sep_list list_separator (shows $fShowArgtype) ats_aWT) rbrack);
        Array_type at_aWV at'_aWW ->
          showParen
            (>= $fOrdInt ds_d1S8 apply_prec)
            (. array_type_name
               (. space
                  (. (showsPrec $fShowArgtype apply_prec at_aWV)
                     (. space (showsPrec $fShowArgtype apply_prec at'_aWW)))))
      }
