cat - <<'end' > tailtest.dir/v.m
|| tailtest.dir v = v
||
%include "~pieter/lib/fast2mira.m"
%include "~pieter/mira/synch/misc.m"
||
output	= (maps_1 (*) (+) 0 ((:) 1 a));
a	= ((:) 2 b);
b	= (tl output);
end
cat - <<'end' > tailtest.dir/v0.m
|| tailtest.dir v0 = inl v
||
%include "~pieter/lib/fast2mira.m"
%include "~pieter/mira/synch/misc.m"
||
output	= (maps_1 (*) (+) 0 ((:) 1 a));
a	= ((:) 2 b);
b	= (tl output);
end
cat - <<'end' > tailtest.dir/v1.m
|| tailtest.dir v1 = t1 v0
||
%include "~pieter/lib/fast2mira.m"
%include "~pieter/mira/synch/misc.m"
||
output	= (maps_1 (*) (+) 0 xxa1);
a	= ((:) 2 b);
b	= (tl output);
xxa1	= ((:) 1 a);
end
cat - <<'end' > tailtest.dir/v3.m
|| tailtest.dir v3 = t3 v1
||
%include "~pieter/lib/fast2mira.m"
%include "~pieter/mira/synch/misc.m"
||
output	= (map_2 (*) xxb1 xxa1);
a	= ((:) 2 b);
b	= (tl output);
xxa1	= ((:) 1 a);
xxb1	= ((:) 0 xxc1);
xxc1	= (map_2 (+) xxb1 xxa1);
end
cat - <<'end' > tailtest.dir/v5.m
|| tailtest.dir v5 = t5 v3
||
%include "~pieter/lib/fast2mira.m"
%include "~pieter/mira/synch/misc.m"
||
output	= ((:) ((*) (hd xxb1) (hd xxa1)) xxv1);
a	= ((:) 2 xxv1);
xxa1	= ((:) 1 a);
xxb1	= ((:) 0 xxc1);
xxv1	= (map_2 (*) xxc1 a);
xxc1	= (map_2 (+) xxb1 xxa1);
end
cat - <<'end' > tailtest.dir/v6.m
|| tailtest.dir v6 = t6 v5
||
%include "~pieter/lib/fast2mira.m"
%include "~pieter/mira/synch/misc.m"
||
output1	= (map_1 sel_4 (maps_0 id_1 nextstate (((*) (hd xxb1) (hd xxa1)),2,1,0) ));
nextstate s
= (xxv1,xxv1,a,xxc1)
  where
  (output,a,xxa1,xxb1)	= s;
  xxc1	= ((+) xxb1 xxa1);
  xxv1	= ((*) xxc1 a);;
output	= ((:) ((*) (hd xxb1) (hd xxa1)) xxv1);
a	= ((:) 2 xxv1);
xxa1	= ((:) 1 a);
xxb1	= ((:) 0 xxc1);
xxv1	= (map_2 (*) xxc1 a);
xxc1	= (map_2 (+) xxb1 xxa1);
end
