["(,,,)","gamma",["(:)","include \"~pieter/lib/fast2mira.m\"\n",["(:)","include \"~pieter/mira/synch/misc.m\"\n",["(:)","include \"~pieter/mira/gamma/gamma.m\"\n",["[]"]]]],"cat - <<'end' > gamma.dir/v6.m\n|| gamma.dir v6 = t6 v5\n||\n%include \"~pieter/lib/fast2mira.m\"\n%include \"~pieter/mira/synch/misc.m\"\n%include \"~pieter/mira/gamma/gamma.m\"\n||\noutput1\t= (map_1 sel_2 (maps_0 id_1 nextstate (dummy_output,lownumbers) ));\nnextstate s\n= (p9,p6)\n  where\n  (output,p0)\t= s;\n  p1\t= (perm 2 p0);\n  p2\t= (map1 divides p1);\n  p3\t= (select p2 p1);\n  p4\t= ((--) p0 p3);\n  p5\t= (remove1 p3);\n  p6\t= ((++) p5 p4);\n  p7\t= (or p2);\n  p8\t= ((~) p7);\n  p9\t= (p8,p0);;\noutput\t= ((:) dummy_output p9);\np0\t= ((:) lownumbers p6);\np1\t= (map_1 perm_2 p0);\np2\t= (map_1 map_divides p1);\np3\t= (map_2 select p2 p1);\np4\t= (map_2 (--) p0 p3);\np5\t= (map_1 remove1 p3);\np6\t= (map_2 (++) p5 p4);\np7\t= (map_1 or p2);\np8\t= (map_1 (~) p7);\np9\t= (map_2 mkpair p8 p0);\nmap_divides xs\t= (map1 divides xs);\nmkpair a b\t= (a,b);\nperm_2 xs\t= (perm 2 xs);\nend\n",["(:)",["F_Caf",["(:)","output1",["[]"]],["F_Map",1,"sel_2",["(:)",["F_Maps",1,"id_1","nextstate",["F_Tuple",["(:)",["F_Var","dummy_output"],["(:)",["F_Var","lownumbers"],["[]"]]]],["[]"]],["[]"]]]],["(:)",["F_Def","nextstate",["(:)","s",["[]"]],["F_Tuple",["(:)",["F_Var","p9"],["(:)",["F_Var","p6"],["[]"]]]],["F_Where",["(:)",["F_Caf",["(:)","output",["(:)","p0",["[]"]]],["F_Var","s"]],["(:)",["F_Caf",["(:)","p1",["[]"]],["F_Ap","perm",["(:)",["F_Lit","2"],["(:)",["F_Var","p0"],["[]"]]]]],["(:)",["F_Caf",["(:)","p2",["[]"]],["F_Ap","map1",["(:)",["F_Var","divides"],["(:)",["F_Var","p1"],["[]"]]]]],["(:)",["F_Caf",["(:)","p3",["[]"]],["F_Ap","select",["(:)",["F_Var","p2"],["(:)",["F_Var","p1"],["[]"]]]]],["(:)",["F_Caf",["(:)","p4",["[]"]],["F_Ap","(--)",["(:)",["F_Var","p0"],["(:)",["F_Var","p3"],["[]"]]]]],["(:)",["F_Caf",["(:)","p5",["[]"]],["F_Ap","remove1",["(:)",["F_Var","p3"],["[]"]]]],["(:)",