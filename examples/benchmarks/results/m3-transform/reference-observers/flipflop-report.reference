a3	= (maps_2 one_of_three notand 0 a1 a1);
a6	= (maps_2 one_of_three notand 0 xxa17 a7);
a7	= (maps_2 one_of_three notand 1 a6 xxa22);
a8	= (maps_2 one_of_three notand 0 a2 a2);
xxa10	= (maps_2 one_of_three notand 0 a8 a7);
xxa17	= (maps_2 one_of_three notand 0 a1 a2);
xxa22	= (maps_2 one_of_three notand 0 a3 a2);
xxa5	= (maps_2 one_of_three notand 0 a6 a8);
buffer s xs	= (maps_1 one_of_two two_of_two s xs);
nand s xs ys	= (maps_2 one_of_three notand s xs ys);
notand s a b	= (bnot (band a b));
one_of_three x y z	= x;
one_of_two x y	= x;
two_of_two x y	= y;
end
cat - <<'end' > flipflop.dir/v3.m
