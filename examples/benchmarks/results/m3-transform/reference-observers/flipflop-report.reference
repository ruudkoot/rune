a12	= (maps_2 one_of_three notand 1 a11 (maps_2 one_of_three notand 0 a8 a7));
a2	= (maps_1 one_of_two two_of_two 0 clock);
a3	= (maps_2 one_of_three notand 0 a1 a1);
a6	= (maps_2 one_of_three notand 0 (maps_2 one_of_three notand 0 a1 a2) a7);
a7	= (maps_2 one_of_three notand 1 a6 (maps_2 one_of_three notand 0 a3 a2));
a8	= (maps_2 one_of_three notand 0 a2 a2);
buffer s xs	= (maps_1 one_of_two two_of_two s xs);
nand s xs ys	= (maps_2 one_of_three notand s xs ys);
notand s a b	= (bnot (band a b));
one_of_three x y z	= x;
one_of_two x y	= x;
two_of_two x y	= y;
end
