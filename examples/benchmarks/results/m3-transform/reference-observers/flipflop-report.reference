xxc25	= (map_3 notand xxb25 a6 a8);
xxc3	= (map_2 two_of_two xxb3 data);
xxc5	= (map_3 notand xxb5 xxa5 output);
xxc7	= (map_3 notand xxb7 a11 xxa10);
xxc9	= (map_2 two_of_two xxb9 clock);
buffer s xs	= (maps_1 one_of_two two_of_two s xs);
nand s xs ys	= (maps_2 one_of_three notand s xs ys);
notand s a b	= (bnot (band a b));
one_of_three x y z	= x;
one_of_two x y	= x;
two_of_two x y	= y;
