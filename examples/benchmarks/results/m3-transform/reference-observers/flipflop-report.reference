cat - <<'end' > flipflop.dir/v.m
|| flipflop.dir v = v
||
%include "~pieter/lib/fast2mira.m"
%include "~pieter/mira/synch/misc.m"
%include "~pieter/mira/setreset/setreset.m"
||
output	= ((:) 1 a12);
a1	= (buffer 0 data);
a11	= (nand 0 (nand 0 a6 a8) output);
a12	= (nand 1 a11 (nand 0 a8 a7));
a2	= (buffer 0 clock);
a3	= (nand 0 a1 a1);
a6	= (nand 0 (nand 0 a1 a2) a7);
a7	= (nand 1 a6 (nand 0 a3 a2));
a8	= (nand 0 a2 a2);
buffer s xs	= (maps_1 one_of_two two_of_two s xs);
nand s xs ys	= (maps_2 one_of_three notand s xs ys);
notand s a b	= (bnot (band a b));
one_of_three x y z	= x;
one_of_two x y	= x;
two_of_two x y	= y;
end
cat - <<'end' > flipflop.dir/v0.m
