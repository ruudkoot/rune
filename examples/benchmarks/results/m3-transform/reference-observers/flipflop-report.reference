a3	= (map_3 one_of_three xxb11 a1 a1);
a6	= (map_3 one_of_three xxb13 xxa17 a7);
a7	= (map_3 one_of_three xxb15 a6 xxa22);
a8	= (map_3 one_of_three xxb17 a2 a2);
xxa10	= (map_3 one_of_three xxb19 a8 a7);
xxa17	= (map_3 one_of_three xxb21 a1 a2);
xxa22	= (map_3 one_of_three xxb23 a3 a2);
xxa5	= (map_3 one_of_three xxb25 a6 a8);
xxb11	= ((:) 0 xxc11);
xxb13	= ((:) 0 xxc13);
xxb15	= ((:) 1 xxc15);
xxb17	= ((:) 0 xxc17);
xxb19	= ((:) 0 xxc19);
xxb21	= ((:) 0 xxc21);
xxb23	= ((:) 0 xxc23);
xxb25	= ((:) 0 xxc25);
xxb3	= ((:) 0 xxc3);
xxb5	= ((:) 0 xxc5);
xxb7	= ((:) 1 xxc7);
xxb9	= ((:) 0 xxc9);
xxc11	= (map_3 notand xxb11 a1 a1);
xxc13	= (map_3 notand xxb13 xxa17 a7);
xxc15	= (map_3 notand xxb15 a6 xxa22);
xxc17	= (map_3 notand xxb17 a2 a2);
xxc19	= (map_3 notand xxb19 a8 a7);
xxc21	= (map_3 notand xxb21 a1 a2);
