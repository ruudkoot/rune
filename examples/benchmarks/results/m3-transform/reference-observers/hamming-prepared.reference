["(,,,)","hamming",["(:)","include \"~pieter/lib/fast2mira.m\"\n",["(:)","include \"~pieter/mira/synch/misc.m\"\n",["(:)","include \"~pieter/mira/hamming/hamming.m\"\n",["[]"]]]],"%module  \"hamming\"\n%include \"~pieter/lib/fast2mira\"\n%include \"~pieter/mira/synch/misc\"\n%include \"~pieter/mira/hamming/hamming\"\noutput = (:) 1 (maps hamFo hamFs hams0 ham2s ham3s);\nham2s  = map ((*) 2) output;\nham3s  = map ((*) 3) output;\nhamFo s a b        = (fst (hamstat s a b));\nhamFs s a b        = (snd (hamstat s a b));\n",["(:)",["F_Caf",["(:)","output",["[]"]],["F_Cons",1,["F_Lit","1"],["F_Maps",3,"hamFo","hamFs",["F_Var","hams0"],["(:)",["F_Var","ham2s"],["(:)",["F_Var","ham3s"],["[]"]]]]]],["(:)",["F_Caf",["(:)","ham2s",["[]"]],["F_Ap","map",["(:)",["F_Ap","(*)",["(:)",["F_Lit","2"],["[]"]]],["(:)",["F_Var","output"],["[]"]]]]],["(:)",["F_Caf",["(:)","ham3s",["[]"]],["F_Ap","map",["(:)",["F_Ap","(*)",["(:)",["F_Lit","3"],["[]"]]],["(:)",["F_Var","output"],["[]"]]]]],["(:)",["F_Def","hamFo",["(:)","s",["(:)","a",["(:)","b",["[]"]]]],["F_Ap","fst",["(:)",["F_Ap","hamstat",["(:)",["F_Var","s"],["(:)",["F_Var","a"],["(:)",["F_Var","b"],["[]"]]]]],["[]"]]],["C_NoWhere"]],["(:)",["F_Def","hamFs",["(:)","s",["(:)","a",["(:)","b",["[]"]]]],["F_Ap","snd",["(:)",["F_Ap","hamstat",["(:)",["F_Var","s"],["(:)",["F_Var","a"],["(:)",["F_Var","b"],["[]"]]]]],["[]"]]],["C_NoWhere"]],["[]"]]]]]]]
