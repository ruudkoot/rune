+\documentstyle[a4]{article}
+%;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
+%File:         boyer.lhs
+%Description:  The Boyer benchmark
+%Author:       Bob Boyer
+%Created:      05-Apr-1985 Bob Boyer?
