 val _=check "singleton-agenda-skips-unused-cost"(fn()=>
   let val pair=(variable"a",variable"b")
       val agenda=addAgenda(fn _=>raise Fail"unused cost")(S.singleton pair)(S.empty())
   in case L.force agenda of S.Cons(entry,rest)=>
       let val Item(_,observed)=L.force entry
       in equal(#1 observed)(#1 pair)andalso(case L.force rest of S.Nil=>true|_=>false)end
     |S.Nil=>false end)
 val _=check "source-query"(fn()=>test 2)
 val _=check "source-negative-query"(fn()=>not(result("a","b")))
 val _=check "full-term-consumer"(fn()=>Driver.run["3"]="True")
 val _=check "incorrect-term-rejected"(fn()=>((Driver.calculate 1"*(I(a),I(b))";false)handle Fail why=>String.isPrefix"incorrect result:"why))
 val _=check "zero-checker-demand"(fn()=>calculate 0(SOME(fn _=>raise Fail "unused")) )
 val _=check "query-count"(fn()=>let val seen=ref 0 val _=calculate 4(SOME(fn _=>seen:= !seen+1))in !seen=4 end)
 val _=check "completion-shared"(fn()=>let val previous= !completion val _=test 1
     in case(previous,!completion)of(L.Value _,L.Value _)=>true|_=>false end)
 val _=check "child-policy"(fn()=>let val term=func"I"(S.singleton(L.delay(fn()=>raise Fail"child")))
     in if P.eagerChildren then((L.force term;false)handle Fail s=>s="child")
       else(case L.force term of Func("I",_)=>true|_=>false)end)
 val _=check "lexico-skips-unused-tail"(fn()=>
   lexico(fn(a:int,b)=>if a>b then Greater else Less)
     (S.cons(L.delay(fn()=>2),L.delay(fn()=>raise Fail"tail")))
     (S.cons(L.delay(fn()=>1),L.delay(fn()=>raise Fail"tail")))=Greater)
 val _=check "equation-name-mismatch-skips-fields"(fn()=>
   not(equal(L.delay(fn()=>Func("E",L.delay(fn()=>raise Fail"args"))))
            (L.delay(fn()=>Func("I",L.delay(fn()=>raise Fail"args"))))))
 val _=check "try-all-stops-at-first-success"(fn()=>
   Option.isSome(tryAll(S.cons(L.delay(fn()=>fn e=>SOME e),L.delay(fn()=>raise Fail"later")))(variable"a")))
 val _=check "match-repeated-variable"(fn()=>Option.isSome(match(Parser.parse"a*a")(Parser.parse"b*b"))
   andalso not(Option.isSome(match(Parser.parse"a*a")(Parser.parse"b*c"))))
 val _=check "match-source-zip-truncation"(fn()=>Option.isSome(match(Parser.parse"I(a)")(func"I"(S.fromList[variable"b",variable"c"]))))
 val _=check "unify-occurs-check"(fn()=>not(Option.isSome(unify(variable"a")(Parser.parse"I(a)"))))
 val _=check "unify-variable-chain"(fn()=>case unify(Parser.parse"a*b")(Parser.parse"b*c")of
   NONE=>false|SOME s=>render(apply s"a")="c"andalso render(apply s"b")="c")
 val _=check "substitution-first-binding"(fn()=>render(apply(S.fromList[("a",variable"b"),("a",variable"c")])"a")="b")
 val _=check "substitution-composition"(fn()=>
   render(apply(compose(S.singleton("b",variable"c"))(S.singleton("a",variable"b")))"a")="c")
 val _=check "standardization"(fn()=>render(standard"12"(Parser.parse"a*I(b)"))="*(a12,I(b12))")
 val _=check "empty-net-skips-expression"(fn()=>case L.force(find(L.delay(fn()=>raise Fail"unused"))(emptyNet()))of S.Nil=>true|_=>false)
 val _=check "rpo-variables-unrelated"(fn()=>order(variable"a",variable"b")=Unrelated)
 val _=check "rpo-occurrence"(fn()=>order(variable"a",Parser.parse"I(a)")=Less)
 val _=check "source-parser-prefix-and-backtracking"(fn()=>render(Parser.parse"a trailing")="a"andalso render(Parser.parse"(a*b)")="*(a,b)")
