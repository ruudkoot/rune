 val _=check "replacement-persistent"(fn()=>let val t=Parser.parse"a*b" val changed=replace t[0](variable"c")
   in render changed="*(c,b)"andalso render t="*(a,b)"end)
 val _=check "invalid-count-rejected"(fn()=>((Driver.run["1200001"];false)handle Fail _=>true))
