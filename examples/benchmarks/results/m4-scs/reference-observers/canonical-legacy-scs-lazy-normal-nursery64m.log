[opening /home/ruud/rune/.worktrees/benchmarks/examples/benchmarks/shared/scs-types.sml]
structure BenchScsTypes : sig
  type exact = BenchScsRational.t BenchLazy.delay
  type waveform =
    (real BenchLazy.delay * real BenchLazy.delay) BenchStream.stream
  datatype element
    = Capacitor of exact * exact
    | Conductor of exact
    | Inductor of exact * exact
    | Isource of waveform
    | Junction of exact * exact * exact
    | Resistor of exact
    | Vsource of waveform
  type circuit = (int * int * int * element) list
end
