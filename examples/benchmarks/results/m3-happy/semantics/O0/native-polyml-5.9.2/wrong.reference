data HappyAbsSyn t4
	= HappyTerminal T
	| HappyErrorToken Int
	| HappyAbsSyn4 t4

action_0 (5) = happyShift action_3
action_0 (4) = happyGoto action_4
action_0 _ = happyFail

action_1 (5) = happyShift action_3
action_1 (4) = happyGoto action_2
action_1 _ = happyFail

action_2 (6) = happyShift action_5
action_2 (7) = happyShift action_6
action_2 _ = happyFail

action_3 _ = happyReduce_3

action_4 (6) = happyShift action_5
action_4 (7) = happyShift action_6
action_4 (8) = happyAccept
action_4 _ = happyFail

action_5 (5) = happyShift action_3
action_5 (4) = happyGoto action_8
action_5 _ = happyFail

action_6 (5) = happyShift action_3
action_6 (4) = happyGoto action_7
action_6 _ = happyFail

action_7 _ = happyReduce_2

action_8 (7) = happyShift action_6
action_8 _ = happyReduce_1

happyReduce_1 = happySpecReduce_3  4 happyReduction_1
happyReduction_1 (HappyAbsSyn4  happy_var_3)
	_
	(HappyAbsSyn4  happy_var_1)
	 =  HappyAbsSyn4
		 (happy_var_1+happy_var_3
	)
happyReduction_1 _ _ _  = notHappyAtAll 

happyReduce_2 = happySpecReduce_3  4 happyReduction_2
happyReduction_2 (HappyAbsSyn4  happy_var_3)
	_
	(HappyAbsSyn4  happy_var_1)
	 =  HappyAbsSyn4
		 (happy_var_1*happy_var_3
	)
happyReduction_2 _ _ _  = notHappyAtAll 

happyReduce_3 = happySpecReduce_1  4 happyReduction_3
happyReduction_3 (HappyTerminal happy_var_1)
	 =  HappyAbsSyn4
		 (happy_var_1
	)
happyReduction_3 _  = notHappyAtAll 

happyNewToken action sts stk [] =
	action 8 8 notHappyAtAll (HappyState action) sts stk []

happyNewToken action sts stk (tk:tks) =
	let cont i = action i i tk (HappyState action) sts stk tks in
	case tk of {
	X -> cont 5;
	P -> cont 6;
	M -> cont 7;
	_ -> happyError' (tk:tks)
	}

happyError_ tk tks = happyError' (tk:tks)

newtype HappyIdentity a = HappyIdentity a
happyIdentity = HappyIdentity
happyRunIdentity (HappyIdentity a) = a

instance Monad HappyIdentity where
    return = HappyIdentity
    (HappyIdentity p) >>= q = q p

happyThen :: () => HappyIdentity a -> (a -> HappyIdentity b) -> HappyIdentity b
happyThen = (>>=)
happyReturn :: () => a -> HappyIdentity a
happyReturn = (return)
happyThen1 m k tks = (>>=) m (\a -> k a tks)
happyReturn1 :: () => a -> b -> HappyIdentity a
happyReturn1 = \a tks -> (return) a
happyError' :: () => [T] -> HappyIdentity a
happyError' = HappyIdentity . happyError

parse tks = happyRunIdentity happySomeParser where
  happySomeParser = happyThen (happyParse action_0 tks) (\x -> case x of {HappyAbsSyn4 z -> happyReturn z; _other -> notHappyAtAll })

happySeq = happyDontSeq



