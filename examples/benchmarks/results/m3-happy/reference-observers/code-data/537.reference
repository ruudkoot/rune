["ok","% let string = getDOCNEXT happy_var_1 in\u000a               case parseModuleHeader string of {                       \u000a                 Right (str, info) ->                                  \u000a                   case parseHaddockParagraphs (tokenise str) of {               \u000a                     Left err -> parseError (getLoc happy_var_1) err;                    \u000a                     Right doc -> return (info, Just doc);          \u000a                   };                                             \u000a                 Left err -> parseError (getLoc happy_var_1) err\u000a            }",[1,1,1]]
