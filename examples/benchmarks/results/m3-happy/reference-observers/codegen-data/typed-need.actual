

-- parser produced by Happy Version 1.16

data HappyAbsSyn 
	= HappyTerminal T
	| HappyErrorToken Int
	| HappyAbsSyn4 (A)
	| HappyAbsSyn5 (B)

type HappyReduction m = 
	   Int 
	-> (T)
	-> HappyState (T) (HappyStk HappyAbsSyn -> [(T)] -> m HappyAbsSyn)
	-> [HappyState (T) (HappyStk HappyAbsSyn -> [(T)] -> m HappyAbsSyn)] 
	-> HappyStk HappyAbsSyn 
	-> [(T)] -> m HappyAbsSyn

action_0,
 action_1,
 action_2,
 action_3 :: () => Int -> HappyReduction (HappyIdentity)

happyReduce_1,
 happyReduce_2,
 happyReduce_3 :: () => Int -> HappyReduction (HappyIdentity)

action_0 (6) = happyShift action_2
action_0 (4) = happyGoto action_3
action_0 _ = happyReduce_2

action_1 (6) = happyShift action_2
action_1 _ = happyFail

action_2 _ = happyReduce_1

action_3 (7) = happyAccept
action_3 _ = happyFail

happyReduce_1 = happySpecReduce_1  4 happyReduction_1
happyReduction_1 _
	 =  HappyAbsSyn4
		 (one
	)

happyReduce_2 = happySpecReduce_0  4 happyReduction_2
happyReduction_2  =  HappyAbsSyn4
		 (zero
	)

happyReduce_3 = happySpecReduce_1  5 happyReduction_3
happyReduction_3 _
	 =  HappyAbsSyn5
		 (two
	)

happyNewToken action sts stk [] =
	action 7 7 notHappyAtAll (HappyState action) sts stk []

happyNewToken action sts stk (tk:tks) =
	let cont i = action i i tk (HappyState action) sts stk tks in
	case tk of {
	X -> cont 6;
	_ -> happyError' (tk:tks)
	}

happyError_ tk tks = happyError' (tk:tks)

newtype HappyIdentity a = HappyIdentity a
happyIdentity = HappyIdentity
happyRunIdentity (HappyIdentity a) = a

instance Monad HappyIdentity where
    return = HappyIdentity
    (HappyIdentity p) >>= q = q p

happyThen :: () => HappyIdentity a -> (a -> HappyIdentity b) -> HappyIdentity b
happyThen = (>>=)
happyReturn :: () => a -> HappyIdentity a
happyReturn = (return)
happyThen1 m k tks = (>>=) m (\a -> k a tks)
happyReturn1 :: () => a -> b -> HappyIdentity a
happyReturn1 = \a tks -> (return) a
happyError' :: () => [T] -> HappyIdentity a
happyError' = HappyIdentity . happyError

happyParse tks = happyRunIdentity happySomeParser where
  happySomeParser = happyThen (happyParse action_0 tks) (\x -> case x of {HappyAbsSyn4 z -> happyReturn z; _other -> notHappyAtAll })

happySeq = happyDontSeq



