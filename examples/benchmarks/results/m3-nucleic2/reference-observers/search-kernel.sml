   fun mul(a:real,b)=round(a*b)
   fun negative(a:real)= ~a
   fun sqrt x=round(Math.sqrt x)
   fun sin x=round(Math.sin x)
   fun cos x=round(Math.cos x)
   fun divide(a:real,b)=round(a/b)
