+structure Benchmark =
+struct
+  val name = "kitlife35u_smlnj"
+  fun one n =
+    let val cells = LifeKernel.alive (LifeKernel.iter n)
+        fun loop ([],count,hash) = Int.toString count ^ " " ^ Word32.toString hash
+          | loop ((x,y)::rest,count,hash) =
+              loop (rest,count+1,Word32.+ (Word32.* (Word32.+ (Word32.* (hash,0w16777619),
+                        Word32.fromInt x),0w16777619),Word32.fromInt y))
+    in loop (cells,0,0w0) end
+  fun run [generations,reps] =
+    let val n = BenchInput.between (0,1000) (BenchInput.integer generations)
+        val r = BenchInput.between (1,1000) (BenchInput.integer reps)
+        fun loop (0,values) = String.concatWith ";" (List.rev values)
+          | loop (k,values) = loop (k-1,one n::values)
+    in loop (r,[]) end
+    | run _ = raise Fail "kitlife35u_smlnj expects generations repetitions"
+end
