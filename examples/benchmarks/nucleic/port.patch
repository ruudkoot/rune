+structure Benchmark =
+struct
+  val name = "nucleic"
+  fun run [reps] =
+        let val n = BenchInput.between (1, 1000) (BenchInput.integer reps)
+            fun one () =
+              let val result = Nucleic.most_distant_atom (Nucleic.pseudoknot ())
+                  val want = 33.797594890762724
+              in if BenchInput.closeReal (result, want, 0.0, 0.000001) then 1
+                 else raise Fail "Pseudoknot numeric result" end
+        in IntInf.toString (BenchInput.repeat n one) end
+    | run _ = raise Fail "nucleic expects repetitions"
+end
