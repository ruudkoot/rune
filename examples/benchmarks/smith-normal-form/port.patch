+
+structure Benchmark =
+struct
+  val name="smith-normal-form"
+  fun run [size] =
+    let val n=BenchInput.between(1,35)(BenchInput.integer size)
+        val input=Matrix.map(Matrix.make(n,n,f),IntInf.fromInt)
+        val result=smithNormalForm input
+        fun row(i,j)=if i=n then () else if j=n then row(i+1,0) else
+          if i<>j andalso Matrix.fetch(result,i,j)<>0 then raise Fail "Smith off diagonal" else row(i,j+1)
+        val _=row(0,0)
+        val diag=List.tabulate(n,fn i=>Matrix.fetch(result,i,i))
+    in String.concatWith " " (List.map IntInf.toString diag) end
+  | run _=raise Fail "smith-normal-form expects matrix dimension"
+end
