+structure Benchmark = struct
+  val name = "iter-pidigits"
+  fun run [digits] =
+    let val n = BenchInput.between (1,10000) (BenchInput.integer digits)
+        val _ = BenchOutput.reset ()
+        val _ = PiDigits.generate n
+        val result = BenchOutput.text ()
+    in if String.size result = n andalso List.all Char.isDigit (String.explode result)
+       then result else raise Fail "invalid pi digits" end
+    | run _ = raise Fail "iter-pidigits expects digit count"
+end
