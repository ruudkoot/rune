+structure Benchmark =
+struct
+  val name="knuth-bendix"
+  fun term (KBKernel.Var i)="v"^Int.toString i
+    | term (KBKernel.Term(s,args))=s^"("^String.concatWith ","(List.map term args)^")"
+  fun run [reps]=
+    let val n=BenchInput.between(1,100)(BenchInput.integer reps)
+        val _=BenchOutput.reset()
+        fun one()=let val rules=KBKernel.kb_complete KBKernel.greater [] KBKernel.Geom_rules
+          val _=List.app(fn(_ ,(_,(a,b)))=>
+            if KBKernel.mrewrite_all rules a=KBKernel.mrewrite_all rules b then () else raise Fail "uncompleted input equation")KBKernel.Geom_rules
+          val _=List.app(fn(i,(v,(a,b)))=>BenchOutput.put(Int.toString i^":"^Int.toString v^":"^term a^"="^term b^"\n"))rules
+          in 1 end
+        val _=BenchInput.repeat n one
+    in BenchOutput.summary() end
+  | run _=raise Fail "knuth-bendix expects repetitions"
+end
