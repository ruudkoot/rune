+structure Benchmark =
+struct
+  val name="ray"
+  fun run [size,file,reference]=
+    let val n=BenchInput.between(16,1024)(BenchInput.integer size)
+        val _=if file="DATA/ray" then () else raise Fail "scene file"
+        val _=RaySize.side:=n
+        val input=TextIO.openIn file
+        val _=Interface.rtInit()
+        val _=(Interp.parse input handle e=>(TextIO.closeIn input;raise e))
+        val _=TextIO.closeIn input
+    in BenchFiles.same("TEST",reference) end
+  | run _=raise Fail "ray expects image-side scene reference"
+end
