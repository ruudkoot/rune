+structure Benchmark =
+struct
+  val name = "fft"
+  fun run [size,repetitions] =
+        let val n = BenchInput.between (2,8388608) (BenchInput.integer size)
+            val count = BenchInput.between (1,1000) (BenchInput.integer repetitions)
+            fun power n = n=1 orelse (n mod 2=0 andalso power(n div 2))
+            val _ = if power n then () else raise Fail "FFT size must be a power of two"
+            fun one () =
+              let val error = FFTKernel.test n
+                  val bound = Real.fromInt n * 0.00000001
+              in if error >= 0.0 andalso BenchInput.closeReal(error,0.0,bound,0.0) then 1 else raise Fail "FFT numeric residual" end
+        in IntInf.toString(BenchInput.repeat count one) end
+    | run _ = raise Fail "fft expects size repetitions"
+end
