+structure Benchmark=struct val name="count-graphs-smlnj"
+fun run [maximum,reps]=let val n=BenchInput.between(0,11)(BenchInput.integer maximum) val r=BenchInput.between(1,3)(BenchInput.integer reps)
+fun one()=String.concatWith ","(List.tabulate(n+1,fn i=>Int.toString(Kernel.f i)))
