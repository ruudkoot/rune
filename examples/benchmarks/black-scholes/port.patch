+structure Benchmark=struct val name="black-scholes"
+fun run [dataset,limit,replicas,passes]=let
+val path=case dataset of "small"=>"DATA/simsmall.txt"|"large"=>"DATA/simlarge.txt"|_=>raise Fail "unknown option dataset"
+val n=BenchInput.between(1,65536)(BenchInput.integer limit) val copies=BenchInput.between(1,32)(BenchInput.integer replicas) val rounds=BenchInput.between(1,10)(BenchInput.integer passes)
+val loaded=BlackScholes.readData path val _=if List.length loaded>=n then()else raise Fail "short option data"
+val selected=List.take(loaded,n) val data=List.concat(List.tabulate(copies,fn _=>selected))
+fun check(opt as BlackScholes.Option{spot,strike,interest,time,derivagem,...})=
+let val residual=BlackScholes.price opt
+val bound=0.000001+0.000000075*(spot+strike*Math.exp(~interest*time))
+in if Real.isFinite derivagem andalso residual>=0.0 andalso BenchInput.closeReal(residual,0.0,bound,0.0)then residual else raise Fail "option residual"end
+fun one()=let val results=List.map check data in List.length results end
+in IntInf.toString(BenchInput.repeat rounds one)end |run _=raise Fail "black-scholes expects dataset records replicas passes"end
