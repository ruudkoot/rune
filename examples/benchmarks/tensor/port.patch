+structure Benchmark =
+struct
+  val name="tensor"
+  val _=if Real.precision=53 andalso Real.radix=2 then () else raise Fail "requires binary64 real arithmetic"
+  fun run [size,reps] =
+    let val n=BenchInput.between(1,500)(BenchInput.integer size)
+        val count=BenchInput.between(1,20)(BenchInput.integer reps)
+        fun checked want value=if BenchInput.closeReal(value,want,0.00000001,0.00000001) then () else raise Fail "tensor value"
+        fun realOne () =
+          let val a=RTensor.new([n,n],1.0)
+              fun all want t = RTensor.app (checked want) t
+              fun elem 0=() | elem k=(all 2.0(RTensor.+(a,a));all 1.0(RTensor.*(a,a));all 1.0(RTensor./(a,a));elem(k-1))
+              fun contracted 0=() | contracted k=(all(Real.fromInt n)(RTensor.+* a a);all(Real.fromInt n)(RTensor.*+ a a);contracted(k-1))
+          in elem 20;contracted 4 end
+        fun complexOne () =
+          let val a=CTensor.new([n,n],CNumber.one)
+              fun all want t = CTensor.app(fn x=>let val(r,i)=CNumber.split x in checked want r;checked 0.0 i end)t
+              fun elem 0=() | elem k=(all 2.0(CTensor.+(a,a));all 1.0(CTensor.*(a,a));all 1.0(CTensor./(a,a));elem(k-1))
+              fun contracted 0=() | contracted k=(all(Real.fromInt n)(CTensor.+* a a);all(Real.fromInt n)(CTensor.*+ a a);contracted(k-1))
+          in elem 20;contracted 4 end
+    in IntInf.toString(BenchInput.repeat count(fn()=> (realOne();complexOne();1))) end
+  | run _=raise Fail "tensor expects dimension repetitions"
+end
