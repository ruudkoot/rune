+structure Benchmark =
+struct
+  val name="zern"
+  val _=if Real.precision=53 andalso Real.radix=2 then () else raise Fail "requires binary64 real arithmetic"
+  fun run [dimension,reps] =
+    let val n=BenchInput.between(2,128)(BenchInput.integer dimension)
+        val count=BenchInput.between(1,1000)(BenchInput.integer reps)
+    in IntInf.toString(BenchInput.repeat count(fn()=>
+      let val sum=FastRealArray2.array(n,n,0.0)
+          val rpart=FastRealArray2.array(n,n,0.0)
+          val ipart=FastRealArray2.array(n,n,0.0)
+          val coefs=MSpeed.collect 15(fn x=>Real.fromInt(1+x))
+          val screens=MSpeed.collect 15(fn _=>FastRealArray2.tabulate FastRealArray2.RowMajor(n,n,fn(r,c)=>0.01*Real.fromInt(n*r+c)))
+          val _=MSpeed.zern(sum,rpart,ipart,coefs,screens)
+          fun check i=if i=n*n then () else
+            let val theta=1.35*Real.fromInt i
+                val r=FastRealArray2.sub(rpart,i div n,i mod n)
+                val im=FastRealArray2.sub(ipart,i div n,i mod n)
+            in if BenchInput.closeReal(r,Math.cos theta,0.00000001,0.0) andalso
+                  BenchInput.closeReal(im,Math.sin theta,0.00000001,0.0)
+               then check(i+1) else raise Fail "phase-screen field" end
+      in check 0;1 end)) end
+  | run _=raise Fail "zern expects side repetitions"
+end
