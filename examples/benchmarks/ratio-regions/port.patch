+
+structure Benchmark =
+struct
+  val name="ratio-regions"
+  fun run [side] =
+    let val n=BenchInput.between(4,128)(BenchInput.integer side)
+        val result=doit n
+        val _=Array.appi(fn(y,row)=>Array.appi(fn(x,value)=>
+          if value=(y>=n div 4 andalso y<3*n div 4 andalso x>=n div 4 andalso x<3*n div 4)
+          then () else raise Fail "min-cut mask")row)result
+        val count=Array.foldl(fn(row,sum)=>Array.foldl(fn(x,sum)=>if x then sum+1 else sum)sum row)0 result
+    in Int.toString count end
+  | run _=raise Fail "ratio-regions expects side"
+end
