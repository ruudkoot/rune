+structure Benchmark =
+struct
+  val name="lexgen"
+  fun run [reps] =
+    let val n=BenchInput.between(1,100)(BenchInput.integer reps)
+        fun one () = (LexGen.lexGen "DATA/ml.lex";
+          String.concatWith ";" [BenchFiles.same("DATA/ml.lex.sml","expected/ml.lex.sml")])
+        fun loop(0,result)=result | loop(k,_)=loop(k-1,one())
+    in loop(n,"") end
+  | run _=raise Fail "lexgen expects repetitions"
+end
