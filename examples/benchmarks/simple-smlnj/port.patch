+structure Benchmark=struct val name="simple-smlnj"
+fun arrays((vx,vy),(xx,xy),a,s,rho,p,q,e,t,_,_)=[vx,vy,xx,xy,a,s,rho,p,q,e,t]
+fun scalars(_,_,_,_,_,_,_,_,_,delta,c)=[delta,c]
+fun run [dimension,repetitions,reference]=let val n=BenchInput.between(5,560)(BenchInput.integer dimension)val r=BenchInput.between(1,3)(BenchInput.integer repetitions)
+val _=if List.exists(fn p=>p=reference)["expected/smoke.txt","expected/normal.txt","expected/large.txt"]then()else raise Fail "state reference path"
+fun one()=let val state=Kernel.compute(n,1)val input=TextIO.openIn reference
+fun line()=case TextIO.inputLine input of SOME s=>String.tokens Char.isSpace s|NONE=>raise Fail "short state fixture"
+fun number s=case Real.fromString s of SOME x=>x|NONE=>raise Fail "invalid state real"
+fun check(want,got)=if BenchInput.closeReal(got,want,0.00000001,0.0000001)then()else raise Fail "hydrodynamic state"
+fun array(a,_)=let val(rows,cols)=Array2.length a val _=if line()=[Int.toString rows,Int.toString cols]then()else raise Fail "state dimensions"
+fun loop(i,total)=if i=rows then total else let val values=List.map number(line())val _=if List.length values=cols then()else raise Fail "state row"
+fun each([],_) = ()|each(x::xs,j)=(check(x,Array2.sub(a,(i,j)));each(xs,j+1)) val _=each(values,0)
+in loop(i+1,total+cols)end in loop(0,0)end
+val total=List.foldl(fn(a,sum)=>sum+array a)0(arrays state)
+val _=ListPair.appEq check(List.map number(line()),scalars state)
+val _=if TextIO.inputLine input=NONE then()else raise Fail "extra state fixture" val _=TextIO.closeIn input
+in total+2 end
+in IntInf.toString(BenchInput.repeat r one)end |run _=raise Fail "simple expects grid repetitions state reference"end
