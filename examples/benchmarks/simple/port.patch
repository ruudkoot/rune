+  fun arrays ((vx,vy),(xx,xy),alpha,s,rho,p,q,epsilon,theta,delta,c)=
+    [vx,vy,xx,xy,alpha,s,rho,p,q,epsilon,theta]
+  fun scalars (_,_,_,_,_,_,_,_,_,delta,c)=[delta,c]
+  fun run [dimension,steps,file]=
+    let val n=BenchInput.between(5,128)(BenchInput.integer dimension)
+        val count=BenchInput.between(1,1)(BenchInput.integer steps)
+        val _=if List.exists(fn p=>p=file)["expected/smoke.txt","expected/normal.txt","expected/large.txt"] then () else raise Fail "reference path"
+        val state=SimpleKernel.compute(n,count)
+        val input=TextIO.openIn file
+        fun line()=case TextIO.inputLine input of SOME s=>String.tokens Char.isSpace s | NONE=>raise Fail "short state reference"
+        fun real s=case Real.fromString s of SOME x=>x | NONE=>raise Fail "invalid state reference"
+        fun checked want got=if BenchInput.closeReal(got,want,0.00000001,0.0000001) then () else raise Fail "hydrodynamic state differs"
+        fun array (a,_) =
+          let val(rows,cols)=Array2.length a
+              val _=if line()=[Int.toString rows,Int.toString cols] then () else raise Fail "state dimensions"
+              fun loop(i,total)=if i=rows then total else
+                let val values=List.map real(line())
+                    val _=if List.length values=cols then () else raise Fail "state row width"
+                    fun check([],_) = () | check(want::rest,j)=(checked want(Array2.sub(a,(i,j)));check(rest,j+1))
+                    val _=check(values,0)
+                in loop(i+1,total+cols) end
+          in loop(0,0) end
+        val total=(List.foldl(fn(a,sum)=>sum+array a)0(arrays state))
+        val reference=List.map real(line())
+        val _=ListPair.appEq(fn(want,got)=>checked want got)(reference,scalars state)
+        val _=if TextIO.inputLine input=NONE then () else raise Fail "extra state reference"
+        val _=TextIO.closeIn input
+    in Int.toString(total+2) end
+  | run _=raise Fail "simple expects grid-maximum steps reference"
+end
