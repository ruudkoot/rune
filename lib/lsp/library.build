(* LSP protocol values and the pinned method/property inventory. *)
requires jsonrpc json unicode end
(* exports: what the library's clients use (tools/migrate; docs/build.md, Migrating a tree) *)
exports (structure LspMethods, structure LspPosition, structure LspProtocol, structure LspRequests,
         structure LspUri, signature LSP_METHODS, signature LSP_POSITION, signature LSP_PROTOCOL,
         signature LSP_REQUESTS, signature LSP_URI)
annotate "demand" in
  methods_sig.sml
  methods.sml
  protocol_sig.sml
  protocol.sml
  requests_sig.sml
  requests.sml
  position_sig.sml
  position.sml
  uri_sig.sml
  uri.sml
end
