(* ---- what a program sees of the structures
   A seal file binds the structures of a file again, each as its signature
   shows it (`structure List : LIST = List`), so that a program has the members
   the specification names and no others. The files above are compiled before
   these and have every structure whole. A seal is opaque where that makes a
   type abstract that no other signature names, and says `where type` for the
   types that other signatures name: they were read with the structure whole. *)
annotate "seal" in
  seal_general.sml
  seal_stringcvt.sml
  seal_bool.sml
  seal_option.sml
  seal_list.sml
