(* The property-testing library (docs/plans/quickcheck.md, M4 to M6): its
   engine, its files in load order, in the form of lib/basis/library.build.
   The arbitraries of the Basis Library's types are the library
   test/property/basis, in basis/. It is written on lib/random: *)
requires random end
(* exports: what the library's clients use (tools/migrate; docs/build.md, Migrating a tree) *)
exports (structure Arb, structure Check, structure Co, structure Gen, structure Prop,
         structure PropertySource, structure Show, signature ARB, signature CHECK, signature CO,
         signature GEN, signature PROP, signature SHOW)
(* Every compiler of tests/lib/run-hosts.sh builds every file. *)
annotate "demand" in
  source.sml
  gen_sig.sml
  gen.sml
  co_sig.sml
  co.sml
  show_sig.sml
  show.sml
  arb_sig.sml
  arb.sml
  prop_sig.sml
  prop.sml
  check_sig.sml
  check.sml
end
