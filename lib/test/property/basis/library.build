(* The arbitraries of the Basis Library's types for the property-testing
   library (docs/plans/quickcheck.md, M6 and D10), its files in load order,
   in the form of lib/basis/library.build. It is written on test/property: *)
requires random test/property end
(* exports: by hand, not tools/migrate's: the library gives an arbitrary
   for each type of the Basis Library, the signatures they ascribe and the
   functors that make one for a type of a client's, whether or not a source
   of this tree names it -- the programs of the laws (runedoc --laws, which
   tests/runner/laws.sml compiles) are made at test time and name any of
   them. Its helpers, PropertyAround, PropertyDimensions and PropertyScratch,
   are its own. *)
exports (structure BasisDataArb, structure BoolArray2Arb, structure BoolArrayArb, structure BoolArraySliceArb,
         structure BoolVectorArb, structure BoolVectorSliceArb, structure CharArb, structure CharArray2Arb,
         structure CharArrayArb, structure CharArraySliceArb, structure CharVectorArb,
         structure CharVectorSliceArb, structure DateArb, structure FixedIntArb, structure IEEERealArb,
         structure INet6SockArb, structure Int16Arb, structure Int16Array2Arb, structure Int16ArrayArb,
         structure Int16ArraySliceArb, structure Int16VectorArb, structure Int16VectorSliceArb,
         structure Int32Arb, structure Int32Array2Arb, structure Int32ArrayArb, structure Int32ArraySliceArb,
         structure Int32VectorArb, structure Int32VectorSliceArb, structure Int64Arb,
         structure Int64Array2Arb, structure Int64ArrayArb, structure Int64ArraySliceArb,
         structure Int64VectorArb, structure Int64VectorSliceArb, structure Int8Arb, structure Int8Array2Arb,
         structure Int8ArrayArb, structure Int8ArraySliceArb, structure Int8VectorArb,
         structure Int8VectorSliceArb, structure IntArb, structure IntArray2Arb, structure IntArrayArb,
         structure IntArraySliceArb, structure IntInfArb, structure IntVectorArb, structure IntVectorSliceArb,
         structure LargeIntArb, structure LargeIntArray2Arb, structure LargeIntArrayArb,
         structure LargeIntArraySliceArb, structure LargeIntVectorArb, structure LargeIntVectorSliceArb,
         structure LargeRealArb, structure LargeRealArray2Arb, structure LargeRealArrayArb,
         structure LargeRealArraySliceArb, structure LargeRealVectorArb, structure LargeRealVectorSliceArb,
         structure LargeWordArb, structure LargeWordArray2Arb, structure LargeWordArrayArb,
         structure LargeWordArraySliceArb, structure LargeWordVectorArb, structure LargeWordVectorSliceArb,
         structure PositionArb, structure RandomArb, structure Real32Arb, structure Real32Array2Arb,
         structure Real32ArrayArb, structure Real32ArraySliceArb, structure Real32VectorArb,
         structure Real32VectorSliceArb, structure Real64Arb, structure Real64Array2Arb,
         structure Real64ArrayArb, structure Real64ArraySliceArb, structure Real64VectorArb,
         structure Real64VectorSliceArb, structure RealArb, structure RealArray2Arb, structure RealArrayArb,
         structure RealArraySliceArb, structure RealVectorArb, structure RealVectorSliceArb,
         structure SML90Arb, structure StringArb, structure SubstringArb, structure SysWordArb,
         structure SystemArb, structure TimeArb, structure WideCharArb, structure WideCharArray2Arb,
         structure WideCharArrayArb, structure WideCharArraySliceArb, structure WideCharVectorArb,
         structure WideCharVectorSliceArb, structure WideStringArb, structure WideSubstringArb,
         structure WideTextArb, structure Word16Arb, structure Word16Array2Arb, structure Word16ArrayArb,
         structure Word16ArraySliceArb, structure Word16VectorArb, structure Word16VectorSliceArb,
         structure Word32Arb, structure Word32Array2Arb, structure Word32ArrayArb,
         structure Word32ArraySliceArb, structure Word32VectorArb, structure Word32VectorSliceArb,
         structure Word64Arb, structure Word64Array2Arb, structure Word64ArrayArb,
         structure Word64ArraySliceArb, structure Word64VectorArb, structure Word64VectorSliceArb,
         structure Word8Arb, structure Word8Array2Arb, structure Word8ArrayArb, structure Word8ArraySliceArb,
         structure Word8VectorArb, structure Word8VectorSliceArb, structure WordArb, structure WordArray2Arb,
         structure WordArrayArb, structure WordArraySliceArb, structure WordVectorArb,
         structure WordVectorSliceArb, signature ARB_OF, signature BASIS_DATA_ARB, signature DATE_ARB,
         signature IEEE_REAL_ARB, signature INET6_SOCK_ARB, signature SML90_ARB, signature SYSTEM_ARB,
         functor CharArbFn, functor IntegerArbFn, functor MonoArray2ArbFn, functor MonoArrayArbFn,
         functor MonoArraySliceArbFn, functor MonoVectorArbFn, functor MonoVectorSliceArbFn,
         functor RealArbFn, functor StringArbFn, functor SubstringArbFn, functor WordArbFn)
(* A file that every compiler of tests/lib/run-hosts.sh builds is "demand";
   one that names a structure the Basis leaves optional (Int8, WideChar,
   SML90, IntArray2) or Rune's own (INet6Sock) is "host=no" as well. The
   arbitrary of an optional structure is a file of its own, in sized/,
   wide/, arrays2/ and sequences/, so that a compiler without the structure
   builds the rest (tests/basis/run-laws-hosts.py). *)
annotate "demand" in
  family_sig.sml
  family.sml
  data_sig.sml
  data.sml
  numbers.sml
end
annotate "demand" "host=no" in
  sized/int8.sml
  sized/int16.sml
  sized/int32.sml
  sized/int64.sml
  sized/fixedint.sml
  sized/word16.sml
  sized/word32.sml
  sized/word64.sml
  sized/real32.sml
  sized/real64.sml
end
annotate "demand" in
  text.sml
end
annotate "demand" "host=no" in
  wide/widechar.sml
  wide/widestring.sml
  wide/widesubstring.sml
  wide/widetext.sml
end
annotate "demand" in
  bytes.sml
end
annotate "demand" "host=no" in
  arrays2/intarray2.sml
  arrays2/chararray2.sml
  arrays2/word8array2.sml
end
annotate "demand" in
  system_sig.sml
  system.sml
end
annotate "demand" "host=no" in
  inet6_sig.sml
  inet6.sml
  sml90_sig.sml
  sml90.sml
  sequences/boolvector.sml
  sequences/boolarray.sml
  sequences/boolvectorslice.sml
  sequences/boolarrayslice.sml
  sequences/boolarray2.sml
  sequences/intvector.sml
  sequences/intarray.sml
  sequences/intvectorslice.sml
  sequences/intarrayslice.sml
  sequences/int8vector.sml
  sequences/int8array.sml
  sequences/int8vectorslice.sml
  sequences/int8arrayslice.sml
  sequences/int8array2.sml
  sequences/int16vector.sml
  sequences/int16array.sml
  sequences/int16vectorslice.sml
  sequences/int16arrayslice.sml
  sequences/int16array2.sml
  sequences/int32vector.sml
  sequences/int32array.sml
  sequences/int32vectorslice.sml
  sequences/int32arrayslice.sml
  sequences/int32array2.sml
  sequences/int64vector.sml
  sequences/int64array.sml
  sequences/int64vectorslice.sml
  sequences/int64arrayslice.sml
  sequences/int64array2.sml
  sequences/largeintvector.sml
  sequences/largeintarray.sml
  sequences/largeintvectorslice.sml
  sequences/largeintarrayslice.sml
  sequences/largeintarray2.sml
  sequences/realvector.sml
  sequences/realarray.sml
  sequences/realvectorslice.sml
  sequences/realarrayslice.sml
  sequences/realarray2.sml
  sequences/real32vector.sml
  sequences/real32array.sml
  sequences/real32vectorslice.sml
  sequences/real32arrayslice.sml
  sequences/real32array2.sml
  sequences/real64vector.sml
  sequences/real64array.sml
  sequences/real64vectorslice.sml
  sequences/real64arrayslice.sml
  sequences/real64array2.sml
  sequences/largerealvector.sml
  sequences/largerealarray.sml
  sequences/largerealvectorslice.sml
  sequences/largerealarrayslice.sml
  sequences/largerealarray2.sml
  sequences/wordvector.sml
  sequences/wordarray.sml
  sequences/wordvectorslice.sml
  sequences/wordarrayslice.sml
  sequences/wordarray2.sml
  sequences/word16vector.sml
  sequences/word16array.sml
  sequences/word16vectorslice.sml
  sequences/word16arrayslice.sml
  sequences/word16array2.sml
  sequences/word32vector.sml
  sequences/word32array.sml
  sequences/word32vectorslice.sml
  sequences/word32arrayslice.sml
  sequences/word32array2.sml
  sequences/word64vector.sml
  sequences/word64array.sml
  sequences/word64vectorslice.sml
  sequences/word64arrayslice.sml
  sequences/word64array2.sml
  sequences/largewordvector.sml
  sequences/largewordarray.sml
  sequences/largewordvectorslice.sml
  sequences/largewordarrayslice.sml
  sequences/largewordarray2.sml
  sequences/widecharvector.sml
  sequences/widechararray.sml
  sequences/widecharvectorslice.sml
  sequences/widechararrayslice.sml
  sequences/widechararray2.sml
end
