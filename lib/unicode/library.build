(* The Unicode library (docs/plans/repl.md, The libraries; docs/plans/utf8.md,
   M5): UTF-8, the display widths of code points, grapheme clusters,
   normalisation, identifiers and the security mechanisms of UTS #39, from
   the tables that scripts/gen-unicode-tables.py writes; its files in load
   order, in the form of lib/basis/library.build. The compiler shares every
   file (rune.build): its lexer reads identifiers by Identifier and
   Normalize, and warns by UnicodeSecurity. *)
annotate "demand" in
  utf8_sig.sml
  utf8.sml
  width_data.sml
  display_width_sig.sml
  display_width.sml
  grapheme_data.sml
  grapheme_sig.sml
  grapheme.sml
  normalize_data.sml
  normalize_sig.sml
  normalize.sml
  identifier_data.sml
  identifier_sig.sml
  identifier.sml
  security_data.sml
  security_sig.sml
  security.sml
end
