(* The Unicode library (docs/plans/repl.md, The libraries; docs/plans/utf8.md,
   M5): UTF-8, the display widths of code points, grapheme clusters,
   normalisation, identifiers, the security mechanisms of UTS #39, and the
   general categories and simple case mappings of code points
   (docs/plans/language/haskell98.md, D21), from the tables that
   bin/rune-generate unicode writes; its files in load order, in the form
   of lib/basis/library.build. The compiler shares every file (rune.build):
   its lexer reads identifiers by Identifier and Normalize, and warns by
   UnicodeSecurity. *)
annotate "demand" in
  utf8_sig.sml
  utf8.sml
  width_data.sml
  display_width_sig.sml
  display_width.sml
  grapheme_data.sml
  grapheme_sig.sml
  grapheme.sml
  normalize_data.sml
  normalize_sig.sml
  normalize.sml
  identifier_data.sml
  identifier_sig.sml
  identifier.sml
  security_data.sml
  security_sig.sml
  security.sml
  code_point_data.sml
  code_point_sig.sml
  code_point.sml
end
