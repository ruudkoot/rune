requires unicode end
(* exports: what the library's clients use (tools/migrate; docs/build.md, Migrating a tree) *)
exports (structure ForeignBytes, structure ForeignScope, structure ForeignText, signature FOREIGN_BYTES,
         signature FOREIGN_SCOPE, signature FOREIGN_TEXT)
annotate "demand" in
  scope_sig.sml
  scope.sml
  bytes_sig.sml
  bytes.sml
  text_sig.sml
  text.sml
end
