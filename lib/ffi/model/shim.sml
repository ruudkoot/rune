(* Implements: FOREIGN_SHIM *)
structure ForeignShim : FOREIGN_SHIM =
struct
  exception Error of string
  fun ident name=CDeclarator.identifier name handle CDeclarator.Error s=>raise Error s
  fun decl pair=CDeclarator.declaration pair handle CDeclarator.Error s=>raise Error s
  fun pointer ty=CParse.Pointer{target=ty,qualifiers=[]}
  fun function result name parameters=decl(CParse.Function{result=result,
    parameters=List.map(fn(ty,name)=>CParse.Parameter{ctype=ty,name=SOME name})parameters,
    variadic=false,prototype=true},name)
  fun preamble headers=
    let fun headerLine header=if size header>0 andalso
          CharVector.all(fn c=>Char.isAlphaNum c orelse Char.contains "_./-" c)header andalso
          not(List.exists(fn p=>p=".." orelse p="")(String.fields(fn c=>c= #"/")header))
        then "#include <" ^ header ^ ">\n" else raise Error "invalid original header path"
    in "/* Generated by Runeffi; edit the adjacent policy and regenerate. */\n#include <string.h>\n" ^
      String.concat(List.map headerLine headers) ^
      "#if defined(_WIN32)\n#define RUNEFFI_EXPORT __declspec(dllexport)\n#else\n#define RUNEFFI_EXPORT __attribute__((visibility(\"default\")))\n#endif\n\n" end
  fun void(CParse.Builtin "void")=true | void(CParse.Attributed(ty,_))=void ty | void _=false
  fun call{name,foreign,result,parameters,indirectResult,indirectArguments}=
    let val ()=(ident name;ident foreign)
        val ()=if length parameters=length indirectArguments then () else raise Error "adapter argument indirection count differs"
        val ()=if indirectResult andalso void result then raise Error "void result cannot be indirect" else ()
        val entries=ListPair.zip(parameters,indirectArguments)
        val names=List.tabulate(length entries,fn i=>"runeffi_argument_" ^ Int.toString i)
        val declarations=ListPair.map(fn((ty,indirect),name)=>(if indirect then pointer ty else ty,name))(entries,names)
        val declarations=if indirectResult then (pointer result,"runeffi_output")::declarations else declarations
        val expressions=ListPair.map(fn((_,indirect),name)=>(if indirect then "*" else "") ^ name)(entries,names)
        val invoke=foreign ^ "(" ^ String.concatWith ", " expressions ^ ")"
        val body=if indirectResult then "  " ^ decl(result,"runeffi_result") ^ " = " ^ invoke ^ ";\n" ^
            "  memcpy(runeffi_output, &runeffi_result, sizeof runeffi_result);\n"
          else if void result then "  " ^ invoke ^ ";\n" else "  return " ^ invoke ^ ";\n"
    in "RUNEFFI_EXPORT " ^ function (if indirectResult then CParse.Builtin "void" else result) name declarations ^
      " {\n" ^ body ^ "}\n\n" end
  fun field{name,aggregate,path,ty,writable}=
    let val ()=ident name val ()=List.app ident path
        val ()=if null path then raise Error "empty adapter member path" else ()
        val member="runeffi_object->" ^ String.concatWith "." path
        val input=pointer(CParse.Attributed(aggregate,[[{kind=CLex.Identifier,text="const",space=true,
          location={file="<adapter>",line=1,column=1},origins=[]}]]))
        val getter="RUNEFFI_EXPORT " ^ function ty (name ^ "_get") [(input,"runeffi_object")] ^ " {\n  return " ^ member ^ ";\n}\n\n"
        val setter=if not writable then "" else "RUNEFFI_EXPORT " ^ function (CParse.Builtin "void") (name ^ "_set")
          [(pointer aggregate,"runeffi_object"),(ty,"runeffi_value")] ^ " {\n  " ^ member ^ " = runeffi_value;\n}\n\n"
    in getter ^ setter end
end
