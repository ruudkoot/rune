(* The Markdown library (docs/plans/repl.md, The libraries; M8):
   CommonMark and GitHub's tables, as a tree, HTML and documents; its files
   in load order, in the form of lib/basis/library.build. It is written on
   lib/pretty, for the documents, and lib/unicode: *)
requires pretty unicode end
(* exports: what the library's clients use (tools/migrate; docs/build.md, Migrating a tree) *)
exports (structure Markdown, signature MARKDOWN)
annotate "demand" in
  entities.sml
  markdown_sig.sml
  markdown.sml
end
