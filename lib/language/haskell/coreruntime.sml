(* rhc's runtime in Core (coreruntime_sig.sml): its text, the tables of
   lib/unicode's data it reads, and the linking of what a program reaches. *)
structure CoreRuntime :> CORE_RUNTIME =
struct
  open Core

  datatype strings = Lazy | Whole

  val reportNames =
    ["primIntToChar", "primCharToInt", "primUnicodeMaxChar", "primError", "primUserError", "primIOError", "primCatch",
     "primPutChar", "primGetChar", "primGetContents", "primReadFile", "primWriteFile", "primAppendFile",
     "primUnicodeIsPrint", "primUnicodeIsUpper", "primUnicodeIsLower", "primUnicodeIsAlphaNum",
     "primUnicodeToUpper", "primUnicodeToLower"]

  (* ---- The text ---- *)

  val text = String.concatWith "\n"
    [
     "; ---- The built-in syntax: the unit and the list (ov.prelude.unit, ov.prelude.list)",
     "",
     "(data `()` () (`()`))",
     "(data [] (a) ([]) (: a ([] a)))",
     "",
     "; ---- PreludeBuiltin: seq, and IO's return and bind over the state token (D25)",
     "",
     "(val primSeq (forall (a b) (-> a b b)) (\\ (@a @b (x a) (y b)) (case x _ (_ y))))",
     "",
     "(val primReturnIO (forall (a) (-> a World (utuple World a)))",
     "  (\\ (@a (x a) (w World)) (utuple w x)))",
     "",
     "(val primBindIO (forall (a b) (-> (-> World (utuple World a)) (-> a World (utuple World b)) World (utuple World b)))",
     "  (\\ (@a @b (m (-> World (utuple World a))) (k (-> a World (utuple World b))) (w World))",
     "    (case (m w) r ((utuple w1 x) (k x w1)))))",
     "",
     "; ---- Errors and IOError, an Exn of the kind IOError (ov.prelude.error, ov.preludeio.prims)",
     "",
     "(val primError (forall (a) (-> ([] Char) a))",
     "  (\\ (@a (s ([] Char))) (case (rtPack s) m (_ (case (prim exn_error m) e (_ (prim raise @a e)))))))",
     "",
     "(val primUserError (-> ([] Char) Exn)",
     "  (\\ ((s ([] Char))) (case (rtPack s) m (_ (prim exn_io m)))))",
     "",
     "(val primIOError (forall (a) (-> Exn World (utuple World a)))",
     "  (\\ (@a (e Exn) (w World)) (case e x (_ (prim raise_io @a x w)))))",
     "",
     "; catch sees an IOError and nothing else (R36): any other is raised again",
     "(val primCatch (forall (a) (-> (-> World (utuple World a)) (-> Exn World (utuple World a)) World (utuple World a)))",
     "  (\\ (@a (m (-> World (utuple World a))) (h (-> Exn World (utuple World a))) (w World))",
     "    (let (only (-> !Exn World (utuple World a))",
     "           (\\ ((e !Exn) (v World))",
     "             (case (prim exn_kind e) k",
     "               (1 (h e v))",
     "               (_ (prim raise_io @a e v)))))",
     "      (prim catch @a m only w))))",
     "",
     "; ---- Char, a code point in Mid's int (D21)",
     "",
     "(val primIntToChar (-> Int Char) (\\ ((i Int)) (case i n (_ (prim char_chr n)))))",
     "(val primCharToInt (-> Char Int) (\\ ((c Char)) (case c d (_ (prim char_ord d)))))",
     "",
     "; ---- Strings: UTF-8 read into characters",
     "",
     "; the bytes of a sequence that starts with the byte b: one where b starts",
     "; none, a byte of its own",
     "(val rtSeqLen (-> !Int Int)",
     "  (\\ ((b !Int))",
     "    (case (prim int_lt b 194) one",
     "      ((True) 1)",
     "      ((False)",
     "        (case (prim int_lt b 224) two",
     "          ((True) 2)",
     "          ((False)",
     "            (case (prim int_lt b 240) three",
     "              ((True) 3)",
     "              ((False) (case (prim int_lt b 245) four ((True) 4) ((False) 1))))))))))",
     "",
     "; the six bits of a continuation byte at j, below n; -1 where there is none",
     "(val rtCont (-> !Str !Int !Int Int)",
     "  (\\ ((s !Str) (j !Int) (n !Int))",
     "    (case (prim int_ge j n) past",
     "      ((True) -1)",
     "      ((False)",
     "        (case (prim str_byte s j) b",
     "          (_ (case (prim int_sub b 128) x",
     "               (_ (case (prim int_lt x 0) low",
     "                    ((True) -1)",
     "                    ((False) (case (prim int_ge x 64) high ((True) -1) ((False) x))))))))))))",
     "",
     "(val rtSix (-> !Int !Int Int)",
     "  (\\ ((v !Int) (x !Int)) (case (prim int_mul v 64) a (_ (prim int_add a x)))))",
     "",
     "; a character and where the next starts",
     "(val rtChar (-> !Int !Int (utuple !Char !Int))",
     "  (\\ ((v !Int) (j !Int)) (case (prim char_chr v) c (_ (utuple c j)))))",
     "",
     "; the character at byte i of s, below n, and where the next starts: a",
     "; sequence that is not UTF-8's, an overlong one, one past 10FFFF or one cut",
     "; short gives its first byte as the character of that number",
     "(val rtDecode (-> !Str !Int !Int (utuple !Char !Int))",
     "  (\\ ((s !Str) (i !Int) (n !Int))",
     "    (case (prim str_byte s i) b0",
     "      (_ (case (prim int_add i 1) i1",
     "           (_ (case (rtSeqLen b0) len",
     "                (1 (rtChar b0 i1))",
     "                (_ (case (rtCont s i1 n) x1",
     "                     (_ (case (prim int_lt x1 0) no",
     "                          ((True) (rtChar b0 i1))",
     "                          ((False) (rtDecode2 s i n b0 len x1)))))))))))))",
     "",
     "; past the first continuation byte, x1",
     "(val rtDecode2 (-> !Str !Int !Int !Int !Int !Int (utuple !Char !Int))",
     "  (\\ ((s !Str) (i !Int) (n !Int) (b0 !Int) (len !Int) (x1 !Int))",
     "    (case (prim int_add i 1) i1",
     "      (_ (case len l",
     "           (2 (case (prim int_sub b0 192) h (_ (case (rtSix h x1) v (_ (case (prim int_add i 2) i2 (_ (rtChar v i2))))))))",
     "           (_ (case (prim int_add i 2) i2",
     "                (_ (case (rtCont s i2 n) x2",
     "                     (_ (case (prim int_lt x2 0) no",
     "                          ((True) (rtChar b0 i1))",
     "                          ((False) (rtDecode3 s i n b0 len x1 x2)))))))))))))",
     "",
     "; past the second, x2",
     "(val rtDecode3 (-> !Str !Int !Int !Int !Int !Int !Int (utuple !Char !Int))",
     "  (\\ ((s !Str) (i !Int) (n !Int) (b0 !Int) (len !Int) (x1 !Int) (x2 !Int))",
     "    (case (prim int_add i 1) i1",
     "      (_ (case len l",
     "           (3 (case (prim int_sub b0 224) h",
     "                (_ (case (rtSix h x1) v1",
     "                     (_ (case (rtSix v1 x2) v",
     "                          (_ (case (prim int_lt v 2048) over",
     "                               ((True) (rtChar b0 i1))",
     "                               ((False) (case (prim int_add i 3) i3 (_ (rtChar v i3))))))))))))",
     "           (_ (case (prim int_add i 3) i3",
     "                (_ (case (rtCont s i3 n) x3",
     "                     (_ (case (prim int_lt x3 0) no",
     "                          ((True) (rtChar b0 i1))",
     "                          ((False)",
     "                            (case (prim int_sub b0 240) h",
     "                              (_ (case (rtSix h x1) v1",
     "                                   (_ (case (rtSix v1 x2) v2",
     "                                        (_ (case (rtSix v2 x3) v",
     "                                             (_ (case (prim int_lt v 65536) over",
     "                                                  ((True) (rtChar b0 i1))",
     "                                                  ((False)",
     "                                                    (case (prim int_gt v 1114111) past",
     "                                                      ((True) (rtChar b0 i1))",
     "                                                      ((False) (case (prim int_add i 4) i4 (_ (rtChar v i4)))))))))))))))))))))))))))",
     "",
     "; the characters of the bytes of s from i to n, then rest, each cell made",
     "; when the list is read that far (D24's A)",
     "(val rtUnpackAppend (-> !Str !Int !Int ([] Char) ([] Char))",
     "  (\\ ((s !Str) (i !Int) (n !Int) (rest ([] Char)))",
     "    (case (prim int_ge i n) end",
     "      ((True) rest)",
     "      ((False)",
     "        (case (rtDecode s i n) d",
     "          ((utuple c j)",
     "            (let (more ([] Char) (rtUnpackAppend s j n rest))",
     "              (con : @Char c more))))))))",
     "",
     "(val rtUnpackLazy (-> !Str ([] Char))",
     "  (\\ ((s !Str))",
     "    (case (prim str_size s) n (_ (let (nil ([] Char) (con [] @Char)) (rtUnpackAppend s 0 n nil))))))",
     "",
     "; the whole list at once (D24's B, for the measurement): read from the",
     "; end, the same characters as rtUnpackAppend's, since a lead byte always",
     "; starts a character",
     "(val rtUnpackWhole (-> !Str ([] Char))",
     "  (\\ ((s !Str))",
     "    (case (prim str_size s) n (_ (let (nil ([] Char) (con [] @Char)) (rtUnpackBack s n nil))))))",
     "",
     "; the characters before byte k, then acc: the last a sequence from the lead",
     "; before k where it ends at k, and otherwise the byte before k alone",
     "(val rtUnpackBack (-> !Str !Int ([] Char) ([] Char))",
     "  (\\ ((s !Str) (k !Int) (acc ([] Char)))",
     "    (case (prim int_eq k 0) done",
     "      ((True) acc)",
     "      ((False)",
     "        (case (prim int_sub k 1) j",
     "          (_ (case (rtLead s j) i",
     "               (_ (case (rtDecode s i k) d",
     "                    ((utuple c e)",
     "                      (case (prim int_eq e k) whole",
     "                        ((True) (let (cell ([] Char) (con : @Char c acc)) (rtUnpackBack s i cell)))",
     "                        ((False)",
     "                          (case (prim str_byte s j) b",
     "                            (_ (case (prim char_chr b) c1",
     "                                 (_ (let (cell ([] Char) (con : @Char c1 acc)) (rtUnpackBack s j cell))))))))))))))))))",
     "",
     "; where the sequence that holds byte j starts: back over at most three",
     "; continuation bytes",
     "(val rtLead (-> !Str !Int Int)",
     "  (\\ ((s !Str) (j !Int)) (rtLeadFrom s j 3)))",
     "",
     "(val rtLeadFrom (-> !Str !Int !Int Int)",
     "  (\\ ((s !Str) (j !Int) (left !Int))",
     "    (case (prim str_byte s j) b",
     "      (_ (case (prim int_lt b 128) a",
     "           ((True) j)",
     "           ((False)",
     "             (case (prim int_ge b 192) lead",
     "               ((True) j)",
     "               ((False)",
     "                 (case (prim int_eq left 0) out",
     "                   ((True) j)",
     "                   ((False)",
     "                     (case (prim int_eq j 0) start",
     "                       ((True) j)",
     "                       ((False) (case (prim int_sub j 1) j1 (_ (case (prim int_sub left 1) l1 (_ (rtLeadFrom s j1 l1)))))))))))))))))",
     "",
     "; the length of a list, its spine forced",
     "(val rtLength (-> ([] Char) !Int Int)",
     "  (\\ ((xs ([] Char)) (n !Int))",
     "    (case xs ys",
     "      (([]) n)",
     "      ((: _ rest) (case (prim int_add n 1) m (_ (rtLength rest m)))))))",
     "",
     "; the bytes of the first k characters of a list in UTF-8, and the rest:",
     "; halves, so that a string of n characters is packed in n log n",
     "(val rtPackN (-> !Int ([] Char) (utuple !Str ([] Char)))",
     "  (\\ ((k !Int) (xs ([] Char)))",
     "    (case (prim int_le k 1) small",
     "      ((True)",
     "        (case (prim int_eq k 1) one",
     "          ((False) (utuple \"\" xs))",
     "          ((True)",
     "            (case xs ys",
     "              ((: c rest) (case c d (_ (case (prim str_from_char d) t (_ (utuple t rest))))))",
     "              (([]) (utuple \"\" xs))))))",
     "      ((False)",
     "        (case (prim int_quot k 2) h",
     "          (_ (case (rtPackN h xs) a",
     "               ((utuple sa ra)",
     "                 (case (prim int_sub k h) h2",
     "                   (_ (case (rtPackN h2 ra) b",
     "                        ((utuple sb rb) (case (prim str_concat sa sb) t (_ (utuple t rb)))))))))))))))",
     "",
     "; a String as a Str, in UTF-8",
     "(val rtPack (-> ([] Char) Str)",
     "  (\\ ((xs ([] Char)))",
     "    (case (rtLength xs 0) n (_ (case (rtPackN n xs) r ((utuple t _) t))))))",
     "",
     "; ---- Handles: 0 standard input, 1 output, 2 error, others files",
     "",
     "; writes the bytes, or raises an IOError",
     "(val rtWrite (-> !Int !Str World (utuple World `()`))",
     "  (\\ ((h !Int) (s !Str) (w World))",
     "    (case (prim h_write h s w) r",
     "      ((utuple w1 ok)",
     "        (case ok b",
     "          ((True) (let (u `()` (con `()`)) (utuple w1 u)))",
     "          ((False) (case (rtFailure \"hPutStr\" h \"\" w1) r2 ((utuple w2 e) (prim raise_io @`()` e w2)))))))))",
     "",
     "; opens a file, or raises an IOError that says which and why",
     "(val rtOpen (-> !Str !Int World (utuple World Int))",
     "  (\\ ((p !Str) (mode !Int) (w World))",
     "    (case (prim h_open p mode w) o",
     "      ((utuple w1 h)",
     "        (case (prim int_lt h 0) failed",
     "          ((False) (utuple w1 h))",
     "          ((True)",
     "            (case (prim str_concat \"openFile: \" p) what",
     "              (_ (case (rtFailure what -1 p w1) r ((utuple w2 e) (prim raise_io @Int e w2)))))))))))",
     "",
     "; the IOError of the last failure of a handle's, h's (~1 for none), or of",
     "; the file p's, in what: its text \"what: the system's text\", as the",
     "; library's, and the kind of its error",
     "(val rtFailure (-> !Str !Int !Str World (utuple World !Exn))",
     "  (\\ ((what !Str) (h !Int) (p !Str) (w World))",
     "    (case (prim h_error w) r",
     "      ((utuple w1 m)",
     "        (case (prim h_errno w1) q",
     "          ((utuple w2 en)",
     "            (case (prim sys_error_name en) nm",
     "              (_ (case (rtErrnoKind nm) k",
     "                   (_ (case (prim str_concat what \": \") a",
     "                        (_ (case (prim str_concat a m) t",
     "                             (_ (case (prim exn_io_full k t p h) e (_ (utuple w2 e)))))))))))))))))",
     "",
     "; the kind of an IOError of a system's error, by the error's name (L's",
     "; PreludeRuntime.primErrnoKind): 1 already exists, 2 does not exist, 3 in",
     "; use, 4 full, 7 permission, 6 any other",
     "(val rtErrnoKind (-> !Str Int)",
     "  (\\ ((n !Str))",
     "    (case (rtAny2 n \"EEXIST\" \"ENOTEMPTY\") a",
     "      ((True) 1)",
     "      ((False)",
     "        (case (rtAny2 n \"ENOENT\" \"ENOTDIR\") b",
     "          ((True) 2)",
     "          ((False)",
     "            (case (rtAny2 n \"EBUSY\" \"ETXTBSY\") c",
     "              ((True) 3)",
     "              ((False)",
     "                (case (rtAny3 n \"ENOSPC\" \"EDQUOT\" \"EFBIG\") d",
     "                  ((True) 4)",
     "                  ((False) (case (rtAny3 n \"EACCES\" \"EPERM\" \"EROFS\") f ((True) 7) ((False) 6))))))))))))",
     "",
     "(val rtAny2 (-> !Str !Str !Str Bool)",
     "  (\\ ((n !Str) (a !Str) (b !Str)) (case (prim str_eq n a) x ((True) (con True)) ((False) (prim str_eq n b)))))",
     "",
     "(val rtAny3 (-> !Str !Str !Str !Str Bool)",
     "  (\\ ((n !Str) (a !Str) (b !Str) (c !Str)) (case (prim str_eq n a) x ((True) (con True)) ((False) (rtAny2 n b c)))))",
     "",
     "; the next bytes of a handle, standard output written first; \"\" at its end",
     "; and where the read fails, for errors on a semi-closed handle are",
     "; discarded (21.2.2)",
     "(val rtChunk (-> !Int World (utuple World Str))",
     "  (\\ ((h !Int) (w World))",
     "    (case (prim h_flush 1 w) w1",
     "      (_ (let (act (-> World (utuple World Str)) (\\ ((v World)) (prim h_read h 4096 v)))",
     "         (let (none (-> !Exn World (utuple World Str)) (\\ ((e !Exn) (v World)) (utuple v \"\")))",
     "           (prim catch @Str act none w1)))))))",
     "",
     "; where the last whole sequence of s ends: at n, or before a sequence that",
     "; the next bytes complete",
     "(val rtCut (-> !Str !Int Int)",
     "  (\\ ((s !Str) (n !Int)) (case (prim int_sub n 1) p (_ (rtCutAt s n p 3)))))",
     "",
     "(val rtCutAt (-> !Str !Int !Int !Int Int)",
     "  (\\ ((s !Str) (n !Int) (p !Int) (left !Int))",
     "    (case (prim int_lt p 0) none",
     "      ((True) n)",
     "      ((False)",
     "        (case (prim int_eq left 0) out",
     "          ((True) n)",
     "          ((False)",
     "            (case (prim str_byte s p) b",
     "              (_ (case (prim int_lt b 128) a",
     "                   ((True) n)",
     "                   ((False)",
     "                     (case (prim int_lt b 192) cont",
     "                       ((True) (case (prim int_sub p 1) p1 (_ (case (prim int_sub left 1) l1 (_ (rtCutAt s n p1 l1))))))",
     "                       ((False)",
     "                         (case (rtSeqLen b) len",
     "                           (_ (case (prim int_add p len) e",
     "                                (_ (case (prim int_gt e n) over ((True) p) ((False) n))))))))))))))))))",
     "",
     "; the characters of a handle from here, the bytes `left` before them, read",
     "; a chunk at a time as the list is: the handle closed at its end",
     "(val rtLazyRead (-> !Int !Str World (utuple World ([] Char)))",
     "  (\\ ((h !Int) (left !Str) (w World))",
     "    (case (rtChunk h w) rc",
     "      ((utuple w1 chunk)",
     "        (case chunk ch",
     "          (_ (case (prim str_size ch) m",
     "               (0 (case (prim h_close h w1) w2",
     "                    (_ (case (prim str_size left) ln",
     "                         (_ (let (nil ([] Char) (con [] @Char))",
     "                            (let (cs ([] Char) (rtUnpackAppend left 0 ln nil)) (utuple w2 cs))))))))",
     "               (_ (case (prim str_concat left ch) s",
     "                    (_ (case (prim str_size s) n",
     "                         (_ (case (rtCut s n) cut",
     "                              (_ (case (prim int_sub n cut) k",
     "                                   (_ (case (prim str_extract s cut k) left2",
     "                                        (_ (let (next (-> World (utuple World ([] Char))) (\\ ((v World)) (rtLazyRead h left2 v)))",
     "                                           (case (prim interleave @([] Char) next w1) nx",
     "                                             ((utuple w2 rest)",
     "                                               (let (cs ([] Char) (rtUnpackAppend s 0 cut rest)) (utuple w2 cs)))))))))))))))))))))))",
     "",
     "; what standard input has given and no one has read: its bytes and where",
     "; the next character starts",
     "(data rtBuffer () (rtBuffer !Str !Int))",
     "",
     "(val rtStdin (Ref rtBuffer)",
     "  (case (prim real_world) w",
     "    (_ (let (b rtBuffer (con rtBuffer \"\" 0)) (case (prim ref_new @rtBuffer b w) r ((utuple _ c) c))))))",
     "",
     "(val primGetChar (-> World (utuple World Char))",
     "  (\\ ((w World))",
     "    (case rtStdin r",
     "      (_ (case (prim ref_get @rtBuffer r w) g",
     "           ((utuple w1 b)",
     "             (case b bv",
     "               ((rtBuffer s i)",
     "                 (case (prim str_size s) n",
     "                   (_ (case (prim int_lt i n) some",
     "                        ((True)",
     "                          (case (prim str_byte s i) b0",
     "                            (_ (case (rtSeqLen b0) len",
     "                                 (_ (case (prim int_add i len) e",
     "                                      (_ (case (prim int_le e n) whole",
     "                                           ((True) (rtTake r s i n w1))",
     "                                           ((False) (rtRefill r s i n w1))))))))))",
     "                        ((False) (rtRefill r s i n w1)))))))))))))",
     "",
     "(val rtTake (-> !(Ref rtBuffer) !Str !Int !Int World (utuple World Char))",
     "  (\\ ((r !(Ref rtBuffer)) (s !Str) (i !Int) (n !Int) (w World))",
     "    (case (rtDecode s i n) d",
     "      ((utuple c j)",
     "        (let (b rtBuffer (con rtBuffer s j))",
     "          (case (prim ref_set @rtBuffer r b w) w1 (_ (utuple w1 c))))))))",
     "",
     "; more of standard input, standard output written first; at its end what",
     "; is left, or an IOError",
     "(val rtRefill (-> !(Ref rtBuffer) !Str !Int !Int World (utuple World Char))",
     "  (\\ ((r !(Ref rtBuffer)) (s !Str) (i !Int) (n !Int) (w World))",
     "    (case (prim h_flush 1 w) w1",
     "      (_ (case (prim h_read 0 4096 w1) rd",
     "           ((utuple w2 chunk)",
     "             (case (prim str_size chunk) m",
     "               (0 (case (prim int_lt i n) left",
     "                    ((True) (rtTake r s i n w2))",
     "                    ((False) (case (prim exn_io_full 5 \"end of file\" \"\" 0) e (_ (prim raise_io @Char e w2))))))",
     "               (_ (case (prim int_sub n i) k",
     "                    (_ (case (prim str_extract s i k) rest",
     "                         (_ (case (prim str_concat rest chunk) s2",
     "                              (_ (let (b rtBuffer (con rtBuffer s2 0))",
     "                                   (case (prim ref_set @rtBuffer r b w2) w3",
     "                                     (_ (primGetChar w3))))))))))))))))))",
     "",
     "; the rest of standard input, read as the list is (D25's one interleaving",
     "; primitive); what getChar left in the buffer comes first",
     "(val primGetContents (-> World (utuple World ([] Char)))",
     "  (\\ ((w World))",
     "    (case rtStdin r",
     "      (_ (case (prim ref_get @rtBuffer r w) g",
     "           ((utuple w1 b)",
     "             (case b bv",
     "               ((rtBuffer s i)",
     "                 (case (prim str_size s) n",
     "                   (_ (case (prim int_sub n i) k",
     "                        (_ (case (prim str_extract s i k) left",
     "                             (_ (let (empty rtBuffer (con rtBuffer \"\" 0))",
     "                                  (case (prim ref_set @rtBuffer r empty w1) w2",
     "                                    (_ (let (act (-> World (utuple World ([] Char))) (\\ ((v World)) (rtLazyRead 0 left v)))",
     "                                         (prim interleave @([] Char) act w2)))))))))))))))))))",
     "",
     "(val primPutChar (-> Char World (utuple World `()`))",
     "  (\\ ((c Char) (w World))",
     "    (case c d (_ (case (prim str_from_char d) s (_ (rtWrite 1 s w)))))))",
     "",
     "; the characters of a list written to a handle, one by one",
     "(val rtWriteChars (-> !Int ([] Char) World (utuple World `()`))",
     "  (\\ ((h !Int) (xs ([] Char)) (w World))",
     "    (case xs ys",
     "      (([]) (let (u `()` (con `()`)) (utuple w u)))",
     "      ((: c rest)",
     "        (case c d (_ (case (prim str_from_char d) s (_ (case (rtWrite h s w) o ((utuple w1 _) (rtWriteChars h rest w1)))))))))))",
     "",
     "(val rtWriteFile (-> !Int ([] Char) ([] Char) World (utuple World `()`))",
     "  (\\ ((mode !Int) (path ([] Char)) (text ([] Char)) (w World))",
     "    (case (rtPack path) p",
     "      (_ (case (rtOpen p mode w) o",
     "           ((utuple w1 h)",
     "             (case h hv",
     "               (_ (case (rtWriteChars hv text w1) r",
     "                    ((utuple w2 u) (case (prim h_close hv w2) w3 (_ (utuple w3 u)))))))))))))",
     "",
     "(val primWriteFile (-> ([] Char) ([] Char) World (utuple World `()`))",
     "  (\\ ((path ([] Char)) (text ([] Char)) (w World)) (rtWriteFile 1 path text w)))",
     "",
     "(val primAppendFile (-> ([] Char) ([] Char) World (utuple World `()`))",
     "  (\\ ((path ([] Char)) (text ([] Char)) (w World)) (rtWriteFile 2 path text w)))",
     "",
     "(val primReadFile (-> ([] Char) World (utuple World ([] Char)))",
     "  (\\ ((path ([] Char)) (w World))",
     "    (case (rtPack path) p",
     "      (_ (case (rtOpen p 0 w) o",
     "           ((utuple w1 h)",
     "             (case h hv",
     "               (_ (let (act (-> World (utuple World ([] Char))) (\\ ((v World)) (rtLazyRead hv \"\" v)))",
     "                    (prim interleave @([] Char) act w1))))))))))",
     "",
     "; ---- UnicodePrims: lib/unicode's general category and simple case",
     "; mappings (D21), from tables rhc writes from lib/unicode's data: rtLatin1,",
     "; the category of each code point below 256 as the byte \"0\" plus it;",
     "; rtCategories, ranges of nine bytes, the first and the last code point in",
     "; four digits of base 64 from \"0\" and the category as one; rtUpper and",
     "; rtLower, runs of thirteen bytes, the first and the last code point, the",
     "; step between those mapped, and the distance of each from its mapping",
     "; plus 8388608, in four digits",
     "",
     "; the number of k digits of base 64 at j, after acc",
     "(val rtNum (-> !Str !Int !Int !Int Int)",
     "  (\\ ((t !Str) (j !Int) (k !Int) (acc !Int))",
     "    (case (prim int_eq k 0) done",
     "      ((True) acc)",
     "      ((False)",
     "        (case (prim str_byte t j) b",
     "          (_ (case (prim int_sub b 48) d",
     "               (_ (case (rtSix acc d) acc1",
     "                    (_ (case (prim int_add j 1) j1",
     "                         (_ (case (prim int_sub k 1) k1 (_ (rtNum t j1 k1 acc1)))))))))))))))",
     "",
     "(val rtNum4 (-> !Str !Int Int) (\\ ((t !Str) (j !Int)) (rtNum t j 4 0)))",
     "",
     "; the general category of a code point: 0 Lu, 1 Ll, 2 Lt, 3 Lm, 4 Lo, 5 Mn,",
     "; 6 Mc, 7 Me, 8 Nd, 9 Nl, 10 No, 11 to 17 P, 18 to 21 S, 22 Zs, 23 Zl, 24",
     "; Zp, 25 to 29 C, 29 Cn (CodePoint.category's order)",
     "(val rtCategory (-> !Int Int)",
     "  (\\ ((c !Int))",
     "    (case (prim int_lt c 256) small",
     "      ((True) (case rtLatin1 t (_ (case (prim str_byte t c) b (_ (prim int_sub b 48))))))",
     "      ((False)",
     "        (case rtCategories t",
     "          (_ (case (prim str_size t) n",
     "               (_ (case (prim int_quot n 9) m (_ (rtSearch t c 0 m)))))))))))",
     "",
     "; the category of c in the ranges lo to hi of t, Cn where none holds it",
     "(val rtSearch (-> !Str !Int !Int !Int Int)",
     "  (\\ ((t !Str) (c !Int) (lo !Int) (hi !Int))",
     "    (case (prim int_ge lo hi) none",
     "      ((True) 29)",
     "      ((False)",
     "        (case (prim int_add lo hi) s",
     "          (_ (case (prim int_quot s 2) m",
     "               (_ (case (prim int_mul m 9) j",
     "                    (_ (case (rtNum4 t j) first",
     "                         (_ (case (prim int_lt c first) below",
     "                              ((True) (rtSearch t c lo m))",
     "                              ((False)",
     "                                (case (prim int_add j 4) j4",
     "                                  (_ (case (rtNum4 t j4) last",
     "                                       (_ (case (prim int_gt c last) above",
     "                                            ((True) (case (prim int_add m 1) m1 (_ (rtSearch t c m1 hi))))",
     "                                            ((False)",
     "                                              (case (prim int_add j 8) j8",
     "                                                (_ (case (prim str_byte t j8) b (_ (prim int_sub b 48)))))))))))))))))))))))))",
     "",
     "; c mapped by the runs of t: c plus the distance of its run, where its run",
     "; holds it and its step reaches it; c where none does",
     "(val rtMap (-> !Str !Int Int)",
     "  (\\ ((t !Str) (c !Int))",
     "    (case (prim str_size t) n (_ (case (prim int_quot n 13) m (_ (rtMapSearch t c 0 m)))))))",
     "",
     "(val rtMapSearch (-> !Str !Int !Int !Int Int)",
     "  (\\ ((t !Str) (c !Int) (lo !Int) (hi !Int))",
     "    (case (prim int_ge lo hi) none",
     "      ((True) c)",
     "      ((False)",
     "        (case (prim int_add lo hi) s",
     "          (_ (case (prim int_quot s 2) m",
     "               (_ (case (prim int_mul m 13) j",
     "                    (_ (case (rtNum4 t j) first",
     "                         (_ (case (prim int_lt c first) below",
     "                              ((True) (rtMapSearch t c lo m))",
     "                              ((False)",
     "                                (case (prim int_add j 4) j4",
     "                                  (_ (case (rtNum4 t j4) last",
     "                                       (_ (case (prim int_gt c last) above",
     "                                            ((True) (case (prim int_add m 1) m1 (_ (rtMapSearch t c m1 hi))))",
     "                                            ((False) (rtMapRun t c j first)))))))))))))))))))))",
     "",
     "(val rtMapRun (-> !Str !Int !Int !Int Int)",
     "  (\\ ((t !Str) (c !Int) (j !Int) (first !Int))",
     "    (case (prim int_add j 8) j8",
     "      (_ (case (prim str_byte t j8) sb",
     "           (_ (case (prim int_sub sb 48) step",
     "                (_ (case (prim int_sub c first) off",
     "                     (_ (case (prim int_rem off step) r",
     "                          (_ (case (prim int_eq r 0) on",
     "                               ((False) c)",
     "                               ((True)",
     "                                 (case (prim int_add j 9) j9",
     "                                   (_ (case (rtNum4 t j9) d",
     "                                        (_ (case (prim int_sub d 8388608) delta (_ (prim int_add c delta)))))))))))))))))))))",
     "",
     "(val rtCategoryOf (-> Char Int) (\\ ((c Char)) (case c d (_ (case (prim char_ord d) i (_ (rtCategory i)))))))",
     "",
     "(val primUnicodeMaxChar Char '\\1114111')",
     "",
     "; alphabetic and not lower case (R38): Lu, Lt, Lm and Lo",
     "(val primUnicodeIsUpper (-> Char Bool)",
     "  (\\ ((c Char))",
     "    (case (rtCategoryOf c) g (0 (con True)) (2 (con True)) (3 (con True)) (4 (con True)) (_ (con False)))))",
     "",
     "(val primUnicodeIsLower (-> Char Bool)",
     "  (\\ ((c Char)) (case (rtCategoryOf c) g (1 (con True)) (_ (con False)))))",
     "",
     "; a letter or a number: L and N",
     "(val primUnicodeIsAlphaNum (-> Char Bool)",
     "  (\\ ((c Char))",
     "    (case (rtCategoryOf c) g",
     "      (_ (case (prim int_le g 4) letter",
     "           ((True) (con True))",
     "           ((False) (case (prim int_ge g 8) n ((False) (con False)) ((True) (prim int_le g 10)))))))))",
     "",
     "; a letter, mark, number, punctuation, symbol or space: not Zl, Zp or C",
     "(val primUnicodeIsPrint (-> Char Bool)",
     "  (\\ ((c Char)) (case (rtCategoryOf c) g (_ (prim int_le g 22)))))",
     "",
     "; ASCII by its rule, the rest by a table",
     "(val rtCase (-> !Str !Int !Int !Int Char Char)",
     "  (\\ ((t !Str) (from !Int) (to !Int) (shift !Int) (c Char))",
     "    (case c d",
     "      (_ (case (prim char_ord d) i",
     "           (_ (case (prim int_lt i 128) ascii",
     "                ((True)",
     "                  (case (prim int_lt i from) below",
     "                    ((True) d)",
     "                    ((False)",
     "                      (case (prim int_gt i to) above",
     "                        ((True) d)",
     "                        ((False) (case (prim int_add i shift) j (_ (prim char_chr j))))))))",
     "                ((False) (case (rtMap t i) j (_ (prim char_chr j)))))))))))",
     "",
     "(val primUnicodeToUpper (-> Char Char)",
     "  (\\ ((c Char)) (case rtUpper t (_ (rtCase t 97 122 -32 c)))))",
     "",
     "(val primUnicodeToLower (-> Char Char)",
     "  (\\ ((c Char)) (case rtLower t (_ (rtCase t 65 90 32 c)))))",
     "",
     "; ---- What the library names beside the Report's (L's PreludeRuntime)",
     "",
     "; decodeFloat's halves, which Haskell cannot take from an unboxed pair",
     "(val double_mantissa (-> Double Int)",
     "  (\\ ((d Double)) (case d e (_ (case (prim double_decode e) p ((utuple m _) m))))))",
     "",
     "(val double_exponent (-> Double Int)",
     "  (\\ ((d Double)) (case d e (_ (case (prim double_decode e) p ((utuple _ x) x))))))",
     "",
     "; an action run at a state of its own, its value forced with this: the",
     "; library's cells, made once",
     "(val unsafe_perform_io (forall (a) (-> (-> World (utuple World a)) a))",
     "  (\\ (@a (m (-> World (utuple World a))))",
     "    (case (prim real_world) w (_ (case (m w) r ((utuple _ x) x))))))",
     "",
     "; a String as a Str, in UTF-8: a file's name, an IOError's text",
     "(val primPackString (-> ([] Char) Str) (\\ ((s ([] Char))) (rtPack s)))",
     "",
     "; whether input waits on a handle, or comes within so many milliseconds;",
     "; on standard input, what getChar left in its buffer first",
     "(val primReady (-> Int Int World (utuple World Bool))",
     "  (\\ ((h Int) (ms Int) (w World))",
     "    (case h hv",
     "      (_ (case ms mv",
     "           (_ (case (prim int_eq hv 0) std",
     "                ((True)",
     "                  (case rtStdin r",
     "                    (_ (case (prim ref_get @rtBuffer r w) g",
     "                         ((utuple w1 b)",
     "                           (case b bv",
     "                             ((rtBuffer s i)",
     "                               (case (prim str_size s) n",
     "                                 (_ (case (prim int_lt i n) some",
     "                                      ((True) (let (t Bool (con True)) (utuple w1 t)))",
     "                                      ((False) (rtReady hv mv w1))))))))))))",
     "                ((False) (rtReady hv mv w)))))))))",
     "",
     "(val rtReady (-> !Int !Int World (utuple World Bool))",
     "  (\\ ((h !Int) (ms !Int) (w World)) (case (prim h_ready h ms w) r ((utuple w1 b) (utuple w1 b)))))",
     "",
     "; ---- IO-shaped: the primitives whose action gives World alone, as",
     "; actions giving `()`, which Haskell can name as IO ()",
     "",
     "(val ref_set (forall (a) (-> (Ref a) a World (utuple World `()`)))",
     "  (\\ (@a (r (Ref a)) (x a) (w World))",
     "    (case r rv (_ (case (prim ref_set @a rv x w) w1 (_ (let (u `()` (con `()`)) (utuple w1 u))))))))",
     "",
     "(val arr_set (forall (a) (-> (Arr a) Int a World (utuple World `()`)))",
     "  (\\ (@a (r (Arr a)) (i Int) (x a) (w World))",
     "    (case r rv (_ (case i iv (_ (case (prim arr_set @a rv iv x w) w1 (_ (let (u `()` (con `()`)) (utuple w1 u))))))))))",
     "",
     "(val h_close (-> Int World (utuple World `()`))",
     "  (\\ ((h Int) (w World))",
     "    (case h hv (_ (case (prim h_close hv w) w1 (_ (let (u `()` (con `()`)) (utuple w1 u))))))))",
     "",
     "(val h_flush (-> Int World (utuple World `()`))",
     "  (\\ ((h Int) (w World))",
     "    (case h hv (_ (case (prim h_flush hv w) w1 (_ (let (u `()` (con `()`)) (utuple w1 u))))))))",
     "",
     "(val exit (forall (a) (-> Int World (utuple World a)))",
     "  (\\ (@a (n Int) (w World))",
     "    (case n nv",
     "      (_ (case (prim exit nv w) w1",
     "           (_ (case (prim exn_error \"exit returned\") e (_ (prim raise_io @a e w1)))))))))"
    ]

  (* how a literal is made: the function of the runtime that primUnpackString is *)
  fun unpacking Lazy = "(val primUnpackString (-> !Str ([] Char)) (\\ ((s !Str)) (rtUnpackLazy s)))"
    | unpacking Whole = "(val primUnpackString (-> !Str ([] Char)) (\\ ((s !Str)) (rtUnpackWhole s)))"

  (* ---- The tables, from lib/unicode's data ---- *)

  structure D = UnicodeCodePointData

  (* n in k digits of base 64, each the byte "0" plus it *)
  fun digits (k, n) =
    let fun go (0, _, acc) = acc
          | go (i, m, acc) = go (i - 1, m div 64, Char.chr (48 + m mod 64) :: acc)
    in String.implode (go (k, n, [])) end

  (* the ranges of categories that reach past 255: first, last, category *)
  fun categories () =
    let
      val v = D.category ()
      fun go (i, acc) =
        if i + 2 >= Vector.length v then String.concat (List.rev acc)
        else
          let val (lo, hi, g) = (Vector.sub (v, i), Vector.sub (v, i + 1), Vector.sub (v, i + 2))
          in go (i + 3, if hi < 256 then acc else (digits (4, lo) ^ digits (4, hi) ^ digits (1, g)) :: acc) end
    in go (0, []) end

  (* the runs of a case mapping: first, last, step, distance plus 2^23 *)
  fun runs (v : int vector) =
    let
      fun go (i, acc) =
        if i + 3 >= Vector.length v then String.concat (List.rev acc)
        else
          let val (lo, hi, step, d) = (Vector.sub (v, i), Vector.sub (v, i + 1), Vector.sub (v, i + 2), Vector.sub (v, i + 3))
          in go (i + 4, (digits (4, lo) ^ digits (4, hi) ^ digits (1, step) ^ digits (4, d + 8388608)) :: acc) end
    in go (0, []) end

  fun table (name, s) = Val (name, TCon "Str", Atom (Lit (LStr s)))

  (* the whole runtime, read once for each way of making literals *)
  val made : (strings * program) list ref = ref []
  fun program strings =
    case List.find (fn (s, _) => s = strings) (!made) of
      SOME (_, p) => p
    | NONE =>
        let
          val p = CoreText.parse (text ^ "\n" ^ unpacking strings ^ "\n")
                  @ [table ("rtLatin1", D.latin1), table ("rtCategories", categories ()),
                     table ("rtUpper", runs (D.upper ())), table ("rtLower", runs (D.lower ()))]
        in made := (strings, p) :: !made; p end

  (* ---- Linking ---- *)

  fun tyNames (t, acc) =
    case t of
      TCon c => c :: acc
    | TVar _ => acc
    | TApp (a, b) => tyNames (a, tyNames (b, acc))
    | TFun (a, b) => tyNames (a, tyNames (b, acc))
    | TForall (_, _, b) => tyNames (b, acc)
    | TEval a => tyNames (a, acc)
    | TUTuple ts => List.foldl tyNames acc ts
  fun atomNames (Var x, acc) = x :: acc
    | atomNames (Lit _, acc) = acc
  fun expNames (e, acc) =
    case e of
      Atom a => atomNames (a, acc)
    | App (f, args) =>
        List.foldl (fn (TyArg t, acc) => tyNames (t, acc) | (ValArg a, acc) => atomNames (a, acc)) (expNames (f, acc)) args
    | Lam (bs, body) =>
        List.foldl (fn (ValBinder (_, t), acc) => tyNames (t, acc) | (TyBinder _, acc) => acc) (expNames (body, acc)) bs
    | Let (_, t, rhs, body) => tyNames (t, expNames (rhs, expNames (body, acc)))
    | LetRec (bs, body) => List.foldl (fn ((_, t, rhs), acc) => tyNames (t, expNames (rhs, acc))) (expNames (body, acc)) bs
    | Case (scrut, _, alts) => List.foldl altNames (expNames (scrut, acc)) alts
    | Con (c, ts, atoms) => c :: List.foldl tyNames (List.foldl atomNames acc atoms) ts
    | Prim (_, ts, atoms) => List.foldl tyNames (List.foldl atomNames acc atoms) ts
    | UTuple atoms => List.foldl atomNames acc atoms
    | Cast (e, t) => tyNames (t, expNames (e, acc))
  and altNames (alt, acc) =
    case alt of
      AltCon (c, _, rhs) => c :: expNames (rhs, acc)
    | AltLit (_, rhs) => expNames (rhs, acc)
    | AltUTuple (_, rhs) => expNames (rhs, acc)
    | AltDefault rhs => expNames (rhs, acc)
  (* the names a declaration mentions *)
  fun mentions d =
    case d of
      Data (_, _, cons) => List.foldl (fn ((_, fs), acc) => List.foldl tyNames acc fs) [] cons
    | Newtype (_, _, _, f) => tyNames (f, [])
    | Val (_, t, e) => tyNames (t, expNames (e, []))
  (* the names a declaration makes *)
  fun makes d =
    case d of
      Data (t, _, cons) => t :: List.map #1 cons
    | Newtype (t, _, c, _) => [t, c]
    | Val (x, _, _) => [x]

  fun link strings (p : program) : program =
    let
      val own = List.foldl (fn (n, m) => CoreMap.insert (m, n, ())) CoreMap.empty (List.concat (List.map makes p))
      val runtime = List.filter (fn d => not (List.exists (fn n => CoreMap.member (own, n)) (makes d))) (program strings)
      (* the runtime's declarations by the names they make *)
      val byName = List.foldl (fn ((i, d), m) => List.foldl (fn (n, m) => CoreMap.insert (m, n, i)) m (makes d))
                              CoreMap.empty (ListPair.zip (List.tabulate (List.length runtime, fn i => i), runtime))
      val decls = Vector.fromList runtime
      (* the numbers of the declarations reached from the names to visit *)
      fun reach ([], chosen) = chosen
        | reach (n :: rest, chosen) =
            case CoreMap.find (byName, n) of
              NONE => reach (rest, chosen)
            | SOME i =>
                if CoreMap.member (chosen, Int.toString i) then reach (rest, chosen)
                else reach (mentions (Vector.sub (decls, i)) @ rest, CoreMap.insert (chosen, Int.toString i, ()))
      val chosen = reach (List.concat (List.map mentions p), CoreMap.empty)
    in
      List.mapPartial (fn (i, d) => if CoreMap.member (chosen, Int.toString i) then SOME d else NONE)
                      (ListPair.zip (List.tabulate (List.length runtime, fn i => i), runtime))
      @ p
    end
end
