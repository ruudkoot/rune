(* The Debug Adapter Protocol library (docs/plans/repl.md, The
   libraries; M12): its messages and their framing; its files in load
   order, in the form of lib/basis/library.build. It is written on
   lib/jsonrpc, for the framing, and lib/json, for the messages: *)
requires jsonrpc json end
(* exports: what the library's clients use (tools/migrate; docs/build.md, Migrating a tree) *)
exports (structure Dap, signature DAP)
annotate "demand" in
  dap_sig.sml
  dap.sml
end
