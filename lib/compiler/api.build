(* Shared API graph. The other SML systems have the portable platform
   module alone (host=only), and Rune its runtime adapter (host=no), each
   before the facade: one module of the name in either. *)
use internal.build
files
  syntax/ast.sml
  syntax/parser.sml
  syntax/incremental.sml
  api/session.sml
  api/build-query.sml
  api/node-types.sml
  api/query.sml
  api/facts.sml
  api/analysis-engine.sml
  api/scope-probe.sml
  api/analysis.sml
  api/compiler_sig.sml
end
annotate "host=only" in
  api/platform.sml
end
annotate "host=no" in
  api/platform-rune.sml
end
files
  api/compiler.sml
end
