(* A function of Mid in bytes, its names written and read by the caller
   (functors-units.md, M6b): what a
   unit's basis keeps of a functor marked to be inlined (UnitBasis.funcode),
   so that a unit that applies it expands its body (Expand). The names a
   function binds -- its parameters, its locals, its join points -- are its
   own, numbered from 0 in the order the writing meets them, and read back
   as the names the reader gives (fresh ones); every other name, a global, a
   type name, a type variable, is the caller's to write and read. The
   encoding is UnitMid's, a type written once and then by its number: both
   are the codecs below, generated from the description of the compiler's
   codecs (tools/codecs/compiler.sml), each name by a hook of the caller's. *)
structure MidCodec =
struct
  structure P = Pickle
  open Mid

  (* position: told of every span written, which the file and the offsets of
     the bytes do not place on a line without the source; funName: the name
     of a function the body binds, by its first parameter *)
  type namer = {stamp : int -> unit, tycon : int -> unit, tvar : int -> unit, file : string -> unit,
                position : Source.span -> unit, funName : int -> string option}
  type unnamer = {stamp : unit -> int, tycon : unit -> int, tvar : unit -> int, file : unit -> string, local' : int -> int}

  exception Bad of string

  (* What the codecs write with: the bytes, a hook for each kind of name --
     a name the function binds or names (stamp), its own name where it is
     a global (global), a type name, a type variable, a source file -- one
     told of each span, and the types written, by Ty.id, with how many *)
  type wctx = {w : P.writer, stamp : int -> unit, global : int -> unit, tycon : int -> unit, tvar : int -> unit,
               file : string -> unit, position : Source.span -> unit, written : int IntTable.table, nwritten : int ref}
  (* and read with: the types read, in the order written *)
  type rctx = {r : P.reader, stamp : unit -> int, global : unit -> int, tycon : unit -> int, tvar : unit -> int,
               file : unit -> string, read' : Ty.ty IntTable.table, nread : int ref}

  (* a constant's number, in its digits *)
  fun bigint (c : rctx) : IntInf.int =
    case IntInf.fromString (P.rstring (#r c)) of SOME i => i | NONE => raise Bad "not a number"

  (* a constant, a type, a place and a frame, an atom, a step, an expression,
     a function -- one a basis keeps, whose name is a global (topfun) -- and a
     definition; and the names an expression and a function bind *)
  (* ---- generated by bin/rune-codecs from tools/codecs/compiler.sml (make codecs): codecs of Mid ---- *)
  fun const (c : wctx, v : Lambda.const) : unit =
    case v of
      Lambda.CInt i' => (P.byte (#w c, 0); P.string (#w c, IntInf.toString i'))
    | Lambda.CWord i' => (P.byte (#w c, 1); P.string (#w c, IntInf.toString i'))
    | Lambda.CInt64 i' => (P.byte (#w c, 2); P.string (#w c, IntInf.toString i'))
    | Lambda.CWord64 i' => (P.byte (#w c, 3); P.string (#w c, IntInf.toString i'))
    | Lambda.CReal s' => (P.byte (#w c, 4); P.string (#w c, s'))
    | Lambda.CString s' => (P.byte (#w c, 5); P.string (#w c, s'))
    | Lambda.CChar n' => (P.byte (#w c, 6); P.nat (#w c, n'))

  and ty (c : wctx, v : Ty.ty) : unit =
    case IntTable.find (#written c, Ty.id v) of
      SOME k => (P.byte (#w c, 6); P.nat (#w c, k))
    | NONE =>
      ((case Ty.view v of
      Ty.Gen i' => (P.byte (#w c, 0); #tvar c i')
    | Ty.Var i' => (P.byte (#w c, 1); #tvar c i')
    | Ty.Con (s', n', args') =>
        (P.byte (#w c, 2);
         #tycon c s';
         P.string (#w c, n');
         P.list (fn (_, x_1) => ty (c, x_1)) (#w c, args'))
    | Ty.Tuple ts' => (P.byte (#w c, 3); P.list (fn (_, x_2) => ty (c, x_2)) (#w c, ts'))
    | Ty.Arrow (a', b') => (P.byte (#w c, 4); ty (c, a'); ty (c, b'))
    | Ty.ExnCon => P.byte (#w c, 5));
       IntTable.insert (#written c, Ty.id v, !(#nwritten c)); #nwritten c := !(#nwritten c) + 1)

  and span (c : wctx, v : Source.span) : unit =
    case v of
      {file = file', start = start', stop = stop'} =>
        (#position c v;
         #file c file';
         P.nat (#w c, start');
         P.nat (#w c, stop'))

  and frame (c : wctx, v : Mid.frame) : unit =
    case v of
      {name = name', site = site'} =>
        (P.string (#w c, name');
         P.option (fn (_, x_1) => span (c, x_1)) (#w c, site'))

  and atom (c : wctx, v : Mid.atom) : unit =
    case v of
      Mid.Var (x', ts') => (P.byte (#w c, 0); #stamp c x'; P.list (fn (_, x_1) => ty (c, x_1)) (#w c, ts'))
    | Mid.Global (x', ts') => (P.byte (#w c, 1); #stamp c x'; P.list (fn (_, x_2) => ty (c, x_2)) (#w c, ts'))
    | Mid.Const (c', t') => (P.byte (#w c, 2); const (c, c'); ty (c, t'))
    | Mid.Con0 (tag', t') => (P.byte (#w c, 3); P.nat (#w c, tag'); ty (c, t'))
    | Mid.Unit => P.byte (#w c, 4)

  and rhs (c : wctx, v : Mid.rhs) : unit =
    case v of
      Mid.Atom a' => (P.byte (#w c, 0); atom (c, a'))
    | Mid.App (f', args') =>
        (P.byte (#w c, 1);
         atom (c, f');
         P.list (fn (_, x_1) => atom (c, x_1)) (#w c, args'))
    | Mid.Prim (n', t', args') =>
        (P.byte (#w c, 2);
         P.string (#w c, n');
         ty (c, t');
         P.list (fn (_, x_2) => atom (c, x_2)) (#w c, args'))
    | Mid.Tuple args' => (P.byte (#w c, 3); P.list (fn (_, x_3) => atom (c, x_3)) (#w c, args'))
    | Mid.Select (i', a') => (P.byte (#w c, 4); P.nat (#w c, i'); atom (c, a'))
    | Mid.Con (tag', t', a') => (P.byte (#w c, 5); P.nat (#w c, tag'); ty (c, t'); atom (c, a'))
    | Mid.Decon (tag', t', a') => (P.byte (#w c, 6); P.nat (#w c, tag'); ty (c, t'); atom (c, a'))
    | Mid.ConTag a' => (P.byte (#w c, 7); atom (c, a'))
    | Mid.NewExn s' => (P.byte (#w c, 8); P.string (#w c, s'))
    | Mid.BuiltinExn i' => (P.byte (#w c, 9); P.int (#w c, i'))
    | Mid.MkExn (a', b') => (P.byte (#w c, 10); atom (c, a'); atom (c, b'))
    | Mid.ExnCon a' => (P.byte (#w c, 11); atom (c, a'))
    | Mid.ExnArg (t', a') => (P.byte (#w c, 12); ty (c, t'); atom (c, a'))
    | Mid.SetGlobal (g', a') => (P.byte (#w c, 13); #stamp c g'; atom (c, a'))

  and exp (c : wctx, v : Mid.exp) : unit =
    case v of
      Mid.Let (x', s', r', b') =>
        (P.byte (#w c, 0);
         #stamp c x';
         (case s' of (x_1, x_2) => (P.list (fn (_, x_3) => #tvar c x_3) (#w c, x_1); ty (c, x_2)));
         rhs (c, r');
         exp (c, b'))
    | Mid.Fun (fs', b') =>
        (P.byte (#w c, 1);
         P.list (fn (_, x_4) => fundef (c, x_4)) (#w c, fs');
         exp (c, b'))
    | Mid.Join (j', ps', b', sc') =>
        (P.byte (#w c, 2);
         #stamp c j';
         P.list (fn (_, x_5) => (case x_5 of (x_6, x_7) => (#stamp c x_6; ty (c, x_7)))) (#w c, ps');
         exp (c, b');
         exp (c, sc'))
    | Mid.Jump (j', args') =>
        (P.byte (#w c, 3);
         #stamp c j';
         P.list (fn (_, x_8) => atom (c, x_8)) (#w c, args'))
    | Mid.If (a', t', f') => (P.byte (#w c, 4); atom (c, a'); exp (c, t'); exp (c, f'))
    | Mid.Handle (b', x', h') => (P.byte (#w c, 5); exp (c, b'); #stamp c x'; exp (c, h'))
    | Mid.Raise a' => (P.byte (#w c, 6); atom (c, a'))
    | Mid.Return r' => (P.byte (#w c, 7); rhs (c, r'))
    | Mid.Mark (pos', b') =>
        (P.byte (#w c, 8);
         (case pos' of (x_9, x_10) => (span (c, x_9); P.list (fn (_, x_11) => frame (c, x_11)) (#w c, x_10)));
         exp (c, b'))

  and fundef (c : wctx, v : Mid.fundef) : unit =
    case v of
      {name = name', tyvars = tyvars', params = params', result = result', body = body'} =>
        (#stamp c name';
         P.list (fn (_, x_1) => #tvar c x_1) (#w c, tyvars');
         P.list (fn (_, x_2) => (case x_2 of (x_3, x_4) => (#stamp c x_3; ty (c, x_4)))) (#w c, params');
         ty (c, result');
         exp (c, body'))

  and topfun (c : wctx, v : Mid.fundef) : unit =
    case v of
      {name = name', tyvars = tyvars', params = params', result = result', body = body'} =>
        (#global c name';
         P.list (fn (_, x_1) => #tvar c x_1) (#w c, tyvars');
         P.list (fn (_, x_2) => (case x_2 of (x_3, x_4) => (#stamp c x_3; ty (c, x_4)))) (#w c, params');
         ty (c, result');
         exp (c, body'))

  and def (c : wctx, v : Mid.def) : unit =
    case v of
      Mid.Val (g', s', e') =>
        (P.byte (#w c, 0);
         #stamp c g';
         (case s' of (x_1, x_2) => (P.list (fn (_, x_3) => #tvar c x_3) (#w c, x_1); ty (c, x_2)));
         exp (c, e'))
    | Mid.Funs fs' => (P.byte (#w c, 1); P.list (fn (_, x_4) => fundef (c, x_4)) (#w c, fs'))
    | Mid.Do (gs', e') =>
        (P.byte (#w c, 2);
         P.list (fn (_, x_5) => (case x_5 of (x_6, x_7) => (#stamp c x_6; (case x_7 of (x_8, x_9) => (P.list (fn (_, x_10) => #tvar c x_10) (#w c, x_8); ty (c, x_9)))))) (#w c, gs');
         exp (c, e'))

  and rconst (c : rctx) : Lambda.const =
    case P.rbyte (#r c) of
      0 => let val i' = bigint c in Lambda.CInt i' end
    | 1 => let val i' = bigint c in Lambda.CWord i' end
    | 2 => let val i' = bigint c in Lambda.CInt64 i' end
    | 3 => let val i' = bigint c in Lambda.CWord64 i' end
    | 4 => let val s' = P.rstring (#r c) in Lambda.CReal s' end
    | 5 => let val s' = P.rstring (#r c) in Lambda.CString s' end
    | 6 => let val n' = P.rnat (#r c) in Lambda.CChar n' end
    | _ => raise Bad "not a constant"

  and rty (c : rctx) : Ty.ty =
    case P.rbyte (#r c) of
      6 => (case IntTable.find (#read' c, P.rnat (#r c)) of SOME t => t | NONE => raise Bad "a value before it is written")
    | b =>
        let
          val t =
            case b of
              0 => let val i' = #tvar c () in Ty.gen i' end
            | 1 => let val i' = #tvar c () in Ty.var i' end
            | 2 => let val s' = #tycon c () val n' = P.rstring (#r c) val args' = P.rlist (fn _ => rty c) (#r c) in Ty.con (s', n', args') end
            | 3 => let val ts' = P.rlist (fn _ => rty c) (#r c) in Ty.tuple ts' end
            | 4 => let val a' = rty c val b' = rty c in Ty.arrow (a', b') end
            | 5 => Ty.exnCon
            | _ => raise Bad "not a type"
        in IntTable.insert (#read' c, !(#nread c), t); #nread c := !(#nread c) + 1; t end

  and rspan (c : rctx) : Source.span =
    let
      val file' = #file c ()
      val start' = P.rnat (#r c)
      val stop' = P.rnat (#r c)
    in {file = file', start = start', stop = stop'} end

  and rframe (c : rctx) : Mid.frame =
    let
      val name' = P.rstring (#r c)
      val site' = P.roption (fn _ => rspan c) (#r c)
    in {name = name', site = site'} end

  and ratom (c : rctx) : Mid.atom =
    case P.rbyte (#r c) of
      0 => let val x' = #stamp c () val ts' = P.rlist (fn _ => rty c) (#r c) in Mid.Var (x', ts') end
    | 1 => let val x' = #stamp c () val ts' = P.rlist (fn _ => rty c) (#r c) in Mid.Global (x', ts') end
    | 2 => let val c' = rconst c val t' = rty c in Mid.Const (c', t') end
    | 3 => let val tag' = P.rnat (#r c) val t' = rty c in Mid.Con0 (tag', t') end
    | 4 => Mid.Unit
    | _ => raise Bad "not an atom"

  and rrhs (c : rctx) : Mid.rhs =
    case P.rbyte (#r c) of
      0 => let val a' = ratom c in Mid.Atom a' end
    | 1 => let val f' = ratom c val args' = P.rlist (fn _ => ratom c) (#r c) in Mid.App (f', args') end
    | 2 =>
        let
          val n' = P.rstring (#r c)
          val t' = rty c
          val args' = P.rlist (fn _ => ratom c) (#r c)
        in Mid.Prim (n', t', args') end
    | 3 => let val args' = P.rlist (fn _ => ratom c) (#r c) in Mid.Tuple args' end
    | 4 => let val i' = P.rnat (#r c) val a' = ratom c in Mid.Select (i', a') end
    | 5 => let val tag' = P.rnat (#r c) val t' = rty c val a' = ratom c in Mid.Con (tag', t', a') end
    | 6 => let val tag' = P.rnat (#r c) val t' = rty c val a' = ratom c in Mid.Decon (tag', t', a') end
    | 7 => let val a' = ratom c in Mid.ConTag a' end
    | 8 => let val s' = P.rstring (#r c) in Mid.NewExn s' end
    | 9 => let val i' = P.rint (#r c) in Mid.BuiltinExn i' end
    | 10 => let val a' = ratom c val b' = ratom c in Mid.MkExn (a', b') end
    | 11 => let val a' = ratom c in Mid.ExnCon a' end
    | 12 => let val t' = rty c val a' = ratom c in Mid.ExnArg (t', a') end
    | 13 => let val g' = #stamp c () val a' = ratom c in Mid.SetGlobal (g', a') end
    | _ => raise Bad "not a step"

  and rexp (c : rctx) : Mid.exp =
    case P.rbyte (#r c) of
      0 =>
        let
          val x' = #stamp c ()
          val s' = let val x_1 = P.rlist (fn _ => #tvar c ()) (#r c) val x_2 = rty c in (x_1, x_2) end
          val r' = rrhs c
          val b' = rexp c
        in Mid.Let (x', s', r', b') end
    | 1 => let val fs' = P.rlist (fn _ => rfundef c) (#r c) val b' = rexp c in Mid.Fun (fs', b') end
    | 2 =>
        let
          val j' = #stamp c ()
          val ps' = P.rlist (fn _ => let val x_3 = #stamp c () val x_4 = rty c in (x_3, x_4) end) (#r c)
          val b' = rexp c
          val sc' = rexp c
        in Mid.Join (j', ps', b', sc') end
    | 3 => let val j' = #stamp c () val args' = P.rlist (fn _ => ratom c) (#r c) in Mid.Jump (j', args') end
    | 4 => let val a' = ratom c val t' = rexp c val f' = rexp c in Mid.If (a', t', f') end
    | 5 => let val b' = rexp c val x' = #stamp c () val h' = rexp c in Mid.Handle (b', x', h') end
    | 6 => let val a' = ratom c in Mid.Raise a' end
    | 7 => let val r' = rrhs c in Mid.Return r' end
    | 8 =>
        let
          val pos' = let val x_5 = rspan c val x_6 = P.rlist (fn _ => rframe c) (#r c) in (x_5, x_6) end
          val b' = rexp c
        in Mid.Mark (pos', b') end
    | _ => raise Bad "not an expression"

  and rfundef (c : rctx) : Mid.fundef =
    let
      val name' = #stamp c ()
      val tyvars' = P.rlist (fn _ => #tvar c ()) (#r c)
      val params' = P.rlist (fn _ => let val x_1 = #stamp c () val x_2 = rty c in (x_1, x_2) end) (#r c)
      val result' = rty c
      val body' = rexp c
    in {name = name', tyvars = tyvars', params = params', result = result', body = body'} end

  and rtopfun (c : rctx) : Mid.fundef =
    let
      val name' = #global c ()
      val tyvars' = P.rlist (fn _ => #tvar c ()) (#r c)
      val params' = P.rlist (fn _ => let val x_1 = #stamp c () val x_2 = rty c in (x_1, x_2) end) (#r c)
      val result' = rty c
      val body' = rexp c
    in {name = name', tyvars = tyvars', params = params', result = result', body = body'} end

  and rdef (c : rctx) : Mid.def =
    case P.rbyte (#r c) of
      0 =>
        let
          val g' = #stamp c ()
          val s' = let val x_1 = P.rlist (fn _ => #tvar c ()) (#r c) val x_2 = rty c in (x_1, x_2) end
          val e' = rexp c
        in Mid.Val (g', s', e') end
    | 1 => let val fs' = P.rlist (fn _ => rfundef c) (#r c) in Mid.Funs fs' end
    | 2 =>
        let
          val gs' = P.rlist (fn _ => let val x_3 = #stamp c () val x_4 = let val x_5 = P.rlist (fn _ => #tvar c ()) (#r c) val x_6 = rty c in (x_5, x_6) end in (x_3, x_4) end) (#r c)
          val e' = rexp c
        in Mid.Do (gs', e') end
    | _ => raise Bad "not a definition"

  and bindsExp (t : unit IntTable.table, v : Mid.exp) : unit =
    case v of
      Mid.Let (x', _, _, b') => (IntTable.insert (t, x', ()); bindsExp (t, b'))
    | Mid.Fun (fs', b') => (List.app (fn x_1 => bindsFundef (t, x_1)) fs'; bindsExp (t, b'))
    | Mid.Join (j', ps', b', sc') =>
        (IntTable.insert (t, j', ());
         List.app (fn x_2 => (case x_2 of (x_3, _) => IntTable.insert (t, x_3, ()))) ps';
         bindsExp (t, b');
         bindsExp (t, sc'))
    | Mid.Jump (_, _) => ()
    | Mid.If (_, t', f') => (bindsExp (t, t'); bindsExp (t, f'))
    | Mid.Handle (b', x', h') => (bindsExp (t, b'); IntTable.insert (t, x', ()); bindsExp (t, h'))
    | Mid.Raise _ => ()
    | Mid.Return _ => ()
    | Mid.Mark (_, b') => bindsExp (t, b')

  and bindsFundef (t : unit IntTable.table, v : Mid.fundef) : unit =
    case v of
      {name = name', tyvars = _, params = params', result = _, body = body'} =>
        (IntTable.insert (t, name', ());
         List.app (fn x_1 => (case x_1 of (x_2, _) => IntTable.insert (t, x_2, ()))) params';
         bindsExp (t, body'))

  and bindsTopfun (t : unit IntTable.table, v : Mid.fundef) : unit =
    case v of
      {name = _, tyvars = _, params = params', result = _, body = body'} =>
        (List.app (fn x_1 => (case x_1 of (x_2, _) => IntTable.insert (t, x_2, ()))) params';
         bindsExp (t, body'))
  (* ---- end of codecs of Mid ---- *)

  (* the names f binds *)
  fun binders (f : fundef) : unit IntTable.table =
    let val t : unit IntTable.table = IntTable.table 256 in bindsTopfun (t, f); t end

  fun write (w : P.writer, {stamp = global, tycon, tvar, file, position, funName} : namer) (f : fundef) : unit =
    let
      val own = binders f
      val locals : int IntTable.table = IntTable.table 256
      val nlocals = ref 0
      (* its own names, newest first, in the order met *)
      val met : int list ref = ref []
      fun stamp x =
        if isSome (IntTable.find (own, x)) then
          (P.byte (w, 0);
           P.nat (w, case IntTable.find (locals, x) of
                       SOME i => i
                     | NONE => let val i = !nlocals
                               in IntTable.insert (locals, x, i); nlocals := i + 1; met := x :: !met; i end))
        else (P.byte (w, 1); global x)
      val c : wctx = {w = w, stamp = stamp, global = global, tycon = tycon, tvar = tvar, file = file, position = position,
                      written = IntTable.table 256, nwritten = ref 0}
    in
      (* the function's name is the caller's (a global), its parameters its own *)
      topfun (c, f);
      (* the names of the functions it binds, by their first parameter, by
         its own numbers *)
      P.list (fn (_, (x, n)) => (stamp x; P.string (w, n)))
             (w, List.mapPartial (fn x => Option.map (fn n => (x, n)) (funName x)) (List.rev (!met)))
    end

  (* the function, its own names given by local' (from their numbers), and
     the names of the functions it binds *)
  fun read (r : P.reader, {stamp = global, tycon, tvar, file, local'} : unnamer) : fundef * (int * string) list =
    let
      fun stamp () = case P.rbyte r of 0 => local' (P.rnat r) | 1 => global () | _ => raise Bad "not a name"
      val c : rctx = {r = r, stamp = stamp, global = global, tycon = tycon, tvar = tvar, file = file,
                      read' = IntTable.table 256, nread = ref 0}
      val f = rtopfun c
      val names = P.rlist (fn _ => let val x = stamp () in (x, P.rstring r) end) r
    in (f, names) end
end
