(* bin/rune-codecs (make codecs, make check-codecs): the parts of the
   compiler's sources marked as generated, written from the description of
   the compiler's codecs (CodecCompiler), or checked against it; and the
   checks of the generator itself (--test, --toy).

     rune-codecs --root DIR          write the generated parts of DIR's sources
     rune-codecs --root DIR --check  fail where one is not what the description gives
     rune-codecs --test              a field added to a described type reaches every
                                     traversal, and a description that leaves a field
                                     unmarked is refused
     rune-codecs --toy DIR           a program whose type has a field its description
                                     has not (stale.sml), which must not compile, and
                                     one whose description has it (toy.sml), which
                                     must, and checks that every traversal reads it *)
structure CodecMain =
struct
  open Codec
  infix 1 |>

  exception Failed of string

  fun readFile (path : string) : string =
    let val s = TextIO.openIn path in TextIO.inputAll s before TextIO.closeIn s end
    handle IO.Io _ => raise Failed ("cannot read " ^ path)
  fun writeFile (path : string, text : string) : unit =
    let val s = TextIO.openOut path in TextIO.output (s, text); TextIO.closeOut s end
    handle IO.Io _ => raise Failed ("cannot write " ^ path)

  (* ---- a region in a file ---- *)

  fun beginMark (name : string) = "(* ---- generated by bin/rune-codecs from tools/codecs/compiler.sml (make codecs): " ^ name ^ " ---- *)"
  fun endMark (name : string) = "(* ---- end of " ^ name ^ " ---- *)"

  fun trimLeft (s : string) : string =
    let fun go i = if i < String.size s andalso Char.isSpace (String.sub (s, i)) then go (i + 1) else i
    in String.extract (s, go 0, NONE) end

  (* the file's text with the region's lines between its marks made text *)
  fun replace (file : string, contents : string, name : string, text : string) : string =
    let
      val lines = String.fields (fn c => c = #"\n") contents
      fun split (pred, ls) =
        let fun go (acc, []) = NONE
              | go (acc, l :: rest) = if pred l then SOME (List.rev acc, l, rest) else go (l :: acc, rest)
        in go ([], ls) end
    in
      case split (fn l => trimLeft l = beginMark name, lines) of
        NONE => raise Failed (file ^ ": no part marked as generated: " ^ name)
      | SOME (before', b, rest) =>
          (case split (fn l => trimLeft l = endMark name, rest) of
             NONE => raise Failed (file ^ ": the generated part " ^ name ^ " has no end")
           | SOME (_, e, after) => String.concatWith "\n" (before' @ [b] @ String.fields (fn c => c = #"\n") text @ [e] @ after))
    end

  (* each file's text, every region of it made what the description gives *)
  fun generated (d : description, root : string) : (string * string * string) list =
    let
      val files = List.foldl (fn (r : region, acc) => if List.exists (fn f => f = #file r) acc then acc else acc @ [#file r]) [] (#regions d)
      val () = CodecEmit.checkAll d
    in
      List.map (fn f =>
                  let
                    val path = OS.Path.concat (root, f)
                    val old = readFile path
                    val new = List.foldl (fn (r : region, text) => if #file r = f then replace (f, text, #name r, CodecEmit.region (d, r)) else text)
                                         old (#regions d)
                  in (path, old, new) end) files
    end

  fun write (root : string) : int =
    (List.app (fn (path, old, new) => if old = new then () else (writeFile (path, new); print ("wrote " ^ path ^ "\n")))
              (generated (CodecCompiler.description, root));
     0)

  fun check (root : string) : int =
    case List.filter (fn (_, old, new) => old <> new) (generated (CodecCompiler.description, root)) of
      [] => 0
    | stale => (List.app (fn (path, _, _) => print ("FAIL " ^ path ^ ": its generated parts are not what tools/codecs/compiler.sml gives (make codecs)\n")) stale;
                1)

  (* ---- the checks of the generator ---- *)

  val failures = ref 0
  fun fail (msg : string) = (failures := !failures + 1; print ("FAIL codecs: " ^ msg ^ "\n"))
  fun pass (msg : string) = print ("ok codecs: " ^ msg ^ "\n")

  (* the description with the type named tn changed by f *)
  fun changeType (d : description, tn : string, f : ty -> ty) : description =
    {types = List.map (fn (t : ty) => if #name t = tn then f t else t) (#types d), families = #families d,
     instances = #instances d, regions = #regions d}
  (* ... the part of it whose constructor is con *)
  fun changePart (d, tn, con, f : part -> part) =
    changeType (d, tn, withParts (List.map (fn (p : part) => if #con p = con then f p else p)))
  fun addField (fd : field) (p : part) : part = withFields (fn fs => fs @ [fd]) p
  fun addFp (item, out) ({con, build, shape, fields, fpTag, fp, fpOut, same, sameOut, writeAs, note} : part) : part =
    {con = con, build = build, shape = shape, fields = fields, fpTag = fpTag, fp = fp @ item, fpOut = fpOut @ out, same = same,
     sameOut = sameOut, writeAs = writeAs, note = note}
  fun addSame (item, out) ({con, build, shape, fields, fpTag, fp, fpOut, same, sameOut, writeAs, note} : part) : part =
    {con = con, build = build, shape = shape, fields = fields, fpTag = fpTag, fp = fp, fpOut = fpOut, same = same @ item,
     sameOut = sameOut @ out, writeAs = writeAs, note = note}

  (* every generated function, by name *)
  fun functions (d : description) : (string * string) list =
    List.concat (List.map (fn r => CodecEmit.regionFunctions (d, r)) (#regions d))

  fun contains (s : string, sub : string) = String.isSubstring sub s

  (* d' adds a field to d: the functions that change are exactly those
     expected, and each names the field's variable *)
  fun follows (label : string, d : description, d' : description, expected : string list, mentions : string) : unit =
    let
      val a = functions d
      val b = functions d'
      val changed = List.mapPartial (fn (n, t) => case List.find (fn (m, _) => m = n) a of
                                                    SOME (_, t0) => if t0 = t then NONE else SOME (n, t)
                                                  | NONE => SOME (n, t)) b
      val names = List.map #1 changed
      val missing = List.filter (fn e => not (List.exists (fn n => n = e) names)) expected
      val extra = List.filter (fn n => not (List.exists (fn e => e = n) expected)) names
      val silent = List.filter (fn (_, t) => not (contains (t, mentions))) changed
    in
      if null missing andalso null extra andalso null silent then
        pass (label ^ ": " ^ String.concatWith ", " names ^ " follow")
      else
        fail (label ^ ": changed " ^ String.concatWith ", " names ^ "; expected " ^ String.concatWith ", " expected
              ^ (if null silent then "" else "; not naming " ^ mentions ^ ": " ^ String.concatWith ", " (List.map #1 silent)))
    end

  (* d is refused, with a message that says what *)
  fun refused (label : string, d : description, says : string) : unit =
    (ignore (functions d); CodecEmit.checkAll d; fail (label ^ ": not refused"))
    handle Refused m => if contains (m, says) then pass (label ^ ": refused: " ^ m)
                        else fail (label ^ ": refused, but with " ^ m ^ ", not " ^ says)

  fun test () : int =
    let
      val d = CodecCompiler.description
      val () = (CodecEmit.checkAll d; ignore (functions d))
      val probe = field ("probe", Leaf "bool")
      (* a value's status gains a field the fingerprint and the sameness hold *)
      val () = follows ("Env.Val gains a field", d,
                        changePart (d, "valstatus", "Env.Val", addField probe o addFp ([FpField (Both, "probe")], []) o addSame ([SameField "probe"], [])),
                        ["valstatus", "rvalstatus", "sameVal", "fpVal", "perturbVal"], "probe")
      (* one in the ABI layer, in the full fingerprint alone, not compared *)
      val () = follows ("Env.Exn gains a field of the ABI layer", d,
                        changePart (d, "valstatus", "Env.Exn",
                                    addField (abi ("probe", Leaf "stamp")) o addFp ([FpField (Full, "probe")], [])
                                    o addSame ([], [("probe", "a test's")])),
                        ["valstatus", "rvalstatus", "sameVal", "fpVal", "perturbVal"], "probe")
      (* an environment gains a kind of binding *)
      val () = follows ("Env.Env gains a field", d,
                        changePart (d, "env", "Env.Env", addField (field ("probe", Map (Type "valstatus")))
                                                         o addFp ([FpField (Both, "probe")], []) o addSame ([SameField "probe"], [])),
                        ["envWhole", "renvWhole", "sameEnv", "fpEnvInto", "perturbEnv"], "probe")
      (* a constructor's information: the key of a shared one follows too *)
      val () = follows ("Ast.coninfo gains a field", d,
                        changePart (d, "coninfo", "", addField probe o addFp ([FpField (Both, "probe")], []) o addSame ([SameField "probe"], [])),
                        ["coninfo", "keyConinfo", "rconinfo", "sameConinfo", "fpConinfo", "perturbConinfo"], "probe")
      (* a step of Mid: both of its users, and the binders where it binds *)
      val () = follows ("Mid.Let gains a field", d,
                        changePart (d, "exp", "Mid.Let", addField (field ("probe", Leaf "binder"))),
                        ["exp", "rexp", "bindsExp"], "probe")
      val () = follows ("a unit's Mid gains a field", d,
                        changePart (d, "unitMid", "", addField (field ("probe", List (Leaf "stamp")))),
                        ["unitMid", "runitMid"], "probe")
      (* what is refused *)
      val () = refused ("a field in no fingerprint",
                        changePart (d, "valstatus", "Env.Val", addField probe o addSame ([SameField "probe"], [])),
                        "the field probe is in no fingerprint")
      val () = refused ("a field in no sameness",
                        changePart (d, "valstatus", "Env.Val", addField probe o addFp ([FpField (Both, "probe")], [])),
                        "the field probe is in no sameness")
      val () = refused ("a field left out with no reason",
                        changePart (d, "valstatus", "Env.Val", addField probe o addFp ([], [("probe", "")]) o addSame ([SameField "probe"], [])),
                        "with no reason")
      val () = refused ("a field both in and out",
                        changePart (d, "valstatus", "Env.Val", addField probe o addFp ([FpField (Both, "probe")], [("probe", "why")])
                                                                o addSame ([SameField "probe"], [])),
                        "both in its fingerprint and left out")
      val () = refused ("a type written to the ABI layer",
                        changePart (d, "valstatus", "Env.Val", addField (abi ("probe", Leaf "ty")) o addFp ([FpField (Both, "probe")], [])
                                                                o addSame ([SameField "probe"], [])),
                        "not written to the ABI layer")
      val () = refused ("an origin outside the sidecar",
                        changePart (d, "env", "Env.Env", addField (field ("probe", Leaf "origin")) o addFp ([], [("probe", "why")])
                                                         o addSame ([SameField "probe"], [])),
                        "not written to the static layer")
      val () = refused ("a field of no part",
                        changePart (d, "valstatus", "Env.Val", addFp ([FpText (Both, "P.bool (w, {nothing})")], [])),
                        "has no field nothing")
    in
      if !failures = 0 then (print "PASS codecs: the generator's checks\n"; 0) else 1
    end

  (* ---- a toy: a type with a field its description has not ---- *)

  fun toy (dir : string) : int =
    let
      val () = (OS.FileSys.mkDir dir handle OS.SysErr _ => ())
      val pickled = fn (w, r) => {write = "P." ^ w ^ " ({w}, {x})", read = "P." ^ r ^ " ({r})", same = "{x} = {y}",
                                  fp = "P." ^ w ^ " (w, {x})", key = "", layers = [Static, Abi], default = "",
                                  other = "", static = true}
      val fam : family =
        {name = "toy", wparam = "e : enc", warg = "e", wstream = fn Abi => "#a e" | _ => "#w e",
         rparam = "d : dec", rarg = "d", rstream = fn Abi => "#a d" | _ => "#r d",
         fpparam = "w : P.writer, local' : int", fparg = "w, local'", static = "!staticLayer", side = "NONE",
         once = "", ronce = "", bad = "P.Bad", binder = NONE,
         leaves = [("int", pickled ("int", "rint")), ("bool", pickled ("bool", "rbool")), ("string", pickled ("string", "rstring"))],
         notes = []}
      fun t parts = sum ("t", "t", parts)
      val b = args ("B", [field ("n", Leaf "int")]) |> fingerprint (SOME 2, [FpField (Both, "n")], []) |> sameness ([SameField "n"], [])
      val a2 = [field ("x", Leaf "int"), abi ("y", Leaf "bool")]
      val a = record ("A", a2) |> fingerprint (SOME 1, [FpField (Both, "x"), FpField (Full, "y")], []) |> sameness ([SameField "x"], [("y", "a toy's")])
      val a3 = a |> addField (field ("z", Leaf "string")) |> addFp ([FpField (Both, "z")], []) |> addSame ([SameField "z"], [])
      fun desc parts : description =
        {types = [t parts], families = [fam],
         instances = [{family = "toy", ty = "t", names = [(Write, "write"), (Read, "read"), (Same, "same"), (Fp, "fp")], share = NONE, bad = "not a t"}],
         regions = [{file = "toy", name = "toy", start = "fun", items = [("toy", "t", Write), ("toy", "t", Read), ("toy", "t", Same), ("toy", "t", Fp)]}]}
      fun program (parts) =
        "(* written by bin/rune-codecs --toy (make check-codecs) *)\n"
        ^ "structure P =\nstruct\n  exception Bad of string\n  type writer = string list ref\n  type reader = {s : string, pos : int ref}\n"
        ^ "  fun writer () : writer = ref []\n  fun contents (w : writer) = String.concat (List.rev (!w))\n"
        ^ "  fun byte (w : writer, n) = w := String.str (Char.chr n) :: !w\n"
        ^ "  fun nat (w, n) = if n < 128 then byte (w, n) else (byte (w, 128 + n mod 128); nat (w, n div 128))\n"
        ^ "  fun int (w, n) = nat (w, if n >= 0 then 2 * n else ~2 * n - 1)\n"
        ^ "  fun bool (w, b) = byte (w, if b then 1 else 0)\n  fun string (w : writer, s) = (nat (w, size s); w := s :: !w)\n"
        ^ "  fun reader s : reader = {s = s, pos = ref 0}\n"
        ^ "  fun rbyte ({s, pos} : reader) = if !pos >= size s then raise Bad \"cut short\" else Char.ord (String.sub (s, !pos)) before pos := !pos + 1\n"
        ^ "  fun rnat r = let val b = rbyte r in if b < 128 then b else (b - 128) + 128 * rnat r end\n"
        ^ "  fun rint r = let val n = rnat r in if n mod 2 = 0 then n div 2 else ~(n div 2) - 1 end\n"
        ^ "  fun rbool r = rbyte r = 1\n"
        ^ "  fun rstring (r as {s, pos} : reader) = let val n = rnat r in String.substring (s, !pos, n) before pos := !pos + n end\nend\n\n"
        ^ "structure Toy =\nstruct\n"
        ^ "  datatype t = A of {x : int, y : bool, z : string} | B of int\n"
        ^ "  type enc = {w : P.writer, a : P.writer}\n  type dec = {r : P.reader, a : P.reader}\n"
        ^ "  val staticLayer = ref false\n\n"
        ^ CodecEmit.region (desc parts, hd (#regions (desc parts))) ^ "\n\n"
        ^ "  fun bytes v = let val e = {w = P.writer (), a = P.writer ()} in write (e, v); (P.contents (#w e), P.contents (#a e)) end\n"
        ^ "  fun back (s, a) = read {r = P.reader s, a = P.reader a}\n"
        ^ "  fun print' (f, static) = let val w = P.writer () in staticLayer := static; f w; staticLayer := false; P.contents w end\n"
        ^ "  fun fpOf (v, static) = print' (fn w => fp (w, 0, v), static)\n"
        ^ "  fun check (what, ok) = if ok then () else (print (\"FAIL toy: \" ^ what ^ \"\\n\"); OS.Process.exit OS.Process.failure)\n"
        ^ "  val v1 = A {x = 1, y = true, z = \"one\"}\n  val v2 = A {x = 1, y = true, z = \"two\"}\n"
        ^ "  val () = check (\"the writer and the reader keep z\", back (bytes v1) = v1 andalso back (bytes v2) = v2)\n"
        ^ "  val () = check (\"the bytes hold z\", bytes v1 <> bytes v2)\n"
        ^ "  val () = check (\"the fingerprint holds z\", fpOf (v1, false) <> fpOf (v2, false) andalso fpOf (v1, true) <> fpOf (v2, true))\n"
        ^ "  val () = check (\"the static fingerprint leaves y out\", fpOf (v1, true) = fpOf (A {x = 1, y = false, z = \"one\"}, true))\n"
        ^ "  val () = check (\"the sameness compares z\", same (v1, v1) andalso not (same (v1, v2)))\n"
        ^ "  val () = print \"PASS toy: writer, reader, sameness and fingerprint follow the field z\\n\"\nend\n"
    in
      writeFile (OS.Path.concat (dir, "stale.sml"), program [a, b]);
      writeFile (OS.Path.concat (dir, "toy.sml"), program [a3, b]);
      0
    end

  fun main (args : string list) : int =
    case args of
      ["--root", root] => write root
    | ["--root", root, "--check"] => check root
    | ["--check", "--root", root] => check root
    | ["--test"] => test ()
    | ["--toy", dir] => toy dir
    | ["--print"] => (List.app (fn r => print ("==== " ^ #file r ^ ": " ^ #name r ^ "\n" ^ CodecEmit.region (CodecCompiler.description, r) ^ "\n"))
                               (#regions CodecCompiler.description); 0)
    | _ => raise Failed "usage: rune-codecs --root DIR [--check] | --test | --toy DIR"
end

val () =
  let val status = CodecMain.main (CommandLine.arguments ())
  in if status = 0 then () else OS.Process.exit OS.Process.failure end
  handle CodecMain.Failed m => (print ("rune-codecs: " ^ m ^ "\n"); OS.Process.exit OS.Process.failure)
       | Codec.Refused m => (print ("rune-codecs: the description is refused: " ^ m ^ "\n"); OS.Process.exit OS.Process.failure)
