  val schemas = [
    ("mut","sim-mutable.md","A mutable space scanned at every minor (Poly/ML) vs a barrier",[("config",SOME "config"),("minors",SOME "minors"),("remset total",SOME "remset_total"),("cards total",SOME "cards_total"),("mutable space MB (allocated)",SOME "mut_bytes"),("scanned per run MB",SOME "mut_scan_total"),("max scan MB",SOME "mut_scan_max"),("stores into it",SOME "mut_stores"),("peak committed MB",SOME "peak_committed"),("GC ms (model)",NONE)]),
