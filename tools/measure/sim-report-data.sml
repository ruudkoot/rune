    ("order","sim-order.md","Placement order: promotion order vs shuffles within each minor",[("config",SOME "config"),("majors",SOME "majors"),("peak committed MB",SOME "peak_committed"),("mean committed MB",SOME "mean_committed"),("frag int %",SOME "frag_int_mean"),("frag ext %",SOME "frag_ext_mean")]),
    ("bits32","sim-footprint.md","Footprint: committed, reserved, metadata; the 32-bit sensitivity rows",[("config",SOME "config"),("size",SOME "size"),("ptr",SOME "ptr_bytes"),("limit",SOME "limit_x"),("bytes MB",SOME "bytes"),("max live MB",SOME "max_live"),("majors",SOME "majors"),("peak committed MB",SOME "peak_committed"),("peak reserved MB",SOME "peak_reserved"),("peak metadata KB",SOME "peak_metadata"),("mean committed MB",SOME "mean_committed"),("final committed MB",SOME "final_committed")])
  ]
