structure GenerateHostBasis =
struct
  open MeasureCommon
  structure T=GenerateText
  fun rewrite swap text =T.lineMap (fn line =>
    let val line=if swap andalso line="exception Unordered" then "exception Unordered = IEEEReal.Unordered"
          else if swap andalso (String.isPrefix "datatype " line orelse String.isPrefix "exception " line) then "" else line
        (* Host default ints may have only 31/32 bits. Rune's original
           construction deliberately uses its wider default int. *)
        val line=T.replace line "IntInf.fromInt 4294967296" "IntInf.<< (IntInf.fromInt 1, 0w32)"
        val line=T.substitute "_prim \"[a-z_0-9]*\"" (fn call => "RunePrim." ^ List.nth (fields #"\"" call,1)) line
    in if String.isPrefix "_overload " line then "" else if String.isPrefix "structure Position :> " line then "structure Position : " ^ String.extract (line,22,NONE)
       else if String.isPrefix "structure SysWord :> " line then "structure SysWord : " ^ String.extract (line,21,NONE) else line end) text
  fun signatureText () =
    let fun row line =
          let val words=String.tokens Char.isSpace line val name=hd words
              fun dropWord text=Substring.string (Substring.dropl Char.isSpace (Substring.dropl (not o Char.isSpace) (Substring.full text)))
              val tail=dropWord (dropWord line)
              val stop=List.find (fn i => String.sub (tail,i) = #"\t" orelse (i+1<size tail andalso String.substring (tail,i,2)="  ")) (List.tabulate (size tail,fn i => i))
              val ty=case stop of NONE => tail | SOME i => String.substring (tail,0,i)
          in if List.exists (fn n => n=name) ["poly_eq","imm_eq","ptr_eq"] then "" else "  val " ^ name ^ " : " ^ T.replace ty "Int64.int" "int64" ^ "\n" end
    in "(* Generated by tests/basis/host/gen-host-basis.sh from runtime/prims.def -- do not edit. *)\nsignature RUNE_PRIM =\nsig\n  eqtype int64\n  type word64 = Word64.word\n  eqtype bytearray\n  eqtype realarray\n" ^ String.concat (List.map row (T.dataLines (fromRoot "runtime/prims.def"))) ^ "end\n" end
  val hidden=String.tokens Char.isSpace "app ceil chr exnMessage exnName explode floor foldl foldr getOpt hd ignore implode isSome length map not null ord print real rev round str tl trunc valOf vector"
  fun main [out] =
    let val out=OS.Path.mkAbsolute {path=out,relativeTo=OS.FileSys.getDir ()} val ()=mkdirs (out ^ "/basis")
        val ()=T.atomic (out ^ "/RUNE_PRIM.sml") (signatureText ())
        val ()=T.atomic (out ^ "/hide.sml") ("(* Generated by tests/basis/host/gen-host-basis.sh -- do not edit. *)\ndatatype not_in_lib_basis = NotInLibBasis\n" ^ String.concat (List.map (fn name => "val " ^ name ^ " = NotInLibBasis\n") (hidden @ ["op @","op o","op before"])))
        val ()=copy (fromRoot "tests/basis/host/rune-prim.sml") (out ^ "/rune-prim.sml")
        val ()=T.atomic (out ^ "/prelude") (String.concat (List.map (fn f => out ^ "/" ^ f ^ "\n") ["RUNE_PRIM.sml","rune-prim.sml","hide.sml"]))
        fun one line =case List.map trim (fields #"|" line) of file::_::host::_ =>
          if host="no" then NONE else
            let val source=read (fromRoot ("lib/basis/" ^ file)) val target=out ^ "/basis/" ^ file
                val ()=T.atomic target (rewrite (host="swap") source)
                val structures=List.mapPartial (fn line => if String.isPrefix "structure " line then
                        let val rest=String.extract (line,10,NONE) val name=Substring.string (Substring.takel (fn c => Char.isAlphaNum c orelse c = #"_") (Substring.full rest))
                        in SOME name end else NONE) (lines source)
            in SOME (target ^ "\t" ^ String.concatWith " " structures ^ "\n") end
          | _ => raise Failed "invalid Basis manifest row"
        val listing=List.mapPartial one (T.dataLines (fromRoot "lib/basis/MANIFEST"))
    in T.atomic (out ^ "/files") (String.concat listing);0 end
    | main _=raise Usage "host-basis OUTDIR"
end
