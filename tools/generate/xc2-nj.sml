structure GenerateXC2NJ =
struct
  open MeasureCommon
  structure T=GenerateText structure X=GenerateXC2
  fun main port args =
    let val (out,sml)=case args of [out,sml] => (X.output out,fromRoot sml) | _ => raise Usage "xc2-smlnj-legacy|xc2-smlnj-dev OUTDIR SMLNJ"
        val here=fromRoot ("tests/basis/xc2/" ^ port) val base=fromRoot "tests/basis/xc2/smlnj-legacy" val xc2=fromRoot "tests/basis/xc2"
        fun pick name=if exists (here ^ "/" ^ name) then here ^ "/" ^ name else base ^ "/" ^ name
        val ()=need (exists (sml ^ "/system/Basis/basis.cm"),"no sources in " ^ sml ^ "/system")
        val ()=(rmTree (out ^ "/cm");mkdirs (out ^ "/cm"))
        val ()=copyTree (sml ^ "/system/Basis") (out ^ "/cm/Basis") val ()=copyTree (sml ^ "/system/smlnj") (out ^ "/cm/smlnj")
        val observed=child {args=[sml ^ "/bin/sml",pick "order.sml"],directory=root,input="",prefix=out ^ "/cm-observation",timeout=300,environment=setEnv ("XC2_CM",out ^ "/cm/Basis/basis-common.cm")}
        val log= #output observed ^ #errors observed val ()=X.writeFile out "cm.log" log
        val cm=List.map (fn line => String.extract (line,5,NONE)) (List.filter (String.isPrefix "FILE ") (lines log))
        val ()=need (not (null cm),"CM gave no order (see " ^ out ^ "/cm.log)") val ()=X.listFile out "order.cm" cm
        val ordered=List.concat (List.map (fn prefix => List.filter (String.isPrefix prefix) cm) ["TypesOnly/","Implementation/","Exports/"]) val ()=X.listFile out "order" ordered
        val system=case env ("XC2_SMLNJ_BASIS","") of path => if path<>"" then fromRoot path else
              let val target=out ^ "/system" val ()=(rmTree target;mkdirs (target ^ "/smlnj"))
                  val ()=copyTree (sml ^ "/system/Basis") (target ^ "/Basis") val ()=copyTree (sml ^ "/system/smlnj/init") (target ^ "/smlnj/init")
                  val ()=X.writable target val _=successful (child {args=["patch","-s","-p1","-i",here ^ "/basis.patch"],directory=target,input="",prefix=out ^ "/patch",timeout=180,environment=fn e => e})
              in target end
        val ()=(rmTree (out ^ "/src");mkdirs (out ^ "/src")) val table=out ^ "/table" val ()=write (table,"") val count=ref 0 val files=ref [] : string list ref
        fun emit file =
          let val ()=count:= !count+1 val dst=out ^ "/src/" ^ StringCvt.padLeft #"0" 4 (Int.toString (!count)) ^ "-" ^ OS.Path.file file
          in T.atomic dst (GenerateRewriteNJ.main (X.setting (SOME table) [] [] [] []) file);files:= !files @ [dst] end
        val init=system ^ "/smlnj/init"
        val ()=List.app emit [init ^ "/assembly.sig",pick "rts.sml",init ^ "/order.sml",pick "core.sml",init ^ "/xcore.sml",pick "inline.sml"]
        val ()=if exists (here ^ "/more-inline.sml") then emit (here ^ "/more-inline.sml") else ()
        val first=length (!files)
        val ()=List.app (fn name => emit (init ^ "/" ^ name)) ["pre-perv.sml","pre-string.sml","substring.sig","substring.sml","print-hook.sml","use-hook.sml","exn-info-hook.sml","init-utils.sml","pervasive.sml"]
        val file=List.nth (!files,first) val ()=T.atomic file ("nonfix * / div mod + - ^ @ <> > >= < <= := o before\n" ^ read file)
        val ()=List.app (fn name => emit (system ^ "/Basis/" ^ name)) ordered
        val rows=sort (T.distinct (lines (read table))) val ()=X.listFile out "table" rows val ()=X.listFile out "files" (!files)
        val ids=ref [] : string list ref
        val values=List.mapPartial (fn line => case tabs line of [id,lib,name] => if List.exists (fn old => old=id) (!ids) then NONE else
                  (ids:=id:: !ids;SOME ("  val " ^ id ^ " = fn _ => XC2.unimplemented \"c_function " ^ lib ^ " " ^ name ^ "\"\n")) | _ => raise Failed "invalid SML/NJ primitive row") rows
        val ()=X.writeFile out "stubs.sml" ("(* Generated by tests/basis/xc2/" ^ port ^ "/gen.sh -- do not edit. *)\nstructure XC2NC =\nstruct\n" ^ String.concat values ^ "  open XC2NCImpl\nend\n")
        val ()=copy (xc2 ^ "/xc2.sml") (out ^ "/xc2.sml") val ()=List.app (fn name => copy (pick name) (out ^ "/" ^ name)) ["prologue.sml","cfuns.sml"]
        val prefix=List.map (fn name => out ^ "/" ^ name) ["xc2.sml","prologue.sml","cfuns.sml","stubs.sml"]
        val ()=X.listFile out "prefix" (prefix @ !files) val ()=X.writeFile out "flags" "--or-patterns\n"
        val extra=List.filter (fn file => List.exists (fn suffix => String.isSuffix suffix file) ["-rts.sml","-core.sml","-inline.sml"]) (!files)
    in X.trim out (prefix @ extra);0 end
end
