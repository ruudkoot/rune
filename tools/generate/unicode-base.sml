(* Pinned Unicode source input and deterministic range/string encodings. *)
structure GenerateUnicodeBase =
struct
  open MeasureCommon
  structure T=GenerateText
  val top=0x110000
  type range=int*int*int
  fun config ()=readJson (fromRoot "tools/generate/data/unicode-config.json")
  fun hex text=case StringCvt.scanString (Int.scan StringCvt.HEX) (trim text) of SOME n => n | _ => raise Failed ("invalid Unicode code point " ^ text)
  fun hx n=Int.fmt StringCvt.HEX n
  fun load path =
    let val stream=TextIO.openIn path
        fun loop acc=case TextIO.inputLine stream of NONE => List.rev acc | SOME line =>
          let val line=trim (hd (fields #"#" line)) in if line="" then loop acc else loop (line::acc) end
    in loop [] before TextIO.closeIn stream end
  fun records path=List.map (fn line => case List.map trim (fields #";" line) of code::rest =>
        let val (a,b)=case T.splitAt ".." code of NONE => (hex code,hex code) | SOME (a,b) => (hex a,hex b)
        in (a,b,rest) end | _ => raise Failed "invalid Unicode record") (load path)
  fun rangeEach lo hi f=let fun loop i=if i>hi then () else (f i;loop (i+1)) in loop lo end
  fun merge ranges =
    let val ranges=sorted (fn ((a,b,v),(c,d,w)) => a<c orelse (a=c andalso (b<d orelse (b=d andalso v<w)))) ranges
        fun loop [] acc=List.rev acc | loop ((a,b,v)::rest) []=loop rest [(a,b,v)]
          | loop ((a,b,v)::rest) ((c,d,w)::acc)=if v=w andalso d+1>=a then loop rest ((c,Int.max (d,b),w)::acc) else loop rest ((a,b,v)::(c,d,w)::acc)
    in loop ranges [] end
  fun subtract ranges holes =
    let fun remove (lo,hi) (a,b)=if hi<a orelse lo>b then [(a,b)] else (if a<lo then [(a,lo-1)] else []) @ (if hi<b then [(hi+1,b)] else [])
    in List.concat (List.map (fn (lo,hi,v) => List.map (fn (a,b) => (a,b,v)) (List.foldl (fn (hole,pieces) => List.concat (List.map (remove hole) pieces)) [(lo,hi)] holes)) ranges) end
  fun runs value limit =
    if limit=0 then [] else
    let fun loop i start previous acc =if i=limit then List.rev ((start,i-1,previous)::acc) else
          let val v=value i in if v=previous then loop (i+1) start previous acc else loop (i+1) i v ((start,i-1,previous)::acc) end
    in loop 1 0 (value 0) [] end
  fun spans value=List.filter (fn (_,_,v) => v=1) (runs (fn c => if value c then 1 else 0) top)
  fun triples rows=List.concat (List.map (fn (a,b,v) => [a,b,v]) rows)
  fun pairs rows=List.concat (List.map (fn (a,b,_) => [a,b]) rows)
  fun deltaRanges rows =
    let fun loop [] _ acc=List.rev acc | loop ((lo,hi,v)::rest) next acc=
             (need (lo>=next andalso hi>=lo,"overlapping generated Unicode ranges");loop rest (hi+1) (v::(hi-lo)::(lo-next)::acc))
    in loop rows 0 [] end
  fun chunks text =if text="" then [""] else
    let fun loop i acc=if i>=size text then List.rev acc else loop (i+72) (String.substring (text,i,Int.min (72,size text-i))::acc)
    in loop 0 [] end
  fun stringLines text =
    let val parts=chunks text val n=length parts
    in ListPair.map (fn (part,i) => "    " ^ (if i=0 then "\"" else "\\") ^ part ^ (if i=n-1 then "\"" else "\\")) (parts,List.tabulate (n,fn i => i)) end
  fun base32 n=let fun more 0 acc=acc | more n acc=more (n div 32) (str (Char.chr (93+n mod 32)) ^ acc)
                in need (n>=0,"negative Unicode table number");more (n div 32) (str (Char.chr (48+n mod 32))) end
  fun numberTable name ints doc build =
    let val ls=["  (* " ^ doc ^ " *)","  val " ^ name ^ " : unit -> int vector = once (" ^ build] @ stringLines (String.concat (List.map base32 ints))
    in String.concatWith "\n" (List.take (ls,length ls-1) @ [List.last ls ^ ")"]) end
  fun stringTable name text doc=String.concatWith "\n" (["  (* " ^ doc ^ " *)","  val " ^ name ^ " ="] @ stringLines text)
  fun vector name ints doc =
    let val digits=String.concat (List.map (StringCvt.padLeft #"0" 6 o hx) ints)
        val ls=["  (* " ^ doc ^ " *)","  val " ^ name ^ " : unit -> int vector = once (decode"] @ stringLines digits
    in String.concatWith "\n" (List.take (ls,length ls-1) @ [List.last ls ^ ")"]) end
  fun header cfg compact what files =
    let val sums=String.concatWith "\n" (List.map (fn name => "     " ^ String.substring (text (List.nth (array (field name (field "FILES" cfg)),1)),0,16) ^ " " ^ name) files)
        val intro="(* Generated by scripts/gen-unicode-tables.py from the Unicode Character\n   Database " ^ text (field "VERSION" cfg) ^ "; do not edit.\n\n   " ^ what ^ "\n\n"
        val format=if compact then "   A table is a string of numbers in base 32, built at its first\n   use. Made from (sha256, first 16 digits):\n\n" else
             "   The ranges are pairs, or triples with a value, in increasing order\n   of code point, for a binary search, each number written as six\n   hexadecimal digits of a string; a table is built at its first use.\n   Made from (sha256, first 16 digits):\n\n"
    in intro ^ format ^ sums ^ "\n\n   Area: Unicode *)" end
  fun source cfg directory name=directory ^ "/" ^ name
  fun fetch cfg directory =
    let val ()=mkdirs directory
        fun one (name,value)=case array value of [path,digest] =>
          let val file=directory ^ "/" ^ name val digest=text digest
          in if exists file then need (hash file=digest,"Unicode input checksum differs: " ^ file) else
             let val reservation=OS.FileSys.tmpName ()
                 val pending=file ^ "." ^ OS.Path.file reservation ^ ".pending"
                 val url="https://www.unicode.org/Public/" ^ text (field "VERSION" cfg) ^ "/" ^ text path
                 val result=execute root (pending ^ ".fetch") ["curl","--fail","--location","--connect-timeout","10","--max-time","45","--retry","1","--output",pending,url]
                 val ()=if #status result=0 andalso exists pending andalso hash pending=digest then () else (rmTree pending;rmTree reservation;raise Failed ("Unicode input fetch/checksum failed: " ^ name))
             in OS.FileSys.rename {old=pending,new=file};rmTree reservation end end | _ => raise Failed "invalid Unicode source lock"
    in List.app one (object (field "FILES" cfg)) end
  fun beginModule cfg name=["structure " ^ name ^ " =","struct","  val version = \"" ^ text (field "VERSION" cfg) ^ "\"",""]
end
