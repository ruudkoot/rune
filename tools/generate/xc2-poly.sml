structure GenerateXC2Poly =
struct
  open MeasureCommon
  structure T=GenerateText structure X=GenerateXC2
  val omitted=String.tokens Char.isSpace "Int31.sml IntAsLargeInt.sml Word32.sml Word32InLargeWord64.sml PackReal32Boxed.sml Windows.sml ExnPrinter.sml ForeignConstants.sml ForeignMemory.sml Foreign.sml Weak.sml Signal.sml SingleAssignment.sml HashArray.ML UniversalArray.ML PrettyPrinter.sml ASN1.sml Statistics.ML InitialPolyML.ML FinalPolyML.sml TopLevelPolyML.sml"
  fun order source =
    let val seen=ref [] : string list ref
        val expression=TerminalPattern.compile false "\"basis/[A-Za-z0-9_.]+\""
        fun line line=if T.matches "^structure [A-Za-z]+ = struct .* end;" line then ["@decl " ^ line] else
          let fun loop start acc=case TerminalPattern.find expression line start of NONE => List.rev acc | SOME (a,b) =>
                let val name=String.substring (line,a+7,b-a-8)
                in if List.exists (fn old => old=name) (omitted @ !seen) then loop b acc else (seen:=name:: !seen;loop b (name::acc)) end
          in loop 0 [] end
    in List.concat (List.map line (lines source)) end
  fun orderCLI [file]=(List.app (fn line => say (line ^ "\n")) (order (T.required file));0)
    | orderCLI _=raise Usage "polyml-order basis/build.sml"
  fun main args =
    let val (out,poly)=case args of [out,poly] => (X.output out,fromRoot poly) | _ => raise Usage "xc2-polyml OUTDIR POLYML"
        val here=fromRoot "tests/basis/xc2/polyml" val xc2=fromRoot "tests/basis/xc2"
        val ()=need (exists (poly ^ "/basis/build.sml"),"no sources in " ^ poly ^ "/basis")
        val basis=case env ("XC2_POLYML_BASIS","") of "" => X.patched out (poly ^ "/basis") (out ^ "/basis") (here ^ "/basis.patch") | path => fromRoot path
        val ordered=order (T.required (poly ^ "/basis/build.sml")) val ()=X.listFile out "order" ordered
        val ()=(rmTree (out ^ "/src");mkdirs (out ^ "/src")) val table=out ^ "/table" val ()=write (table,"")
        val count=ref 0 val files=ref [] : string list ref
        fun emit file =
          let val ()=count:= !count+1 val name=OS.Path.file file
              val name=if String.isSuffix ".ML" name orelse String.isSuffix ".sig" name then OS.Path.base name ^ ".sml" else name
              val dst=out ^ "/src/" ^ StringCvt.padLeft #"0" 4 (Int.toString (!count)) ^ "-" ^ name
              val content=GenerateRewritePoly.main (X.setting (SOME table) [] [] [] []) file
          in T.atomic dst content;files:= !files @ [dst] end
        val ()=List.app (fn name => if String.isPrefix "@decl " name then
              let val file=out ^ "/decl" ^ Int.toString (!count) ^ ".sml" val ()=T.atomic file (String.extract (name,6,NONE) ^ "\n") in emit file end else emit (basis ^ "/" ^ name)) ordered
        val rows=sort (T.distinct (lines (read table))) val ()=X.listFile out "table" rows val ()=X.listFile out "files" (!files)
        val ()=X.writeFile out "stubs.sml" ("(* Generated by tests/basis/xc2/polyml/gen.sh -- do not edit. *)\nstructure XC2PR =\nstruct\n" ^ String.concat (List.map (fn name => "  val " ^ name ^ " = fn _ => XC2.unimplemented \"the runtime's " ^ name ^ "\"\n") rows) ^ "  open XC2PRImpl\nend\n")
        val ()=X.writeFile out "open.sml" "open XC2PolyBuiltin\n" val ()=copy (xc2 ^ "/xc2.sml") (out ^ "/xc2.sml")
        val ()=X.copies out here ["mem.sml","prologue.sml","rts.sml"]
        val prefix=List.map (fn name => out ^ "/" ^ name) ["xc2.sml","mem.sml","prologue.sml","rts.sml","stubs.sml","open.sml"]
        val ()=X.listFile out "prefix" (prefix @ !files) val ()=X.writeFile out "flags" ""
        val ()=X.trim out (List.take (prefix,5)) val lib=out ^ "/lib/basis"
        val ()=List.app rmTree [lib ^ "/int64.sml",lib ^ "/seal_int64.sml"]
        val manifest=String.concat (List.map (fn line => line ^ "\n") (List.filter (fn line => not (String.isPrefix "int64.sml " line orelse String.isPrefix "seal_int64.sml " line)) (lines (read (lib ^ "/MANIFEST")))))
        val ()=T.atomic (lib ^ "/MANIFEST") (T.replace manifest " Real64 " " ")
        val ()=List.app (fn (file,remove) => T.atomic (lib ^ "/" ^ file) (T.filterLines (fn line => line<>remove) (read (lib ^ "/" ^ file)))) [("real.sml","structure Real64 = Real"),("seal_real.sml","structure Real64 : REAL = Real64")]
    in 0 end
end
