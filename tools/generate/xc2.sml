(* Host library preparation. Patches and compiler probes are external tools;
   source selection, rewriting, primitive tables and stubs are Standard ML. *)
structure GenerateXC2 =
struct
  open MeasureCommon
  structure T=GenerateText
  fun setting table typed consts ctypes ambiguous={table=table,typed=typed,consts=consts,ctypes=ctypes,ambiguous=ambiguous}:GenerateRewrites.settings
  val hosts=env ("RUNE_HOSTS",env ("HOME","") ^ "/.local/rune-hosts")
  fun output path=let val path=OS.Path.mkAbsolute {path=path,relativeTo=OS.FileSys.getDir ()} in mkdirs path;path end
  fun writeFile out name text=T.atomic (out ^ "/" ^ name) text
  fun listFile out name files=writeFile out name (String.concat (List.map (fn file => file ^ "\n") files))
  fun writable path =
    if OS.FileSys.isLink path then () else
      (Posix.FileSys.chmod (path,Posix.FileSys.S.flags [Posix.FileSys.ST.mode (Posix.FileSys.stat path),Posix.FileSys.S.iwusr]);
       if isDir path then List.app (fn name => writable (path ^ "/" ^ name)) (entries path) else ())
  fun patched out source target patchFile =
    (rmTree target;copyTree source target;writable target;
     ignore (successful (child {args=["patch","-s","-p1","-i",patchFile],directory=if String.isSuffix "/polyml/basis.patch" patchFile then out else target,input="",prefix=out ^ "/patch",timeout=180,environment=fn e => e}));target)
  fun copies out directory names=List.app (fn name => copy (directory ^ "/" ^ name) (out ^ "/" ^ name)) names
  fun trim out files=ignore (GenerateFlatten.trimLib (out::files))
  fun constants path =List.mapPartial (fn line => if T.matches "^const::[A-Za-z0-9_]+ = " line then
        case T.splitAt " = " line of SOME (name,value) => SOME (T.prefix "const::" name,value) | _ => NONE else NONE) (lines (T.required path)) @
        [("MLton_Align_align","8"),("MLton_Codegen_codegen","0"),("MLton_FFI_numExports","0"),("MLton_Platform_Format","executable"),("MLton_Profile_isOn","false")]
  fun cTypes path =
    let val known=ref [] : (string*string) list ref val aliases=ref [] : (string*string) list ref
        val ()=List.app (fn line => if T.matches "^structure C_[A-Za-z0-9_]* = struct open (Int|Word|Real)[0-9]+ " line then
                let val words=String.tokens Char.isSpace line in known:=(List.nth (words,1),List.nth (words,5)):: !known end
             else if T.matches "^structure C_[A-Za-z0-9_]* = C_[A-Za-z0-9_]*$" line then
                let val words=String.tokens Char.isSpace line in aliases:=(List.nth (words,1),List.nth (words,3)):: !aliases end else ()) (lines (T.required path))
        fun resolve name seen=if List.exists (fn old => old=name) seen then raise Failed "cyclic MLton C type alias" else
             case List.find (fn (key,_) => key=name) (!aliases) of NONE => GenerateRewrites.lookup name (!known) | SOME (_,next) => resolve next (name::seen)
        val result= !known @ List.map (fn (name,target) => (name,resolve target [name])) (!aliases)
    in sorted (fn ((a,_),(b,_)) => a<b) result end
  fun tableText rows=String.concat (List.map (fn (a,b) => a ^ "\t" ^ b ^ "\n") rows)
  fun mltonStubs ambiguous rows =
    let val done=ref [] : (string*string) list ref val values=ref [] : (string*string) list ref
        fun row line=case tabs line of [kind,name,ty] =>
          let val id=name ^ (if List.exists (fn key => key=kind ^ "\t" ^ name) ambiguous then "__" ^ GenerateRewrites.mangle false ty else "")
              val body=if kind="symbol" then "  val " ^ id ^ " = (fn () => XC2.unimplemented \"_symbol " ^ name ^ "\", fn _ => XC2.unimplemented \"_symbol " ^ name ^ "\")\n"
                      else "  val " ^ id ^ " = fn _ => XC2.unimplemented \"_" ^ kind ^ " " ^ name ^ "\"\n"
          in if List.exists (fn pair => pair=(id,kind)) (!done) then () else (done:=(id,kind):: !done;values:= !values @ [(kind,body)]) end | _ => raise Failed "invalid MLton extension row"
        val ()=List.app row rows
        fun namespace (kind,name,opens)="structure " ^ name ^ " =\nstruct\n" ^ String.concat (List.map #2 (List.filter (fn (key,_) => key=kind) (!values))) ^ String.concat (ListPair.map (fn (name,i) => (if i=0 then "  open " else "   open ") ^ name ^ "\n") (opens,List.tabulate (length opens,fn i => i))) ^ "end\n"
    in "(* Generated by tests/basis/xc2/mlton/gen.sh -- do not edit. *)\n" ^ String.concat (List.map namespace [("prim","XC2Prim",["XC2PrimImpl","XC2PrimGen"]),("import","XC2FFI",["XC2FFIImpl","XC2FFIReal"]),("symbol","XC2Symbol",["XC2SymbolImpl"]),("address","XC2Address",[])]) ^
       "(* the sources of MLton start where nothing is infix (the top-level infixes\n   come with top-level/infixes.sml), and the library of Rune has left its\n   own: *)\nnonfix * / div mod + - ^ @ <> > >= < <= := o before\n" end
  fun mlton args =
    let val (out,lib)=case args of [out] => (output out,hosts ^ "/mlton/lib/mlton") | [out,lib] => (output out,fromRoot lib) | _ => raise Usage "xc2-mlton OUTDIR [MLTON_LIB]"
        val target=lib ^ "/targets/self" val here=fromRoot "tests/basis/xc2/mlton" val xc2=fromRoot "tests/basis/xc2"
        val ()=need (exists (target ^ "/constants"),"no " ^ target ^ "/constants")
        val basis=case env ("XC2_MLTON_BASIS","") of "" => patched out (lib ^ "/sml/basis") (out ^ "/mlton-basis") (here ^ "/basis.patch") | path => fromRoot path
        val vars=[("OBJPTR_REP","rep64"),("SEQINDEX_INT","int64"),("SEQUENCE_METADATA_SIZE","size192"),("NORMAL_METADATA_SIZE","size64"),("DEFAULT_INT","int64"),("DEFAULT_WORD","word64"),("DEFAULT_REAL","real64"),("DEFAULT_CHAR","char8"),("DEFAULT_WIDECHAR","widechar32"),("LIB_MLTON_DIR",lib),("TARGET","self")]
        val flat=List.filter (fn GenerateMLB.File path => not (String.isSuffix "/libs/basis-2002/top-level/overloads.sml" path) | _ => true) (GenerateMLB.flatten vars (basis ^ "/basis.mlb"))
        val ()=listFile out "flat" (List.map GenerateMLB.encode flat)
        val consts=constants (target ^ "/constants") val ctypes=cTypes (target ^ "/sml/c-types.sml")
        val ()=writeFile out "consts" (tableText consts) val ()=writeFile out "ctypes" (tableText ctypes)
        val ints=List.mapPartial (fn (name,value) => if size value<19 andalso T.matches "^-?[0-9]+$" value then SOME ("    (\"" ^ name ^ "\", " ^ (if String.isPrefix "-" value then "~" ^ String.extract (value,1,NONE) else value) ^ ")") else NONE) consts
        val ()=writeFile out "consts.sml" ("(* Generated by tests/basis/xc2/mlton/gen.sh -- do not edit. *)\nstructure XC2Consts =\nstruct\n  val table : (string * int) list = [\n" ^ String.concatWith ",\n" ints ^ "\n  ]\nend\n")
        val table=out ^ "/table" val ()=write (table,"")
        val sources=sort (T.distinct (List.mapPartial (fn GenerateMLB.File path => SOME path | _ => NONE) flat))
        val ()=List.app (fn file => ignore (GenerateRewrites.mlton (setting (SOME table) [] consts ctypes []) file)) sources
        val rows=sort (T.distinct (lines (read table))) val ()=listFile out "table" rows
        val names=List.map (fn line => String.concatWith "\t" (List.take (tabs line,2))) rows
        fun repeated []=[] | repeated (name::rest)=if List.exists (fn old => old=name) rest then name::repeated (List.filter (fn old => old<>name) rest) else repeated rest
        val ambiguous=repeated names val ()=listFile out "ambiguous" ambiguous
        val files=GenerateFlatten.generate flat out basis (GenerateRewrites.mlton (setting NONE [] consts ctypes ambiguous))
        val settings=setting NONE [] consts ctypes ambiguous
        val ()=writeFile out "prims.sml" (GenerateMLtonPrims.make settings rows)
        val ()=writeFile out "stubs.sml" (mltonStubs ambiguous rows)
        val ()=copy (xc2 ^ "/xc2.sml") (out ^ "/xc2.sml") val ()=copies out here ["prologue.sml","shim.sml"]
        val prefix=List.map (fn name => out ^ "/" ^ name) ["xc2.sml","prologue.sml","consts.sml","shim.sml","prims.sml","stubs.sml"]
        val ()=listFile out "prefix" (prefix @ files) val ()=writeFile out "flags" "--default-type=int64 --default-type=word64\n"
    in trim out prefix;0 end
  fun mlkit args =
    let val (out,lib)=case args of [out,lib] => (output out,fromRoot lib) | _ => raise Usage "xc2-mlkit OUTDIR MLKIT_LIB"
        val here=fromRoot "tests/basis/xc2/mlkit" val xc2=fromRoot "tests/basis/xc2"
        val basis=case env ("XC2_MLKIT_BASIS","") of path => if path<>"" then fromRoot path else
             let val target=out ^ "/mlkit-basis" val source=lib ^ "/basis" val ()=(rmTree target;mkdirs target)
                 fun walk directory relative=List.app (fn name =>
                   let val file=directory ^ "/" ^ name val dest=target ^ "/" ^ relative ^ name
                   in if name="MLB" then () else if isDir file then walk file (relative ^ name ^ "/")
                      else if List.exists (fn ext => String.isSuffix ext name) [".sml",".sig",".mlb"] then copyTree file dest else () end) (entries directory)
                 val ()=walk source "" val ()=writable target
                 val _=successful (child {args=["patch","-s","-p1","-i",here ^ "/basis.patch"],directory=target,input="",prefix=out ^ "/patch",timeout=180,environment=fn e => e})
             in target end
        val flat=GenerateMLB.flatten [] (basis ^ "/basis.mlb") val ()=listFile out "flat" (List.map GenerateMLB.encode flat)
        val table=out ^ "/table" val ()=write (table,"") val typed=lines (T.required (here ^ "/typed.txt"))
        val sources=sort (T.distinct (List.mapPartial (fn GenerateMLB.File path => SOME path | _ => NONE) flat))
        val ()=List.app (fn file => ignore (GenerateRewrites.mlkit (setting (SOME table) typed [] [] []) file)) sources
        val rows=sort (T.distinct (lines (read table))) val ()=listFile out "table" rows
        val files=GenerateFlatten.generate flat out basis (GenerateRewrites.mlkit (setting NONE typed [] [] []))
        val literal=out ^ "/intinf-literals.sml"
        val ()=writeFile out "intinf-literals.sml" "(* Generated by tests/basis/xc2/mlkit/gen.sh -- do not edit. *)\nstructure XC2KIntInfLit = struct fun fromLit s = valOf (IntInf.fromString s) end\n_overload int IntInf via XC2KIntInfLit.fromLit\n"
        val files=List.concat (List.map (fn file => [file] @ (if String.isSuffix "-IntInf.sml" file then [literal] else [])) files) val ()=listFile out "files" files
        val ids=ref [] : string list ref
        val values=List.mapPartial (fn line => case tabs line of id::name::_ => if List.exists (fn old => old=id) (!ids) then NONE else
                  (ids:=id:: !ids;SOME ("  val " ^ id ^ " = fn _ => XC2.unimplemented \"prim " ^ name ^ "\"\n")) | _ => raise Failed "invalid MLKit primitive row") rows
        val ()=writeFile out "stubs.sml" ("(* Generated by tests/basis/xc2/mlkit/gen.sh -- do not edit. *)\nstructure XC2KPrim =\nstruct\n" ^ String.concat values ^ "  open XC2KPrimImpl\nend\n")
        val ()=copy (xc2 ^ "/xc2.sml") (out ^ "/xc2.sml") val ()=copies out here ["prologue.sml","shim.sml"]
        val prefix=List.map (fn name => out ^ "/" ^ name) ["xc2.sml","prologue.sml","shim.sml","stubs.sml"] val ()=listFile out "prefix" (prefix @ files)
    in trim out prefix;0 end
end
