         {name = "int_lt", arity = 2, ty = "int * int -> bool", effects = [],
          doc = "Less than."},
         {name = "int_le", arity = 2, ty = "int * int -> bool", effects = [],
          doc = "Less or equal."},
         {name = "int_gt", arity = 2, ty = "int * int -> bool", effects = [],
          doc = "Greater than."},
         {name = "int_ge", arity = 2, ty = "int * int -> bool", effects = [],
          doc = "Greater or equal."},
         {name = "int_to_string", arity = 1, ty = "int -> string", effects = [Allocates],
          doc = "Decimal rendering with ~ for negative."},
         {name = "int_from_string", arity = 1, ty = "string -> int option", effects = [Allocates],
