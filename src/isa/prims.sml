(* The primitives of the VMs, in the language of src/isa/isa.sml: a
   primitive's number is its place in this list, from 0, so a new one goes
   at the end. lib/basis binds each with `_prim "name" : ty`, and its C is
   `p_<name>` in vm/prims.c. `ty` is the type the library gives it, for
   documentation and for the hosts' RUNE_PRIM (tests/basis/host). Primitives
   that return an option rely on the prelude declaring
   `datatype 'a option = NONE | SOME of 'a` (NONE = tag 0, SOME = tag 1), and
   those that return an order on `datatype order = LESS | EQUAL | GREATER`.

   The effects say what a primitive may do beyond computing its result
   (Isa.effect); `anything` is the conservative answer, given wherever
   nothing more precise was worked out. *)
structure PrimIsa =
struct
  open Isa

  val primitives : primitive list =
    List.concat
      [group "polymorphic"
        [{name = "poly_eq", arity = 2, ty = "'a * 'a -> bool", effects = [],
          doc = "Structural equality (refs/arrays by identity)."},
         {name = "ptr_eq", arity = 2, ty = "'a * 'a -> bool", effects = [],
          doc = "Identity comparison of heap values."}],
       group "int (64-bit, Overflow checked)"
        [{name = "int_add", arity = 2, ty = "int * int -> int", effects = [Raises],
          doc = "Addition; raises Overflow."},
