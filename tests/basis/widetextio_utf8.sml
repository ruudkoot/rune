(* requires: WideTextIO WideString WideChar OS *)
(* WideTextIO (optional in the specification): the UTF-8 of its files
   (widetextio.sml, WideTextIO/files-hold-utf-8) against Markus Kuhn's UTF-8
   decoder capability and stress test
   (https://www.cl.cam.ac.uk/~mgk25/ucs/examples/UTF-8-test.txt), the
   examples of ill-formed sequences of the Unicode Standard 17.0, 3.9.6
   (Tables 3-8 to 3-11) and the one of its Table 3-8 in Unicode 6.0 to
   10.0, every byte that cannot begin a sequence, and the ends of the ranges
   of Table 3-7 with the bytes just outside them.

   Each case gives its bytes and, when they are well-formed UTF-8, the code
   points they encode. The bytes, written with TextIO, are read with
   WideTextIO: they give those code points, or IO.Io with the cause
   Fail "UTF-8" when they are not UTF-8 -- an overlong form, a surrogate, a
   value past 0x10FFFF, a lead byte C0, C1 or F5 to FF, a byte where none
   can stand, a sequence cut short. The code points of a well-formed case,
   written with WideTextIO, give its bytes; a surrogate, which a wide
   character may be but UTF-8 cannot hold, is not written.

   The wide strings are made from numbers, for the xc1 configurations have
   no wide literals. *)
structure TestWideTextIOUtf8 =
struct
  val file = "widetextio_utf8.txt"
  fun bytes l = String.implode (List.map Char.chr l)
  fun ws l = WideString.implode (List.map WideChar.chr l)
  fun codes v = List.map WideChar.ord (WideString.explode v)
  val eqCodes = T.eq (T.list T.int)
  val isUtf8 = fn IO.Io {cause = Fail "UTF-8", ...} => true | _ => false

  (* the file holds the bytes l *)
  fun writeBytes l =
    let val out = TextIO.openOut file in TextIO.output (out, bytes l); TextIO.closeOut out end
  fun readBytes () =
    let val ins = TextIO.openIn file in TextIO.inputAll ins before TextIO.closeIn ins end
  (* the file written and read with WideTextIO, closed when that raises too *)
  fun writeWide (put, x) =
    let val out = WideTextIO.openOut file
    in (put (out, x) handle e => (WideTextIO.closeOut out; raise e)); WideTextIO.closeOut out end
  fun readWide () =
    let val ins = WideTextIO.openIn file
    in (WideTextIO.inputAll ins handle e => (WideTextIO.closeIn ins; raise e)) before WideTextIO.closeIn ins end

