# windows
# The REPL on lib/terminal's editor (docs/plans/repl.md, M6): what is typed
# coloured by the compiler's lexer as it is typed -- a keyword, a string, a
# comment -- Tab completing from the session's names and a structure's
# members, what Tab would add shown faintly after the end and taken by
# Right, but not in a comment, and Up going back through what was entered. A console's
# pseudoconsole (Windows) may give the same styles in another order.
start 80 24 @REPL@
wait ^-$
send val alpha = 1; val alphabet = "two" (* comment *);
waits \e\[1m- val\e\[0m alpha
waits \e\[95m"two"(\e\[39m)? (\e\[2m)?(\e\[39m)?\(\* comment \*\)
keys Enter
wait ^val alphabet = "two" : string$
send alp
keys Tab
wait ^- alpha$
keys Tab
keys Tab
wait alpha +alphabet
keys C-u
send List.fil
keys Tab
wait ^- List.filter$
keys C-u
send TextIO.inputL
waits inputL(\e\[[0-9;]*m)*\e\[([0-9;]*;)?2m(\e\[[0-9;]*m)*ine
keys Right
send ;
keys Enter
wait ^val it = fn : TextIO\.instream -> string option$
send (* Li
wait ^- \(\* Li$
keys C-u Up Up
wait ^- val alpha = 1; val alphabet = "two" \(\* comment \*\);$
keys C-u
send val () = OS.Process.exit OS.Process.success;
keys Enter
exited 0
