# windows
# The REPL's colours on a terminal of 256 colours (RUNE_COLORS=wide, which
# auto is there; docs/repl.md, On a terminal): what is typed and what the
# REPL says coloured alike -- a keyword blue (32), a type teal (30), a
# constructor orange (166), a number green (64), a string purple (133) --
# in the echo of a datatype and of a value, in :type and in :browse; and
# the banner. A console's pseudoconsole (Windows) may join or reorder the
# styles, so each is looked for among the escapes before its text.
start 100 30 env RUNE_COLORS=wide @REPL@
wait ^Rune [^ ]+\. Type :help for instructions\.$
wait ^-$
send datatype shape = Circle of real | Square of int;
waits \e\[([0-9;]*;)?38;5;32m(\e\[[0-9;]*m)*datatype
waits = (\e\[[0-9;]*m)*\e\[([0-9;]*;)?38;5;166m(\e\[[0-9;]*m)*Circle
keys Enter
wait ^datatype shape = Circle of real \| Square of int$
waits ^(\e\[[0-9;]*m)*\e\[([0-9;]*;)?38;5;32m(\e\[[0-9;]*m)*datatype(\e\[[0-9;]*m)* (\e\[[0-9;]*m)*\e\[([0-9;]*;)?38;5;30m(\e\[[0-9;]*m)*shape
send val f = fn (x : int) => (x, "s", 1.5, Circle 2.0);
keys Enter
wait ^val f = fn : int -> int \* string \* real \* shape$
waits ^(\e\[[0-9;]*m)*\e\[([0-9;]*;)?38;5;32m(\e\[[0-9;]*m)*val
waits fn(\e\[[0-9;]*m)* : (\e\[[0-9;]*m)*\e\[([0-9;]*;)?38;5;30m(\e\[[0-9;]*m)*int
send f 3;
keys Enter
wait ^val it = \(3, "s", 1\.5, Circle 2\.0\) : int \* string \* real \* shape$
waits \((\e\[[0-9;]*m)*\e\[([0-9;]*;)?38;5;64m(\e\[[0-9;]*m)*3(\e\[[0-9;]*m)*, (\e\[[0-9;]*m)*\e\[([0-9;]*;)?38;5;133m(\e\[[0-9;]*m)*"s"
send :type f
keys Enter
wait ^f : int -> int
waits ^f : (\e\[[0-9;]*m)*\e\[([0-9;]*;)?38;5;30m(\e\[[0-9;]*m)*int
send :browse Option
keys Enter
wait ^val valOf : 'a option -> 'a$
waits ^(\e\[[0-9;]*m)*\e\[([0-9;]*;)?38;5;32m(\e\[[0-9;]*m)*val(\e\[[0-9;]*m)* isSome :
send :quit
keys Enter
exited 0
