# windows
# The REPL's commands on a terminal (docs/plans/repl.md, M8): Tab completing
# a command's name, :type, :doc with its Markdown laid out and styled, and
# :bt after an exception that ended an entry.
start 80 30 @REPL@
wait ^-$
send :ty
keys Tab
wait ^- :type$
send  [1, 2]
keys Enter
wait ^\[1, 2\] : int list$
send :doc Option.isSome
keys Enter
wait ^isSome opt is true when opt carries a value\.$
waits \e\[1mExample\e\[0m
send fun f 0 = raise Fail "zero" | f n = f (n - 1);
keys Enter
wait ^val f = fn
send f 2 : int;
keys Enter
wait raised in f at stdIn#1:1:
send :bt
keys Enter
wait ^  in <toplevel> at stdIn#2:1:1$
expect @DIR@/repl-commands.screen
send :quit
keys Enter
exited 0
