(* Utf8 and DisplayWidth: every scalar value written and read back; the
   ill-formed sequences of the Unicode Standard's examples (section 3.9,
   "U+FFFD Substitution of Maximal Subparts", Tables 3-8 to 3-11 of
   Unicode 18.0, and the one example of Unicode 6.0 to 10.0) and of Markus
   Kuhn's decoder test (https://www.cl.cam.ac.uk/~mgk25/ucs/examples/UTF-8-test.txt),
   each read as the replacements the standard recommends, one U+FFFD for
   each maximal subpart, and none of them valid; random bytes read without
   failing; and the widths of known characters. *)
structure Utf8Test =
