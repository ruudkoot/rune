(* Int64 raises Overflow at 64 bits; Word64 wraps there *)
val big = valOf Int64.maxInt
val small = valOf Int64.minInt
fun try f = (Int64.toString (f ()) ^ "\n") handle Overflow => "Overflow\n"
val () = print (try (fn () => Int64.+ (big, 1)))
val () = print (try (fn () => Int64.* (big, 2)))
val () = print (try (fn () => Int64.- (small, 1)))
val () = print (try (fn () => Int64.~ small))
val () = print (try (fn () => Int64.abs small))
val () = print (try (fn () => Int64.div (small, ~1)))
val () = print (try (fn () => Int64.quot (small, ~1)))
val () = print (try (fn () => Int64.+ (Int64.- (big, 1), 1)))
val () = print (try (fn () => Int64.* (4294967296, 2147483647)))
val () = print (try (fn () => Int64.* (4294967296, 2147483648)))
val () = print (try (fn () => Int64.* (~4294967296, 2147483648)))
val () = print (try (fn () => Int64.mod (small, ~1)))
val () = print (try (fn () => Int64.rem (small, ~1)))
val () = print (Word64.toString (Word64.+ (0wxFFFFFFFFFFFFFFFF, 0w1)) ^ " " ^ Word64.toString (Word64.* (0wxFFFFFFFFFFFFFFFF, 0wxFFFFFFFFFFFFFFFF)) ^ " " ^ Word64.toString (Word64.- (0w0, 0w1)) ^ "\n")
(* to and from int, which is 63 bits *)
fun tryi f = (Int.toString (f ()) ^ "\n") handle Overflow => "Overflow\n"
val () = print (tryi (fn () => Int64.toInt 4611686018427387903))
val () = print (tryi (fn () => Int64.toInt 4611686018427387904))
val () = print (tryi (fn () => Int64.toInt ~4611686018427387904))
val () = print (tryi (fn () => Int64.toInt ~4611686018427387905))
val () = print (tryi (fn () => Word64.toInt 0wx3FFFFFFFFFFFFFFF))
val () = print (tryi (fn () => Word64.toInt 0wx4000000000000000))
val () = print (tryi (fn () => Word64.toIntX 0wxFFFFFFFFFFFFFFFF))
val () = print (tryi (fn () => Word64.toIntX 0wxC000000000000000))
val () = print (tryi (fn () => Word64.toIntX 0wxBFFFFFFFFFFFFFFF))
val () = print (Int64.toString (Int64.fromInt (valOf Int.minInt)) ^ " " ^ Word64.toString (Word64.fromInt ~1) ^ " " ^ Word64.toString (Word64.fromInt (valOf Int.minInt)) ^ "\n")
