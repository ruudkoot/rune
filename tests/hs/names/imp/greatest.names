# The haskell2010 roadmap's D8: --names=greatest is a cycle's own setting, and the library is read under its own
# language, so the library's cycle keeps the least fixpoint; this program has no cycle, and prints least.names'
# 955 pairs (E16 found 958 here when the option reached the library, where T1's map circulates).
pairs 955
ERROR	T3:3:5	`map` is ambiguous: it is T1's and PreludeList's
ERROR	T3:4:5	the variable `P.map` is not in scope
EXPORT	T1	vT1 map
EXPORT	T1	vhaskell98:Prelude Nothing
EXPORT	T2	vT2 x
EXPORT	T2	vT2 y
EXPORT	T2	vT2 z
EXPORT	T3	vT3 v
EXPORT	T3	vT3 w
