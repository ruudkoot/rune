; run: --read-core tests/hs/core/lib/base.core
; files: own
; What the library's PreludeRuntime names beside the Report's (L, M17,
; M18): double_pow (C's pow), decodeFloat's halves, arrays, str_eq, an
; IOError's details (exn_io_full and its readers), unsafe_perform_io,
; primPackString, the IO-shaped ref_set; the IO family of CorePrimIo:
; h_tell, h_seek and h_errno of a file (a seek to a position below 0 failing
; with -1, on the interpreter as on the VM), os_file_size, sys_errno and the
; name and text of an error's number, primReady on standard input
; (runtime-library.stdin); and the kinds of the IOErrors the runtime raises,
; a file not there and a directory written. Each line is a label and a
; value; one that raises is caught by the harness's try. Written by a
; script from a list of items, each an action of its own, run in order.

(val line (-> !Str !Str World (utuple World Unit))
  (\ ((l !Str) (s !Str) (w World))
    (case (prim str_concat l " ") a (_ (case (prim str_concat a s) b (_ (putStrLn b w)))))))
(val showDouble (-> !Double Str) (\ ((d !Double)) (prim double_to_str d)))
(val showBool (-> !Bool Str) (\ ((b !Bool)) (case b c ((True) "True") ((False) "False"))))
(val nan Double (prim double_div 0.0 0.0))
(val inf Double (prim double_div 1.0 0.0))
; an IOError's details: code, file, handle, text
(val details (-> !Exn Str)
  (\ ((e !Exn))
    (case (prim exn_io_code e) c (_ (case (showInt c) cs
      (_ (case (prim exn_io_file e) f (_ (case (prim exn_io_handle e) h (_ (case (showInt h) hs
        (_ (case (prim exn_message e) m
          (_ (case (prim str_concat cs " [") a (_ (case (prim str_concat a f) b (_ (case (prim str_concat b "] ") d
            (_ (case (prim str_concat d hs) g (_ (case (prim str_concat g " ") i (_ (prim str_concat i m)))))))))))))))))))))))))
; what an action raises, as its details; "none" where it raises nothing
(val raised (-> (-> World (utuple World Unit)) World (utuple World Str))
  (\ ((act (-> World (utuple World Unit))) (w World))
    (let (ok (-> World (utuple World Str)) (\ ((v World)) (case (act v) r ((utuple v1 _) (utuple v1 "none")))))
    (let (h (-> !Exn World (utuple World Str)) (\ ((e !Exn) (v World)) (case (details e) s (_ (utuple v s)))))
      (prim catch @Str ok h w)))))
(val arr (Arr Int)
  (case (prim real_world) w (_ (case (prim arr_new @Int 3 7 w) r ((utuple _ a) a)))))
(val lit (-> !Str ([] Char)) (\ ((s !Str)) (primUnpackString s)))
(val t0 (-> World (utuple World Unit))
  (\ ((v World)) (case (case (prim double_pow 2.0 10.0) x (_ (showDouble x))) s (_ (line "double_pow 2 10" s v)))))
(val t1 (-> World (utuple World Unit))
  (\ ((v World)) (case (case nan n (_ (case (prim double_pow 1.0 n) x (_ (showDouble x))))) s (_ (line "double_pow 1 NaN" s v)))))
(val t2 (-> World (utuple World Unit))
  (\ ((v World)) (case (case inf n (_ (case (prim double_pow -1.0 n) x (_ (showDouble x))))) s (_ (line "double_pow -1 inf" s v)))))
(val t3 (-> World (utuple World Unit))
  (\ ((v World)) (case (case (prim double_pow 0.0 -1.0) x (_ (showDouble x))) s (_ (line "double_pow 0 -1" s v)))))
(val t4 (-> World (utuple World Unit))
  (\ ((v World)) (case (case (double_mantissa 1.5) x (_ (showInt x))) s (_ (line "double_mantissa 1.5" s v)))))
(val t5 (-> World (utuple World Unit))
  (\ ((v World)) (case (case (double_exponent 1.5) x (_ (showInt x))) s (_ (line "double_exponent 1.5" s v)))))
(val t6 (-> World (utuple World Unit))
  (\ ((v World)) (case (case arr a (_ (case (prim arr_size @Int a) x (_ (showInt x))))) s (_ (line "arr_size" s v)))))
(val t7 (-> World (utuple World Unit))
  (\ ((v World)) (case (case arr a (_ (case (prim arr_set @Int a 1 9 v) v1 (_ (case (prim arr_read @Int a 1 v1) r ((utuple v2 x) (case x y (_ (showInt y))))))))) s (_ (line "arr_set 1 9, arr_read 1" s v)))))
(val t8 (-> World (utuple World Unit))
  (\ ((v World)) (case (case arr a (_ (case (prim arr_get @Int a 2) x (_ (showInt x))))) s (_ (line "arr_get 2" s v)))))
(val t9 (-> World (utuple World Unit))
  (\ ((v World)) (case (putStr "arr_get 3 " v) o ((utuple v1 _) (case (case arr a (_ (case (prim arr_get @Int a 3) x (_ (showInt x))))) s (_ (putStrLn s v1)))))))
(val t10 (-> World (utuple World Unit))
  (\ ((v World)) (case (case (prim str_eq "ab" "ab") x (_ (showBool x))) s (_ (line "str_eq ab ab" s v)))))
(val t11 (-> World (utuple World Unit))
  (\ ((v World)) (case (case (prim str_eq "ab" "abc") x (_ (showBool x))) s (_ (line "str_eq ab abc" s v)))))
(val t12 (-> World (utuple World Unit))
  (\ ((v World)) (case (case (prim exn_io_full 2 "no such file" "x.txt" 3) e (_ (details e))) s (_ (line "exn_io_full" s v)))))
(val t13 (-> World (utuple World Unit))
  (\ ((v World)) (case (case (prim exn_io "a user's") e (_ (details e))) s (_ (line "exn_io" s v)))))
(val t14 (-> World (utuple World Unit))
  (\ ((v World)) (case (case (prim exn_error "an error") e (_ (details e))) s (_ (line "exn_error" s v)))))
(val t15 (-> World (utuple World Unit))
  (\ ((v World)) (case (let (m (-> World (utuple World Int)) (\ ((u World)) (utuple u 42))) (case (unsafe_perform_io @Int m) x (_ (showInt x)))) s (_ (line "unsafe_perform_io" s v)))))
(val t16 (-> World (utuple World Unit))
  (\ ((v World)) (case (let (s ([] Char) (lit "h\195\169llo")) (case (primPackString s) p (_ (case (prim str_size p) n (_ (showInt n)))))) s (_ (line "primPackString" s v)))))
(val t17 (-> World (utuple World Unit))
  (\ ((v World)) (case (case (prim ref_new @Int 1 v) r ((utuple v1 c) (case (ref_set @Int c 5 v1) o ((utuple v2 _) (case (prim ref_get @Int c v2) g ((utuple v3 x) (case x y (_ (showInt y))))))))) s (_ (line "ref_set, IO-shaped" s v)))))
(val t18 (-> World (utuple World Unit))
  (\ ((v World)) (case (case (primReady 0 0 v) r ((utuple v1 b) (case b c (_ (showBool c))))) s (_ (line "primReady 0 0" s v)))))
(val t19 (-> World (utuple World Unit))
  (\ ((v World)) (case (let (p ([] Char) (lit "lib.tmp")) (let (t ([] Char) (lit "hello, world")) (case (primWriteFile p t v) o ((utuple v1 _) (case (prim h_open "lib.tmp" 0 v1) r ((utuple v2 h) (case (prim h_tell h v2) q ((utuple v3 n) (case (prim h_close h v3) v4 (_ (showInt n))))))))))) s (_ (line "a file: write, open, h_tell" s v)))))
(val t20 (-> World (utuple World Unit))
  (\ ((v World)) (case (case (prim h_open "lib.tmp" 0 v) r ((utuple v1 h) (case (prim h_read h 3 v1) a ((utuple v2 s) (case (prim h_tell h v2) b ((utuple v3 n) (case (prim h_seek h 7 v3) c ((utuple v4 z) (case (prim h_read h 5 v4) d ((utuple v5 t) (case (prim h_close h v5) v6 (_ (case (showInt n) ns (_ (case (showInt z) zs (_ (case (prim str_concat s " ") x1 (_ (case (prim str_concat x1 ns) x2 (_ (case (prim str_concat x2 " ") x3 (_ (case (prim str_concat x3 zs) x4 (_ (case (prim str_concat x4 " ") x5 (_ (prim str_concat x5 t))))))))))))))))))))))))))) s (_ (line "h_read 3, h_tell, h_seek 7, h_read 5" s v)))))
(val t21 (-> World (utuple World Unit))
  (\ ((v World)) (case (case (prim os_file_size "lib.tmp" v) r ((utuple v1 n) (showInt n))) s (_ (line "os_file_size lib.tmp" s v)))))
(val t22 (-> World (utuple World Unit))
  (\ ((v World)) (case (case (prim os_file_size "/nonexistent/rhc" v) r ((utuple v1 n) (case (prim sys_errno v1) q ((utuple v2 e) (case (prim sys_error_name e) nm (_ (case (prim sys_error_message e) msg (_ (case (showInt n) ns (_ (case (prim str_concat ns " ") a (_ (case (prim str_concat a nm) b (_ (case (prim str_concat b " ") c (_ (prim str_concat c msg))))))))))))))))) s (_ (line "os_file_size missing, sys_errno, its name, its text" s v)))))
(val t23 (-> World (utuple World Unit))
  (\ ((v World)) (case (case (prim h_open "/nonexistent/rhc" 0 v) r ((utuple v1 h) (case (prim h_errno v1) q ((utuple v2 e) (case (prim sys_error_name e) nm (_ nm)))))) s (_ (line "h_open missing, h_errno" s v)))))
(val t24 (-> World (utuple World Unit))
  (\ ((v World)) (case (let (p ([] Char) (lit "/nonexistent/rhc")) (let (act (-> World (utuple World Unit)) (\ ((u World)) (case (primReadFile p u) r ((utuple u1 s) (case s t (_ (let (x Unit (con Unit)) (utuple u1 x)))))))) (case (raised act v) r ((utuple v1 s) s)))) s (_ (line "readFile missing" s v)))))
(val t25 (-> World (utuple World Unit))
  (\ ((v World)) (case (let (p ([] Char) (lit ".")) (let (t ([] Char) (lit "x")) (let (act (-> World (utuple World Unit)) (\ ((u World)) (case (primWriteFile p t u) r ((utuple u1 _) (let (x Unit (con Unit)) (utuple u1 x)))))) (case (raised act v) r ((utuple v1 s) s))))) s (_ (line "writeFile a directory" s v)))))
(val t26 (-> World (utuple World Unit))
  (\ ((v World))
    (case
      (case (prim h_open "lib.tmp" 0 v) r
        ((utuple v1 h)
          (case (prim h_seek h -1 v1) c
            ((utuple v2 z)
              (case (prim h_close h v2) v3
                (_ (showInt z)))))))
      s
      (_ (line "h_seek -1" s v)))))
(val main (-> World (utuple World Unit))
  (\ ((w0 World))
    (case (t0 w0) o0 ((utuple w1 _)
    (case (t1 w1) o1 ((utuple w2 _)
    (case (t2 w2) o2 ((utuple w3 _)
