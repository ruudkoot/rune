; run: --read-core tests/hs/core/lib/base.core
; rhc's runtime (CoreRuntime) on Char's primUnicode*: lib/unicode's
; general category and simple case mappings (CodePoint, D21), from tables
; rhc writes from its data. A line is a code point, then isUpper, isLower,
; isAlphaNum and isPrint as U, L, A and P or a dot, then toUpper and
; toLower. isUpper is true of every letter that is not lower case (R38):
; of a titlecase digraph, a modifier letter and a letter with no case, as
; 4E2D. The code points are CodePoint's examples, with digits, numbers
; and separators of each kind. unicode-agrees, a test of the runner,
; holds the runtime to CodePoint at many more. Written by a script from a
; list of items, each an action of its own, run in order.

(val line (-> !Str !Str World (utuple World Unit))
  (\ ((l !Str) (s !Str) (w World))
    (case (prim str_concat l " ") a (_ (case (prim str_concat a s) b (_ (putStrLn b w)))))))
(val flag (-> Bool !Str Str) (\ ((b Bool) (s !Str)) (case b v ((True) s) ((False) "."))))
(val cat4 (-> !Str !Str !Str !Str Str)
  (\ ((a !Str) (b !Str) (c !Str) (d !Str))
    (case (prim str_concat a b) ab (_ (case (prim str_concat c d) cd (_ (prim str_concat ab cd)))))))
; the classes and mappings of the code point i
(val classes (-> !Int Str)
  (\ ((i !Int))
    (let (c Char (primIntToChar i))
    (let (u Bool (primUnicodeIsUpper c)) (let (l Bool (primUnicodeIsLower c))
    (let (a Bool (primUnicodeIsAlphaNum c)) (let (p Bool (primUnicodeIsPrint c))
    (case (flag u "U") fu (_ (case (flag l "L") fl (_ (case (flag a "A") fa (_ (case (flag p "P") fp
      (_ (case (cat4 fu fl fa fp) fs
        (_ (let (up Char (primUnicodeToUpper c)) (let (lo Char (primUnicodeToLower c))
           (case (primCharToInt up) ui (_ (case (primCharToInt lo) li
             (_ (case (showInt ui) us (_ (case (showInt li) ls
               (_ (case (prim str_concat fs " ") f1 (_ (case (prim str_concat f1 us) f2
                 (_ (case (prim str_concat f2 " ") f3 (_ (prim str_concat f3 ls))))))))))))))))))))))))))))))))))
(val t0 (-> World (utuple World Unit))
