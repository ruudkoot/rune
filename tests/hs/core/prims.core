; run: --read-core tests/hs/core/lib/base.core
; The primitives on their edges, as Mid's do them: Int's division both
; ways round, Double, a Char past ASCII in UTF-8, the bytes of a Str; and
; what each raises, caught by the harness's try: Overflow (an Int doubled
; until it overflows, at whatever width Int has), Div, Chr and Subscript.
; double_to_str is Mid's real_to_string: twelve digits, ~ for a minus, and
; .0 where there is no point, so 3.0 is "3.0". Integer's are prims-integer.core's.
(val showDouble (-> !Double Str) (\ ((d !Double)) (prim double_to_str d)))

(val doubling (-> !Int !Int Int)
  (\ ((n !Int) (k !Int))
    (case (prim int_eq k 0) z
      ((True) n)
      ((False) (case (prim int_add n n) m (_ (case (prim int_sub k 1) k1 (_ (doubling m k1)))))))))

(val show4 (-> !Str !Str !Str !Str Str)
  (\ ((a !Str) (b !Str) (c !Str) (d !Str))
    (case (prim str_concat a " ") a1
      (_ (case (prim str_concat a1 b) a2
           (_ (case (prim str_concat a2 " ") a3
                (_ (case (prim str_concat a3 c) a4
                     (_ (case (prim str_concat a4 " ") a5 (_ (prim str_concat a5 d)))))))))))))

