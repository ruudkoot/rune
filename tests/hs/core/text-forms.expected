(* after read *)
(data Pair (a b) (Pair a b))
(data App ((f (-> * *)) a) (App (f a)))
(data Strict (a) (Strict !a (-> !a Int)))
(newtype Wrap (a) MkWrap (-> a a))
(val >>= (forall ((m (-> * *)) a) (-> (m a) (m a))) (\ (@(m (-> * *)) @a (x (m a))) x))
(val `let` Int 1)
(val `!` (-> Int Int) (\ ((x Int)) x))
(val x' (-> !Int Int Int) (\ ((n !Int)) (\ ((m Int)) (case m v (_ (prim int_add n v))))))
(val pairUp (forall (a) (-> a (Pair a a))) (\ (@a (x a)) (con Pair @a @a x x)))
(val wrap (forall (a) (Wrap a)) (\ (@a) (cast (\ ((y a)) y) (Wrap a))))
(val unwrap (forall (a) (-> (Wrap a) a a))
  (\ (@a (w (Wrap a)) (y a)) (let (f (-> a a) (cast w (-> a a))) (f y))))
(val literals (List Lit) (con Nil @Lit))
(data Lit () (I Int) (J Integer) (D Double) (F Float) (C Char) (S Str))
(val lits (-> Int Lit)
  (\ ((k Int))
    (case k v
      (0 (con I -42))
      (1 (con J 123456789012345678901234567890I))
      (2 (con D 2.5e-3))
      (3 (con F 1.5F))
      (4 (con C '\''))
      (5 (con C '\955'))
      (6 (con S "tab\tquote\"backslash\\newline\nbyte\200"))
      (_ (con C 'x')))))
(val rec (-> Int (List Int))
  (\ ((k Int))
    (letrec ((xs (List Int) (con Cons @Int k ys)) (ys (List Int) (con Cons @Int 0 xs))) xs)))
(data List (a) (Nil) (Cons a (List a)))
(val io (-> World (utuple World !Int))
  (\ ((w World)) (case (prim print_str "" w) w1 (_ (utuple w1 0)))))
(val pick (-> World (utuple World !Int) Int)
  (\ ((w World) (t (utuple World !Int))) (case t u ((utuple _ n) n))))
(val apply (-> (-> Int Int) Int Int) (\ ((f (-> Int Int)) (y Int)) ((\ ((z Int)) (f z)) y)))

