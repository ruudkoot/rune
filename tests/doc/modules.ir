file tests/doc/modules.sml
  signature S
    para: Structures and functors: what they are ascribed and what they are bound to.
    type t
      spec: type t
    val x
      spec: val x : t
      adjacent
    source: signature S = sig type t val x : t end
  structure Plain
    members: t x
  structure Transparent
    ascribed: S
    members: t x
  structure Opaque
    sealed with: S where type t = int
    members: t x
  structure Alias
    alias of: Plain
  structure Nested
    members: Inner Deeper y
    twin: y = Inner.x
    structure Inner
      ascribed: S
      alias of: Transparent
    structure Deeper
      members: Innermost
      structure Innermost
        alias of: Plain
  functor Id
    parameter: X : S
    ascribed: S
  functor Make
    parameter: type elem val zero : elem
    sealed with: S where type t = elem
  structure Applied
    application of Id to: Plain
  structure Made
    application of Make to: type elem = int val zero = 0
  structure A
    alias of: Plain
  structure B
    alias of: Alias
