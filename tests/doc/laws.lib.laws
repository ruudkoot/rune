(* The laws of the documentation of COLORS, at every structure that implements it.
   Generated by runedoc from tests/doc/laws.lib/colors.sml; do not edit. Compile it with
   `rune --library test/property` (docs/plans/quickcheck.md, M8). *)
val () = Check.laws [
  ("COLORS.index/law-1@Colors",
   fn () => Prop.equalIf (IntArb.arb, IntArb.arb)
     (fn i => let open Colors in (0 <= i andalso i < 3) end,
      fn i => let open Colors in index (fromIndex i) end,
      fn i => let open Colors in i end)),
  ("COLORS.fromIndex/law-1@Colors",
   fn () => Prop.equalIf (IntArb.arb, IntArb.arb)
     (fn _ => true,
      fn i => let open Colors in index (fromIndex (i mod 3)) end,
      fn i => let open Colors in index (fromIndex ((i + 3) mod 3)) end)),
  ("COLORS.keep/law-1@Colors",
   fn () => Prop.holdsIf (Arb.pair (Arb.pureFunction (IntArb.arb, Arb.bool), Arb.list (IntArb.arb)))
     (fn _ => true,
      fn (f, l) => let open Colors in List.length (keep (f, l)) <= List.length l end)),
  ("COLORS.keep/law-2@Colors",
   fn () => Prop.equalIf (Arb.list (IntArb.arb), Arb.list (IntArb.arb))
     (fn _ => true,
      fn l => let open Colors in keep (fn _ => true, l) end,
      fn l => let open Colors in l end)),
  ("COLORS.keep/law-3@Colors",
   fn () => Prop.equalIf (Arb.list (IntArb.arb), Arb.list (IntArb.arb))
     (fn _ => true,
      fn l => let open Colors in keep (fn _ => false, l) end,
      fn l => let open Colors in [] end)),
  ("COLORS.keep/law-4@Colors",
   fn () => Prop.equalIf (Arb.triple (Arb.pureFunction (IntArb.arb, Arb.bool), Arb.pureFunction (IntArb.arb, Arb.bool), Arb.list (IntArb.arb)), Arb.list (IntArb.arb))
     (fn _ => true,
      fn (f, g, l) => let open Colors in keep (f, keep (g, l)) end,
      fn (f, g, l) => let open Colors in keep (g, keep (f, l)) end))]
