val x : IntInf.int = 3472347895;
val y : IntInf.int = 823908470298354;
x * y * x * x * x * y * y * y;
val zero : IntInf.int = 0;
val negative : IntInf.int = ~18446744073709551616;
val large : LargeInt.int = 18446744073709551616;
val nested = (SOME large, [zero, ~x]);
type bigint = IntInf.int;
val alias : bigint = x;
structure Numbers = IntInf;
structure IntInf = struct datatype int = Pretend fun toString _ = "wrong" end;
val shadowed = large;
structure LargeInt = struct type int = string fun toString x = x end;
val retained = ~large;
structure Byte = Word8;
type byte = Byte.word;
val byte : byte = 0wxAB;
structure Printable = struct datatype t = V of int fun toString (V n) = "v" ^ Int.toString n end;
val printable = Printable.V 3;
structure Mismatch = struct datatype t = M of int val toString = Int.toString end;
val plain = Mismatch.M 4;
val () = Compiler.addPrettyPrinter (fn _ => fn () => fn (_ : bigint) => Compiler.PrettyString "<integer>");
large;
