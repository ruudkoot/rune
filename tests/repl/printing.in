(* the rules of printing (docs/plans/repl.md, D16 and M7), one to a line *)
val r = 5.0;
val rs = [1.5, ~2.0, 1E10, 0.1];
val wide = List.tabulate (30, fn i => i * 1000);
val nested = [List.tabulate (12, fn i => (i, Int.toString i)), [(99, "ninety-nine")]];
val many = List.tabulate (150, fn i => i);
val text = CharVector.tabulate (1200, fn _ => #"x");
exception E of int * string;
val e = E (1, "one");
structure S = struct exception F of int list end;
val f = S.F [1, 2];
val failed = Fail "boom";
val io = IO.Io {name = "f.sml", function = "openIn", cause = Fail "gone"};
val sys = OS.SysErr ("No such file or directory", NONE);
datatype t = A; val a = A; datatype t = B;
a;
val w8 = Word8.fromInt 3;
val v = Vector.fromList [Time.zeroTime];
val () = Compiler.printLength := 3;
[1, 2, 3, 4, 5];
val () = Compiler.stringLength := 4;
"abcdefgh";
val () = (Compiler.printLength := 100; Compiler.stringLength := 1000; RuneCompiler.printNodes := 4);
[[1], [2], [3], [4], [5], [6]];
val () = (RuneCompiler.printNodes := 10000; RuneCompiler.feedback := "concise");
datatype u = U; val x = U;
val () = RuneCompiler.feedback := "verbose";
structure T = struct val y = 1 type z = int datatype w = W of z end;
val () = RuneCompiler.feedback := "silent";
val hidden = 1;
val () = RuneCompiler.feedback := "normal";
hidden;
