(* The mutants of the cache (docs/testing.md, The checks of the cache; the
   build-system roadmap's E18 and M2): the 37 of E18, F1 to M3 by its names,
   and those added for the checks that came of it. Each is an edit of the
   compiler's sources as a mutant of CompilerMutantList is, whose old text
   occurs once in its file, which make check holds. What sees one is a check
   of the cache and no compile of a corpus, so each names the checks that must
   fail on it, with what each must say (a check is a scenario of
   bin/rune-incremental, mutate or soundness); tests/runner/compilermutants.sml
   runs them. No check named: a mutant argued harmless, the argument in its
   note and in docs/testing.md. repl: the check drives the REPL, which is made
   of the mutant too. *)
structure CacheMutantList =
struct
  type catch = {check : string, says : string}
  type mutant = {mutant : CompilerMutantList.mutant, catches : catch list, repl : bool}

  val ub = "lib/compiler/driver/unitbasis.sml"
  val uc = "lib/compiler/driver/unitcache.sml"
  val us = "lib/compiler/driver/unitstore.sml"
  val el = "lib/compiler/elab/elaborate.sml"
  val en = "lib/compiler/elab/env.sml"
  val fx = "lib/compiler/frontend/fixity.sml"
  val um = "lib/compiler/driver/unitmid.sml"
  val cc = "src/driver/cachecheck.sml"
  val mn = "src/driver/main.sml"
  val st = "lib/compiler/state.sml"

  fun m (id, class, issue, repl, note, catches, file, old, new) : mutant =
    {mutant = CompilerMutantList.m (id, class, "cache", file, note, issue, [(file, old, new)]),
     catches = List.map (fn (check, says) => {check = check, says = says}) catches, repl = repl}
  (* one edit more, of the same file *)
  fun also (edit as (file, old, new)) ({mutant = {id, class, pass, site, note, real, edits}, catches, repl} : mutant) : mutant =
    {mutant = {id = id, class = class, pass = pass, site = site, note = note, real = real,
               edits = edits @ [{file = file, old = old, new = new}]},
     catches = catches, repl = repl}

