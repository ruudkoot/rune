         "| Pos (fi, ln, cl, inl) => lineEntries := (o', fi, ln, cl, inl) :: !lineEntries",
         "| Pos (fi, ln, cl, inl) => lineEntries := (o', fi, ln, cl + 1, inl) :: !lineEntries")]),
     m ("K01", "global misnumbered", "link", lk ^ ":185",
        "a unit's globals 0 and 1 swapped at link", "",
       [(lk,
         "          fun global g = Array.sub (globalMap, g)",
         "          fun global g = Array.sub (globalMap, if g = 0 andalso Array.length globalMap > 1 then 1 else if g = 1 then 0 else g)")]),
     m ("K02", "function misnumbered", "link", lk ^ ":182",
        "an imported function linked to the one after it", "",
       [(lk,
         "                             SOME g => g\n                           | NONE => bug (\"a function is exported by no unit before (\"",
         "                             SOME g => g + 1\n                           | NONE => bug (\"a function is exported by no unit before (\"")])]
end
