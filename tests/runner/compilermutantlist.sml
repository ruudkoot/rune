(* The mutants of the compiler (the linting roadmap's E3, kept by its M4;
   docs/testing.md, Mutants of the compiler; tests/runner/compilermutants.sml
   runs them): each one or more exact edits of the compiler's sources, whose
   old text occurs once in its file; the stage the mutated code runs in; the
   site it was written against (E3's snapshot, functors-units d551f19dd; M01
   and M02 read Simplify's copyAt since the linting roadmap's M4); and the
   fix it reverts, where it is one. *)
structure CompilerMutantList =
