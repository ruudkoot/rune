(* after mid *)
(datatype t () (0 "A") (1 "B" : int) (2 "C" : int) (3 "D") (4 "E" : t))
(funs
  (fn g1 ((v1 : t)) : int "f"
    (let (v2 : t) v1
    (let (v3 : t) v2
    (join j1 ()
      (return 0)
    (join j2 ((v4 : int))
      (return v4)
    (join j3 ((v5 : int))
      (return (prim int_add v5 1 : (int * int) -> int))
    (join j4 ()
      (return 3)
    (join j5 ()
      (return 4)
    (case v3
      (0
        (jump j1))
      (1
        (let (v6 : int) (decon 1 v3 : t)
        (jump j2 v6)))
      (2
        (let (v7 : int) (decon 2 v3 : t)
        (jump j3 v7)))
      (3
        (jump j4))
      (else
        (let (v8 : t) (decon 4 v3 : t)
        (jump j5)))))))))))))
(funs
  (fn g2 ((v9 : t)) : int "g"
    (let (v10 : t) v9
    (let (v11 : t) v10
    (join j6 ()
      (return 1)
    (join j7 ()
      (let (v12 : t) v10
      (join j8 ()
        (return 2)
      (join j9 ()
        (return 3)
      (join j10 ()
        (return 4)
      (case v12
        (0
          (jump j8))
        (1
          (let (v13 : int) (decon 1 v12 : t)
          (jump j9)))
        (else
          (jump j10)))))))
    (case v11
      (0
        (jump j6))
      (else
        (jump j7)))))))))
(val g3 : int
  (let (v14 : t) (con 4 (con0 3 : t) : t)
  (let (v15 : int) (app g1 v14)
  (let (v16 : t) (con 2 1 : t)
  (let (v17 : int) (app g2 v16)
  (return (prim int_add v15 v17 : (int * int) -> int)))))))
