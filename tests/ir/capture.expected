(* after lower *)
function f0 <toplevel> (v1, 0 captured)
  b0:
    v2 = closure f1 
    v3 = setglobal g1 v2
    v4 = closure f3 
    v5 = setglobal g2 v4
    v6 = ()
    return v6
function f1 pick (v1, 0 captured)
  b0:
    v2 = select 0 v1
    v3 = select 1 v1
    v4 = const 1
    v5 = prim int_add v2 v4
    v6 = tuple v5 v3
    v7 = closure f2 v6
    return v7
  reps v1:ptr v2:int v4:int v5:int
function f2 fn (v1, 1 captured)
  b0:
    v2 = env 0
    v3 = select 0 v2
    v4 = prim int_add v1 v3
    return v4
  reps v1:int v3:int v4:int
function f3 wrap (v1, 0 captured)
  b0:
    v2 = select 0 v1
    v3 = select 1 v1
    v4 = const 1
    v5 = prim int_add v2 v4
    v6 = tuple v5 v3
    v7 = closure f4 v6
    return v7
  reps v1:ptr v2:int v3:int v4:int v5:int
function f4 fn (v1, 1 captured)
  b0:
    v2 = env 0
    v3 = select 0 v2
    v4 = select 1 v2
    v5 = con 0 v3 v4
    return v5
  reps v1:unit v5:ptr
