(funs
  (fn g1 ((v1 : unit * unit)) : unit * unit "functor Sum"
    (let (v2 : unit) (select 1 v1)
    (let (v3 : t) (prim functor_cast v2 : unit -> t)
    (let (v4 : unit) (select 0 v1)
    (let (v5 : (t * t) -> t) (prim functor_cast v4 : unit -> (t * t) -> t)
    (fun
      (fn v6 ((v7 : tree)) : t "Sum.sum"
        (join j1 ()
          (join j2 ()
            (let (v8 : exncon) (builtinexn 0)
            (let (v9 : exn) (mkexn v8 ())
            (raise v9)))
          (case v7
            (1
              (let (v10 : tree * t * tree) (decon 1 v7 : tree)
              (let (v11 : tree) (select 0 v10)
              (let (v12 : tree) v11
              (let (v13 : t) (select 1 v10)
              (let (v14 : t) v13
              (let (v15 : tree) (select 2 v10)
              (let (v16 : tree) v15
              (let (v17 : t) (app v6 v12)
              (let (v18 : t) (app v6 v16)
              (let (v19 : t * t) (tuple v14 v18)
              (let (v20 : t) (app v5 v19)
              (let (v21 : t * t) (tuple v17 v20)
              (return (app v5 v21)))))))))))))))
            (else
              (jump j2))))
        (case v7
          (0
            (return v3))
          (else
            (jump j1)))))
    (let (v22 : unit) (prim functor_cast v6 : (tree -> t) -> unit)
    (return (tuple v22 ()))))))))))
(funs
  (fn g2 ((v23 : int * int)) : int "I.add"
    (let (v24 : int) (select 0 v23)
    (let (v25 : int) v24
    (let (v26 : int) (select 1 v23)
    (let (v27 : int) v26
    (return (prim int_add v25 v27 : (int * int) -> int))))))))
(val g3 : int
  (return 0))
(val g4 : unit
  (return (prim functor_cast g2 : ((int * int) -> int) -> unit)))
(val g5 : unit
  (return (prim functor_cast 0 : int -> unit)))
(val g6 : unit * unit
  (return (tuple g4 g5)))
(funs
  (fn g7 ((v28 : tree/2)) : int "Sum.sum"
    (join j3 ()
      (join j4 ()
        (let (v29 : exncon) (builtinexn 0)
        (let (v30 : exn) (mkexn v29 ())
        (raise v30)))
      (case v28
        (1
          (let (v31 : tree/2 * int * tree/2) (decon 1 v28 : tree/2)
