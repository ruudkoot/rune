          (let (v33 : tree/2) v32
          (let (v34 : int) (select 1 v31)
          (let (v35 : int) v34
          (let (v36 : tree/2) (select 2 v31)
          (let (v37 : tree/2) v36
          (let (v38 : int) (app g7 v33)
          (let (v39 : int) (app g7 v37)
          (let (v40 : int * int) (tuple v35 v39)
          (let (v41 : int) (app g2 v40)
          (let (v42 : int * int) (tuple v38 v41)
          (return (app g2 v42)))))))))))))))
        (else
          (jump j4))))
    (case v28
      (0
        (return 0))
      (else
        (jump j3))))))
(val g8 : unit
  (return (prim functor_cast g7 : (tree/2 -> int) -> unit)))
(val g9 : unit * unit
