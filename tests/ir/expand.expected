(val g10 : int
  (let (v43 : tree/2 * int * tree/2) (tuple (con0 0 : tree/2) 3 (con0 0 : tree/2))
  (let (v44 : tree/2) (con 1 v43 : tree/2)
  (return (app g7 v44)))))
