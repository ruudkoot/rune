(* after uncurry *)
(funs
  (fn g1 ((v1 : int)) : int -> int -> int "add3"
    (fun
      (fn v2 ((v3 : int) (v4 : int)) : int "add3"
        (let (v5 : int) v1
        (let (v6 : int) v3
        (let (v7 : int) v4
        (let (v8 : int) (prim int_add v5 v6 : (int * int) -> int)
        (return (prim int_add v8 v7 : (int * int) -> int)))))))
    (return v2)))
  (fn g2 ((v9 : int) (v10 : int) (v11 : int)) : int "add3"
    (let (v12 : int) v9
    (let (v13 : int) v10
    (let (v14 : int) v11
    (let (v15 : int) (prim int_add v12 v13 : (int * int) -> int)
    (return (prim int_add v15 v14 : (int * int) -> int))))))))
(funs
  (fn g3 ((v16 : int -> int -> int -> int)) : int "apply3"
    (let (v17 : int -> int -> int -> int) v16
    (return (app v17 1 2 3)))))
(val g4 : int
  (return (app g3 g2)))
(funs
  (fn g5 ((v18 : int)) : int -> int "scale"
    (let (v19 : int) v18
    (let (v20 : int) (prim int_mul v19 v19 : (int * int) -> int)
    (fun
      (fn v21 ((v22 : int)) : int
        (let (v23 : int) v22
        (return (prim int_mul v20 v23 : (int * int) -> int))))
    (return v21))))))
(funs
  (fn g6 ((v24 : int -> int -> int)) : int "apply2"
    (let (v25 : int -> int -> int) v24
    (return (app v25 2 3)))))
(val g7 : int
  (return (app g6 g5)))
