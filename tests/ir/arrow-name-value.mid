(* fail: the type (->) takes 2 arguments, not 1 *)
(* The arrow as a type name given fewer than two arguments is a type only as an argument (ruling 60): a value of
   it is refused, as of any type name given fewer arguments than it takes. *)
(val g1 : int (->)
  (return (prim unsafe_cast 1 : int -> int (->))))
