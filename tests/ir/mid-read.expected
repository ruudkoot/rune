(* after mid *)
(datatype shape () (0 "Dot") (1 "Box" : int * int))
(funs
  (fn g1 ((v1 : shape)) : int
    (join j1 ()
      (return 0)
    (let (v2 : int) (tag v1)
    (let (v3 : bool) (prim poly_eq v2 1 : (int * int) -> bool)
    (if v3
      (let (v4 : int * int) (decon 1 v1 : shape)
      (let (v5 : int) (select 0 v4)
      (let (v6 : int) (select 1 v4)
      (return (prim int_mul v5 v6 : (int * int) -> int)))))
      (jump j1)))))))
(val g2 : int
  (let (v7 : int * int) (tuple 3 4)
  (let (v8 : shape) (con 1 v7 : shape)
  (return (app g1 v8)))))
