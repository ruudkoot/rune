(* after simplify *)
(funs
  (fn g1 ((v1 : int -> int) (v2 : int list)) : int list "map"
    (case v2
      (0
        (return (con0 0 : int list)))
      (1
        (let (v3 : int * int list) (decon 1 v2 : int list)
        (let (v4 : int) (select 0 v3)
        (let (v5 : int list) (select 1 v3)
        (let (v6 : int) (app v1 v4)
        (let (v7 : int list) (app g1 v1 v5)
        (let (v8 : int * int list) (tuple v6 v7)
        (return (con 1 v8 : int list)))))))))
      (else
        (let (v9 : exncon) (builtinexn 0)
        (let (v10 : exn) (mkexn v9 ())
        (raise v10)))))))
(funs
  (fn g2 ((v11 : int) (v12 : int)) : int "fn"
    (return (prim int_add v12 v11 : (int * int) -> int)))
  (fn g3 ((v13 : int list) (v14 : int)) : int list "map"
    (case v13
      (0
        (return (con0 0 : int list)))
      (1
        (let (v15 : int * int list) (decon 1 v13 : int list)
        (let (v16 : int) (select 0 v15)
        (let (v17 : int list) (select 1 v15)
        (let (v18 : int) (prim int_add v16 v14 : (int * int) -> int)
        (let (v19 : int list) (app g3 v17 v14)
        (let (v20 : int * int list) (tuple v18 v19)
        (return (con 1 v20 : int list)))))))))
      (else
        (let (v21 : exncon) (builtinexn 0)
        (let (v22 : exn) (mkexn v21 ())
        (raise v22)))))))
(funs
  (fn g4 ((v23 : int) (v24 : int list)) : int list "add"
    (return (app g3 v24 v23))))
(val g5 : int list
  (let (v25 : int * int list) (tuple 2 (con0 0 : int list))
  (let (v26 : int list) (con 1 v25 : int list)
  (let (v27 : int * int list) (tuple 1 v26)
  (let (v28 : int list) (con 1 v27 : int list)
  (return (app g3 v28 3)))))))
