(* after simplify *)
(funs
  (fn g1 ((v1 : int -> int) (v2 : int list)) : int list "map"
    (case v2
      (0
        (return (con0 0 : int list)))
      (else
        (let (v3 : int * int list) (decon 1 v2 : int list)
        (let (v4 : int) (select 0 v3)
        (let (v5 : int list) (select 1 v3)
        (let (v6 : int) (app v1 v4)
        (let (v7 : int list) (app g1 v1 v5)
        (let (v8 : int * int list) (tuple v6 v7)
        (return (con 1 v8 : int list))))))))))))
(funs
  (fn g2 ((v9 : int) (v10 : int)) : int "fn"
    (return (prim int_add v10 v9 : (int * int) -> int)))
  (fn g3 ((v11 : int list) (v12 : int)) : int list "map"
    (case v11
      (0
        (return (con0 0 : int list)))
      (else
        (let (v13 : int * int list) (decon 1 v11 : int list)
        (let (v14 : int) (select 0 v13)
        (let (v15 : int list) (select 1 v13)
        (let (v16 : int) (prim int_add v14 v12 : (int * int) -> int)
        (let (v17 : int list) (app g3 v15 v12)
        (let (v18 : int * int list) (tuple v16 v17)
        (return (con 1 v18 : int list))))))))))))
(funs
  (fn g4 ((v19 : int) (v20 : int list)) : int list "add"
    (return (app g3 v20 v19))))
(val g5 : int list
  (let (v21 : int * int list) (tuple 2 (con0 0 : int list))
  (let (v22 : int list) (con 1 v21 : int list)
  (let (v23 : int * int list) (tuple 1 v22)
  (let (v24 : int list) (con 1 v23 : int list)
  (return (app g3 v24 3)))))))
