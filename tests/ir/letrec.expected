(* after translate *)
(seq
  (set g1
    (fn (v1 : int) : int
      (join j1 ()
        (let v2
          v1
          (app
            g1
            (prim int_sub v2 1)))
        (if
          (prim poly_eq v1 0)
          0
          (jump j1)))))
  (seq
    (set g2
      (letrec v3
        (fn (v4 : int) : int
          (join j2 ()
            (let v5
              v4
              (app
                v3
                (prim int_sub v5 1)))
            (if
              (prim poly_eq v4 0)
              0
              (jump j2))))
        (app v3 3)))
    ()))
