(* after mid *)
(funs
  (fn g1 ['a 'b] ((v1 : 'a * 'b)) : 'a "first"
    (let (v2 : 'a) (select 0 v1)
    (let (v3 : 'a) v2
    (return v3)))))
(do ((g2 : int) (g3 : string))
  (let (v4 : int * string) (tuple 1 "one")
  (let (v5 : int) (app g1[int, string] v4)
  (let (v6 : string * int) (tuple "two" 2)
  (let (v7 : string) (app g1[string, int] v6)
  (let (v8 : int * string) (tuple v5 v7)
  (let (v9 : int) (select 0 v8)
  (let (v10 : unit) (setglobal g2 v9)
  (let (v11 : string) (select 1 v8)
  (let (v12 : unit) (setglobal g3 v11)
  (return ())))))))))))
(funs
  (fn g4 ['c] ((v13 : 'c list)) : int "len"
    (join j1 ()
      (join j2 ()
        (let (v14 : exncon) (builtinexn 0)
        (let (v15 : exn) (mkexn v14 ())
        (raise v15)))
      (case v13
        (1
          (let (v16 : 'c * 'c list) (decon 1 v13 : 'c list)
          (let (v17 : 'c list) (select 1 v16)
          (let (v18 : 'c list) v17
          (let (v19 : int) (app g4['c] v18)
          (return (prim int_add 1 v19 : (int * int) -> int)))))))
        (else
          (jump j2))))
    (case v13
      (0
        (return 0))
      (else
        (jump j1))))))
(val g5 : exncon
  (return (newexn "E")))
(funs
  (fn g6 ((v20 : int)) : int "safe"
    (let (v21 : int) v20
    (join j3 ((v22 : int))
      (return (prim int_add 1 v22 : (int * int) -> int))
    (handle v23
      (let (v24 : bool) (prim poly_eq v21 0 : (int * int) -> bool)
      (if v24
        (let (v25 : exn) (mkexn g5 v21)
        (raise v25))
        (jump j3 v21)))
      (join j4 ()
        (raise v23)
      (let (v26 : exncon) (exncon v23)
      (let (v27 : bool) (prim ptr_eq v26 g5 : (exncon * exncon) -> bool)
      (if v27
        (let (v28 : int) (exnarg v23 : int)
        (let (v29 : int) v28
        (jump j3 v29)))
        (jump j4))))))))))
(val g7 : int
  (let (v30 : int) (app g6 0)
  (let (v31 : int * int list) (tuple g2 (con0 0 : int list))
  (let (v32 : int list) (con 1 v31 : int list)
  (let (v33 : int) (app g4[int] v32)
  (return (prim int_add v30 v33 : (int * int) -> int)))))))
