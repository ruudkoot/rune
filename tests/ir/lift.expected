(* after simplify *)
(funs
  (fn g1 ((v1 : int list) (v2 : int)) : int "go"
    (case v1
      (0
        (return v2))
      (else
        (let (v3 : int * int list) (decon 1 v1 : int list)
        (let (v4 : int) (select 0 v3)
        (let (v5 : int list) (select 1 v3)
        (let (v6 : int) (prim int_add v2 v4 : (int * int) -> int)
        (return (app g1 v5 v6))))))))))
(funs
  (fn g2 ((v7 : int list)) : int "sum"
    (return (app g1 v7 0))))
(funs
  (fn g3 ((v8 : int) (v9 : int list)) : int list "m"
    (case v9
      (0
        (return (con0 0 : int list)))
      (else
        (let (v10 : int * int list) (decon 1 v9 : int list)
        (let (v11 : int) (select 0 v10)
        (let (v12 : int list) (select 1 v10)
        (let (v13 : int) (prim int_mul v8 v11 : (int * int) -> int)
        (let (v14 : int list) (app g3 v8 v12)
        (let (v15 : int * int list) (tuple v13 v14)
        (return (con 1 v15 : int list))))))))))))
(funs
  (fn g4 ((v16 : int) (v17 : int list)) : int list "scale"
    (return (app g3 v16 v17))))
(funs
  (fn g5 ((v18 : int)) : int -> int "scale2"
    (fun
      (fn v19 ((v20 : int)) : int "keep"
        (return (prim int_mul v18 v20 : (int * int) -> int)))
    (return v19))))
(funs
  (fn g6 ((v21 : int -> int) (v22 : int)) : int "twice"
    (let (v23 : int) (app v21 v22)
    (return (app v21 v23)))))
(funs
  (fn g7 ((v24 : int)) : int
    (return (prim int_add v24 1 : (int * int) -> int))))
(funs
  (fn g8 ((v25 : int)) : int "addTwo"
    (return (app g6 g7 v25))))
(val g9 : int * int list * int * int
  (let (v26 : int * int list) (tuple 2 (con0 0 : int list))
  (let (v27 : int list) (con 1 v26 : int list)
  (let (v28 : int * int list) (tuple 1 v27)
  (let (v29 : int list) (con 1 v28 : int list)
  (let (v30 : int) (app g2 v29)
  (let (v31 : int * int list) (tuple 3 (con0 0 : int list))
  (let (v32 : int list) (con 1 v31 : int list)
  (let (v33 : int list) (app g4 2 v32)
  (let (v34 : int -> int) (app g5 4)
  (let (v35 : int) (app v34 5)
  (let (v36 : int) (app g8 6)
  (return (tuple v30 v33 v35 v36))))))))))))))
