(* run: alone *)
(* file_open's mode 3: a file opened to read and to write, kept where it
   is there and made where it is not, through one handle -- a read after a
   write and a write after a read, each turned by the runtime (C's streams
   want a seek between the two), a seek, the position -- on every VM. The
   files are made in the run's directory (RUNE_TEST_RUN), or here. A seek
   below 0 fails with EINVAL, not with what a call before it left (the
   open of a directory, EISDIR). *)
(datatype option ('a) (0 "NONE") (1 "SOME" : 'a))
(funs
  (fn gsay ((vsL : string) (vsS : string)) : unit "say"
    (let (vsA : string) (prim string_concat vsL vsS : (string * string) -> string)
    (let (vsB : string) (prim string_concat vsA "]\n" : (string * string) -> string)
    (let (vsU : unit) (prim print vsB : string -> unit)
    (return ())))))
  (fn gdir ((vdU : unit)) : string "dir"
    (let (vdO : string option) (prim os_getenv "RUNE_TEST_RUN" : string -> string option)
    (let (vdT : int) (tag vdO)
    (let (vdS : bool) (prim poly_eq vdT 1 : (int * int) -> bool)
    (if vdS (return (decon 1 vdO : string option)) (return "."))))))
  (fn gopen ((voP : string) (voM : int)) : int "open"
    (let (voO : int option) (prim file_open voP voM : (string * int) -> int option)
    (let (voT : int) (tag voO)
    (let (voS : bool) (prim poly_eq voT 1 : (int * int) -> bool)
    (if voS (return (decon 1 voO : int option)) (return ~1)))))))
(val gmain : unit
  (let (vD : string) (app gdir ())
  (let (vP : string) (prim string_concat vD "/ir-file-rw.tmp" : (string * string) -> string)
  (let (vQ : string) (prim string_concat vD "/ir-file-rw-new.tmp" : (string * string) -> string)
  (let (vR0 : int) (prim os_remove vQ : string -> int)
  (let (vH1 : int) (app gopen vP 1)
  (let (vW1 : bool) (prim file_write vH1 "hello world" : (int * string) -> bool)
  (let (vC1 : unit) (prim file_close vH1 : int -> unit)
  (let (vH : int) (app gopen vP 3)
  (let (vS1 : string) (prim file_read_vec vH 5 : (int * int) -> string)
  (let (vU1 : unit) (app gsay "read 5: [" vS1)
  (let (vW2 : bool) (prim file_write vH "-X-" : (int * string) -> bool)
  (let (vT1 : int) (prim file_tell vH : int -> int)
  (let (vT1S : string) (prim int_to_string vT1 : int -> string)
  (let (vU2 : unit) (app gsay "after the write, at: [" vT1S)
  (let (vS2 : string) (prim file_read_vec vH 100 : (int * int) -> string)
  (let (vU3 : unit) (app gsay "the rest: [" vS2)
  (let (vK1 : int) (prim file_seek vH 0 : (int * int) -> int)
  (let (vS3 : string) (prim file_read_vec vH 100 : (int * int) -> string)
  (let (vU4 : unit) (app gsay "from the start: [" vS3)
  (let (vW3 : bool) (prim file_write vH "!" : (int * string) -> bool)
  (let (vK2 : int) (prim file_seek vH 6 : (int * int) -> int)
  (let (vS4 : string) (prim file_read_vec vH 100 : (int * int) -> string)
  (let (vU5 : unit) (app gsay "from 6: [" vS4)
  (let (vHd : int) (app gopen vD 1)
  (let (vK4 : int) (prim file_seek vH ~1 : (int * int) -> int)
  (let (vE : int) (prim file_errno () : unit -> int)
  (let (vEn : string) (prim sys_error_name vE : int -> string)
  (let (vK4S : string) (prim int_to_string vK4 : int -> string)
  (let (vK4L : string) (prim string_concat vK4S " " : (string * string) -> string)
  (let (vK4E : string) (prim string_concat vK4L vEn : (string * string) -> string)
  (let (vU9 : unit) (app gsay "a seek below 0, after an open that failed: [" vK4E)
  (let (vC2 : unit) (prim file_close vH : int -> unit)
  (let (vH2 : int) (app gopen vP 3)
  (let (vS5 : string) (prim file_read_vec vH2 100 : (int * int) -> string)
  (let (vU6 : unit) (app gsay "opened again: [" vS5)
  (let (vC3 : unit) (prim file_close vH2 : int -> unit)
  (let (vH3 : int) (app gopen vQ 3)
  (let (vS6 : string) (prim file_read_vec vH3 100 : (int * int) -> string)
  (let (vU7 : unit) (app gsay "a new file: [" vS6)
  (let (vW4 : bool) (prim file_write vH3 "new" : (int * string) -> bool)
  (let (vK3 : int) (prim file_seek vH3 0 : (int * int) -> int)
  (let (vS7 : string) (prim file_read_vec vH3 100 : (int * int) -> string)
  (let (vU8 : unit) (app gsay "written and read back: [" vS7)
  (let (vC4 : unit) (prim file_close vH3 : int -> unit)
  (let (vR1 : int) (prim os_remove vP : string -> int)
  (let (vR2 : int) (prim os_remove vQ : string -> int)
  (return ()))))))))))))))))))))))))))))))))))))))))))))))))
