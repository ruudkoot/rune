(* after simplify *)
(val g1 : exncon
  (return (newexn "E")))
(funs
  (fn g2 ((v1 : bool * bool * bool)) : int
    (let (v2 : bool) (select 0 v1)
    (let (v3 : bool) (select 1 v1)
    (let (v4 : bool) (select 2 v1)
    (join j1 ()
      (return 1)
    (join j2 ()
      (return 2)
    (if v2
      (if v3
        (jump j1)
        (if v4
          (jump j1)
          (jump j2)))
      (jump j2)))))))))
(funs
  (fn g3 ((v5 : int)) : int
    (join j3 ((v6 : exn))
      (let (v7 : exncon) (exncon v6)
      (let (v8 : bool) (prim ptr_eq v7 g1 : (exncon * exncon) -> bool)
      (if v8
        (return 7)
        (raise v6))))
    (handle v9
      (let (v10 : bool) (prim poly_eq v5 0 : (int * int) -> bool)
      (if v10
        (let (v11 : exn) (mkexn g1 ())
        (jump j3 v11))
        (return (prim int_add v5 1 : (int * int) -> int))))
      (jump j3 v9)))))
(val g4 : int * int
  (let (v12 : bool * bool * bool) (tuple (con0 1 : bool) (con0 0 : bool) (con0 1 : bool))
  (let (v13 : int) (app g2 v12)
  (let (v14 : int) (app g3 3)
  (return (tuple v13 v14))))))
