(* run: alone *)
(* A Case of a variable in the defaults of Cases of it whose arms leave it one tag of its datatype: Simplify knows the
   tag, as in an arm of a Case of it, and the Case is its arm of that tag, from -O1 (case-excluded-dump.mid shows each
   so). The arm so taken takes the value apart (decon) under no test of that tag, only the else of the tests around it,
   which the shapes lint follows ("under a test of its tag, of the only constructor, or of the rest", docs/ir.md), here
   at level 3. Each function is called with each constructor, so a wrong arm prints, and calls itself in its first arm,
   so that it is not put in place of its calls and is compiled as written.
     g10  no default, one arm live (ruling 71's Case, with two tags): its arm of tag 1
     g11  a default, the arms around it leaving tag 1, of three: its arm of tag 1
     g12  three tests deep: the middle one, with two tags left, stays; the inner one is its arm of tag 2
     g13  three tags, two excluded by two tests, then a Case with no default: its arm of tag 2
     g14  a datatype at a type (string maybe): its arm of tag 1
     g15  three tags, one excluded: two are left, nothing folds, and C goes to the default
     g16  an exception, tested twice: no Case, and nothing known of the second test in the else of the first
     g17  a Case in a handler in the default: its arm of tag 1, taken apart in the handler's block, whose shapes know
          what held where it was pushed (case-in-handler.mid) *)
(datatype two () (0 "Lo") (1 "Hi" : int))
(datatype abc () (0 "A") (1 "B" : int) (2 "C" : int))
(datatype maybe ('a) (0 "Nothing") (1 "Just" : 'a))
(val gE1 : exncon (return (newexn "E1")))
(val gE2 : exncon (return (newexn "E2")))
(val gE3 : exncon (return (newexn "E3")))
(funs
  (fn g10 ((v10 : two)) : string
    (case v10
      (0
        (let (v11 : unit) (prim print "lo, then " : string -> unit)
        (let (v12 : two) (con 1 7 : two)
        (return (app g10 v12)))))
      (else
        (let (v13 : unit) (prim print "not lo: " : string -> unit)
        (case v10
          (0 (return "never\n"))
          (1
            (let (v14 : int) (decon 1 v10 : two)
            (let (v15 : bool) (prim int_lt v14 5 : (int * int) -> bool)
            (if v15 (return "hi below 5\n") (return "hi\n"))))))))))
  (fn g11 ((v20 : abc)) : string
    (case v20
      (0
        (let (v21 : unit) (prim print "a, then " : string -> unit)
        (let (v22 : abc) (con 1 2 : abc)
        (return (app g11 v22)))))
      (2 (return "c\n"))
      (else
        (let (v23 : unit) (prim print "b: " : string -> unit)
        (case v20
          (1
            (let (v24 : int) (decon 1 v20 : abc)
            (let (v25 : bool) (prim int_lt v24 5 : (int * int) -> bool)
            (if v25 (return "below 5\n") (return "5 or more\n")))))
          (else (return "never\n")))))))
  (fn g12 ((v30 : abc)) : string
    (case v30
      (0
        (let (v31 : unit) (prim print "a, then " : string -> unit)
        (let (v32 : abc) (con 2 9 : abc)
        (return (app g12 v32)))))
      (else
        (let (v33 : unit) (prim print "not a, " : string -> unit)
        (case v30
          (1
            (let (v34 : int) (decon 1 v30 : abc)
            (let (v35 : bool) (prim int_lt v34 5 : (int * int) -> bool)
            (if v35 (return "b below 5\n") (return "b\n")))))
          (else
            (let (v36 : unit) (prim print "not b, " : string -> unit)
            (case v30
              (2
                (let (v37 : int) (decon 2 v30 : abc)
                (let (v38 : bool) (prim int_lt v37 5 : (int * int) -> bool)
                (if v38 (return "c below 5\n") (return "c\n")))))
              (else (return "never\n"))))))))))
  (fn g13 ((v40 : abc)) : string
    (case v40
      (1
        (let (v41 : unit) (prim print "b, then " : string -> unit)
        (let (v42 : abc) (con 2 2 : abc)
        (return (app g13 v42)))))
      (else
        (let (v43 : unit) (prim print "not b, " : string -> unit)
        (case v40
          (0 (return "a\n"))
          (else
            (let (v44 : unit) (prim print "not a, " : string -> unit)
            (case v40
              (0 (return "never\n"))
              (1 (return "never\n"))
              (2
                (let (v45 : int) (decon 2 v40 : abc)
                (let (v46 : bool) (prim int_lt v45 5 : (int * int) -> bool)
                (if v46 (return "c below 5\n") (return "c\n")))))))))))))
  (fn g14 ((v50 : string maybe)) : string
    (case v50
      (0
        (let (v51 : unit) (prim print "nothing, then " : string -> unit)
        (let (v52 : string maybe) (con 1 "x\n" : string maybe)
        (return (app g14 v52)))))
      (else
        (let (v53 : unit) (prim print "just " : string -> unit)
        (case v50
          (1
            (let (v54 : string) (decon 1 v50 : string maybe)
            (return v54)))
          (else (return "never\n")))))))
  (fn g15 ((v60 : abc)) : string
    (case v60
      (0
        (let (v61 : unit) (prim print "a, then " : string -> unit)
        (let (v62 : abc) (con 2 1 : abc)
        (return (app g15 v62)))))
      (else
        (let (v63 : unit) (prim print "not a: " : string -> unit)
        (case v60
          (1
            (let (v64 : int) (decon 1 v60 : abc)
            (let (v65 : bool) (prim int_lt v64 5 : (int * int) -> bool)
            (if v65 (return "b below 5\n") (return "b\n")))))
          (else (return "c\n")))))))
  (fn g16 ((v70 : exn)) : string
    (let (v71 : exncon) (exncon v70)
    (let (v72 : bool) (prim ptr_eq v71 gE1 : (exncon * exncon) -> bool)
    (if v72
      (return "e1\n")
      (let (v73 : unit) (prim print "not e1: " : string -> unit)
      (let (v74 : exncon) (exncon v70)
      (let (v75 : bool) (prim ptr_eq v74 gE2 : (exncon * exncon) -> bool)
      (if v75 (return "e2\n") (return "neither\n")))))))))
  (fn gthrow ((v90 : unit)) : string
    (let (v91 : exn) (mkexn gE1 ())
    (raise v91)))
  (fn g17 ((v80 : two)) : string
    (case v80
      (0
        (let (v81 : unit) (prim print "lo, then " : string -> unit)
        (let (v82 : two) (con 1 7 : two)
        (return (app g17 v82)))))
      (else
        (handle v83
          (return (app gthrow ()))
          (case v80
            (1
              (let (v84 : int) (decon 1 v80 : two)
              (let (v85 : bool) (prim int_lt v84 5 : (int * int) -> bool)
              (if v85 (return "caught, hi below 5\n") (return "caught, hi\n")))))
            (else (return "never\n"))))))))
(val g1 : unit
  (let (v100 : string) (app g10 (con0 0 : two))
  (let (v101 : unit) (prim print v100 : string -> unit)
  (let (v102 : two) (con 1 2 : two)
  (let (v103 : string) (app g10 v102)
  (let (v104 : unit) (prim print v103 : string -> unit)
  (let (v105 : string) (app g11 (con0 0 : abc))
  (let (v106 : unit) (prim print v105 : string -> unit)
  (let (v107 : abc) (con 1 7 : abc)
  (let (v108 : string) (app g11 v107)
  (let (v109 : unit) (prim print v108 : string -> unit)
  (let (v110 : abc) (con 2 1 : abc)
  (let (v111 : string) (app g11 v110)
  (let (v112 : unit) (prim print v111 : string -> unit)
  (let (v113 : string) (app g12 (con0 0 : abc))
  (let (v114 : unit) (prim print v113 : string -> unit)
  (let (v115 : abc) (con 1 4 : abc)
  (let (v116 : string) (app g12 v115)
  (let (v117 : unit) (prim print v116 : string -> unit)
  (let (v118 : abc) (con 2 3 : abc)
  (let (v119 : string) (app g12 v118)
  (let (v120 : unit) (prim print v119 : string -> unit)
  (let (v121 : string) (app g13 (con0 0 : abc))
  (let (v122 : unit) (prim print v121 : string -> unit)
  (let (v123 : abc) (con 1 8 : abc)
  (let (v124 : string) (app g13 v123)
  (let (v125 : unit) (prim print v124 : string -> unit)
  (let (v126 : abc) (con 2 6 : abc)
  (let (v127 : string) (app g13 v126)
  (let (v128 : unit) (prim print v127 : string -> unit)
  (let (v129 : string) (app g14 (con0 0 : string maybe))
  (let (v130 : unit) (prim print v129 : string -> unit)
  (let (v131 : string maybe) (con 1 "y\n" : string maybe)
  (let (v132 : string) (app g14 v131)
  (let (v133 : unit) (prim print v132 : string -> unit)
  (let (v134 : string) (app g15 (con0 0 : abc))
  (let (v135 : unit) (prim print v134 : string -> unit)
  (let (v136 : abc) (con 1 3 : abc)
  (let (v137 : string) (app g15 v136)
  (let (v138 : unit) (prim print v137 : string -> unit)
  (let (v139 : abc) (con 2 8 : abc)
  (let (v140 : string) (app g15 v139)
  (let (v141 : unit) (prim print v140 : string -> unit)
  (let (v142 : exn) (mkexn gE1 ())
  (let (v143 : string) (app g16 v142)
  (let (v144 : unit) (prim print v143 : string -> unit)
  (let (v145 : exn) (mkexn gE2 ())
  (let (v146 : string) (app g16 v145)
  (let (v147 : unit) (prim print v146 : string -> unit)
  (let (v148 : exn) (mkexn gE3 ())
  (let (v149 : string) (app g16 v148)
  (let (v150 : unit) (prim print v149 : string -> unit)
  (let (v151 : string) (app g17 (con0 0 : two))
  (let (v152 : unit) (prim print v151 : string -> unit)
  (let (v153 : two) (con 1 3 : two)
  (let (v154 : string) (app g17 v153)
  (return (prim print v154 : string -> unit))))))))))))))))))))))))))))))))))))))))))))))))))))))))))
