            (let (v40 : t list) (select 1 v35)
            (let (v41 : bool) (prim ptr_eq v39 v40 : (t list * t list) -> bool)
            (if v41
              (return (con0 1 : bool))
              (return (app g1 v39 v40))))))
            (return (con0 0 : bool))))))))
          (return (con0 0 : bool))))))))
      (return (con0 0 : bool)))))))
  (fn g4 ((v42 : t) (v43 : t)) : bool
    (let (v44 : bool) (prim ptr_eq v42 v43 : (t * t) -> bool)
