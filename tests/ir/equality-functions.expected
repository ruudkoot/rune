(* after simplify *)
(datatype t () (0 "A") (1 "B" : int) (2 "C" : string * t list))
(funs
  (fn g1 ((v1 : t list) (v2 : t list)) : bool "="
    (let (v3 : int) (tag v1)
    (let (v4 : int) (tag v2)
    (let (v5 : bool) (prim imm_eq v3 v4 : (int * int) -> bool)
    (if v5
      (case v1
        (1
          (let (v6 : t * t list) (decon 1 v1 : t list)
          (let (v7 : t * t list) (decon 1 v2 : t list)
          (let (v8 : t) (select 0 v6)
          (let (v9 : t) (select 0 v7)
          (let (v10 : bool) (prim ptr_eq v8 v9 : (t * t) -> bool)
          (if v10
            (let (v11 : t list) (select 1 v6)
            (let (v12 : t list) (select 1 v7)
            (let (v13 : bool) (prim ptr_eq v11 v12 : (t list * t list) -> bool)
            (if v13
              (return (con0 1 : bool))
              (return (app g1 v11 v12))))))
            (let (v14 : bool) (app g2 v8 v9)
            (if v14
              (let (v15 : t list) (select 1 v6)
              (let (v16 : t list) (select 1 v7)
              (let (v17 : bool) (prim ptr_eq v15 v16 : (t list * t list) -> bool)
              (if v17
                (return (con0 1 : bool))
                (return (app g1 v15 v16))))))
              (return (con0 0 : bool)))))))))))
        (else
          (return (con0 0 : bool))))
      (return (con0 0 : bool)))))))
  (fn g3 ((v18 : t list) (v19 : t list)) : bool "="
    (let (v20 : bool) (prim ptr_eq v18 v19 : (t list * t list) -> bool)
    (if v20
      (return (con0 1 : bool))
      (return (app g1 v18 v19)))))
  (fn g2 ((v21 : t) (v22 : t)) : bool "="
    (let (v23 : int) (tag v21)
    (let (v24 : int) (tag v22)
    (let (v25 : bool) (prim imm_eq v23 v24 : (int * int) -> bool)
    (if v25
      (case v21
        (1
          (let (v26 : int) (decon 1 v21 : t)
          (let (v27 : int) (decon 1 v22 : t)
          (return (prim imm_eq v26 v27 : (int * int) -> bool)))))
        (2
          (let (v28 : string * t list) (decon 2 v21 : t)
          (let (v29 : string * t list) (decon 2 v22 : t)
          (let (v30 : string) (select 0 v28)
          (let (v31 : string) (select 0 v29)
          (let (v32 : bool) (prim string_eq v30 v31 : (string * string) -> bool)
          (if v32
            (let (v33 : t list) (select 1 v28)
            (let (v34 : t list) (select 1 v29)
            (let (v35 : bool) (prim ptr_eq v33 v34 : (t list * t list) -> bool)
            (if v35
              (return (con0 1 : bool))
              (return (app g1 v33 v34))))))
            (return (con0 0 : bool)))))))))
        (else
          (return (con0 0 : bool))))
      (return (con0 0 : bool)))))))
  (fn g4 ((v36 : t) (v37 : t)) : bool "="
    (let (v38 : bool) (prim ptr_eq v36 v37 : (t * t) -> bool)
    (if v38
      (return (con0 1 : bool))
      (return (app g2 v36 v37))))))
(funs
  (fn g5 ((v39 : t) (v40 : t)) : bool "same"
    (let (v41 : bool) (prim ptr_eq v39 v40 : (t * t) -> bool)
    (if v41
      (return (con0 1 : bool))
      (return (app g2 v39 v40))))))
(val g6 : bool * bool
  (let (v42 : t) (con 1 1 : t)
  (let (v43 : t) (con 1 1 : t)
  (let (v44 : bool) (prim ptr_eq v42 v43 : (t * t) -> bool)
  (if v44
    (let (v45 : t * t list) (tuple (con0 0 : t) (con0 0 : t list))
    (let (v46 : t list) (con 1 v45 : t list)
    (let (v47 : string * t list) (tuple "a" v46)
    (let (v48 : t) (con 2 v47 : t)
    (let (v49 : t) (con 1 2 : t)
    (let (v50 : t * t list) (tuple v49 (con0 0 : t list))
    (let (v51 : t list) (con 1 v50 : t list)
    (let (v52 : string * t list) (tuple "a" v51)
    (let (v53 : t) (con 2 v52 : t)
    (let (v54 : bool) (prim ptr_eq v48 v53 : (t * t) -> bool)
    (if v54
      (return (tuple (con0 1 : bool) (con0 1 : bool)))
      (let (v55 : bool) (app g2 v48 v53)
      (return (tuple (con0 1 : bool) v55))))))))))))))
    (let (v56 : bool) (app g2 v42 v43)
    (let (v57 : t * t list) (tuple (con0 0 : t) (con0 0 : t list))
    (let (v58 : t list) (con 1 v57 : t list)
    (let (v59 : string * t list) (tuple "a" v58)
    (let (v60 : t) (con 2 v59 : t)
    (let (v61 : t) (con 1 2 : t)
    (let (v62 : t * t list) (tuple v61 (con0 0 : t list))
    (let (v63 : t list) (con 1 v62 : t list)
    (let (v64 : string * t list) (tuple "a" v63)
    (let (v65 : t) (con 2 v64 : t)
    (let (v66 : bool) (prim ptr_eq v60 v65 : (t * t) -> bool)
    (if v66
      (return (tuple v56 (con0 1 : bool)))
      (let (v67 : bool) (app g2 v60 v65)
      (return (tuple v56 v67))))))))))))))))))))
