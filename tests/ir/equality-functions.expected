(val g6 : bool * bool
  (let (v48 : t) (con 1 1 : t)
  (let (v49 : t) (con 1 1 : t)
  (let (v50 : bool) (prim ptr_eq v48 v49 : (t * t) -> bool)
  (if v50
    (let (v51 : t * t list) (tuple (con0 0 : t) (con0 0 : t list))
    (let (v52 : t list) (con 1 v51 : t list)
