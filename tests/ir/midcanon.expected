(* after midcanon *)
(datatype tree ('a) (0 "Leaf") (1 "Node" : 'a tree * 'a * 'a tree))
(funs
  (fn g1 ['b] ((v1 : 'b tree)) : int "size"
    (join j1 ()
      (join j2 ()
        (let (v2 : exncon) (builtinexn 0)
        (let (v3 : exn) (mkexn v2 ())
        (raise v3)))
      (case v1
        (1
          (let (v4 : 'b tree * 'b * 'b tree) (decon 1 v1 : 'b tree)
          (let (v5 : 'b tree) (select 0 v4)
          (let (v6 : 'b tree) v5
          (let (v7 : 'b tree) (select 2 v4)
          (let (v8 : 'b tree) v7
          (let (v9 : int) (app g1['b] v6)
          (let (v10 : int) (prim int_add v9 1 : (int * int) -> int)
          (let (v11 : int) (app g1['b] v8)
          (return (prim int_add v10 v11 : (int * int) -> int)))))))))))
        (else
          (jump j2))))
    (case v1
      (0
        (return 0))
      (else
        (jump j1))))))
(val g2 : int
  (let (v12 : string tree * string * string tree) (tuple (con0 0 : string tree) "x" (con0 0 : string tree))
  (let (v13 : string tree) (con 1 v12 : string tree)
  (return (app g1[string] v13)))))
