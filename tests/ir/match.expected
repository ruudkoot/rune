(* after translate *)
(seq
  (set g1
    (fn (v1 : 'a list) : int
      (join j1 ()
        (join j2 ()
          (raise
            (mkexn (builtinexn 0) ()))
          (if
            (prim poly_eq
              (tag v1)
              1)
            (let v2
              (decon 1 v1)
              (let v3
                (select 1 v2)
                (let v4
                  v3
                  (prim int_add
                    1
                    (app g1 v4)))))
            (jump j2)))
        (if
          (prim poly_eq
            (tag v1)
            0)
          0
          (jump j1)))))
  ())
