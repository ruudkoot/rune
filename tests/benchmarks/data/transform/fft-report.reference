cat - <<'end' > fft.dir/v.m
|| fft.dir v = v
||
%include "~pieter/lib/fast2mira.m"
%include "~pieter/mira/synch/misc.m"
%include "~pieter/mira/fft/fftaux.m"
%include "~pieter/mira/fft/fftnet.m"
||
output	= (map_4 concat4 as bs cs ds);
as	= ((:) xs0 (map_6 fftstep0 ns ms ixs as bs cs));
bs	= ((:) xs1 (map_7 fftstep1 ns ms ixs cs bs as ds));
cs	= ((:) xs2 (map_7 fftstep2 ns ms ixs bs cs ds as));
ds	= ((:) xs3 (map_6 fftstep3 ns ms ixs ds cs bs));
ixs	= ((:) (reorderindex (# netinput div 4)) ixs);
ms	= ((:) (# netinput div 4) ms);
ns	= ((:) 0 (map_1 incmod5 ns));
end
cat - <<'end' > fft.dir/v0.m
|| fft.dir v0 = inl v
||
%include "~pieter/lib/fast2mira.m"
%include "~pieter/mira/synch/misc.m"
%include "~pieter/mira/fft/fftaux.m"
%include "~pieter/mira/fft/fftnet.m"
||
output	= (map_4 concat4 as bs cs ds);
as	= ((:) xs0 (map_6 fftstep0 ns ms ixs as bs cs));
bs	= ((:) xs1 (map_7 fftstep1 ns ms ixs cs bs as ds));
cs	= ((:) xs2 (map_7 fftstep2 ns ms ixs bs cs ds as));
ds	= ((:) xs3 (map_6 fftstep3 ns ms ixs ds cs bs));
ixs	= ((:) (reorderindex (# netinput div 4)) ixs);
ms	= ((:) (# netinput div 4) ms);
ns	= ((:) 0 (map_1 incmod5 ns));
end
cat - <<'end' > fft.dir/v1.m
|| fft.dir v1 = t1 v0
||
%include "~pieter/lib/fast2mira.m"
%include "~pieter/mira/synch/misc.m"
%include "~pieter/mira/fft/fftaux.m"
%include "~pieter/mira/fft/fftnet.m"
||
output	= (map_4 concat4 as bs cs ds);
as	= ((:) xs0 xxa3);
bs	= ((:) xs1 xxa7);
cs	= ((:) xs2 xxa11);
ds	= ((:) xs3 xxa15);
ixs	= ((:) (reorderindex (# netinput div 4)) ixs);
ms	= ((:) (# netinput div 4) ms);
ns	= ((:) 0 xxa23);
xxa11	= (map_7 fftstep2 ns ms ixs bs cs ds as);
xxa15	= (map_6 fftstep3 ns ms ixs ds cs bs);
xxa23	= (map_1 incmod5 ns);
xxa3	= (map_6 fftstep0 ns ms ixs as bs cs);
xxa7	= (map_7 fftstep1 ns ms ixs cs bs as ds);
end
cat - <<'end' > fft.dir/v3.m
|| fft.dir v3 = t3 v1
||
%include "~pieter/lib/fast2mira.m"
%include "~pieter/mira/synch/misc.m"
%include "~pieter/mira/fft/fftaux.m"
%include "~pieter/mira/fft/fftnet.m"
||
output	= (map_4 concat4 as bs cs ds);
as	= ((:) xs0 xxa3);
bs	= ((:) xs1 xxa7);
cs	= ((:) xs2 xxa11);
ds	= ((:) xs3 xxa15);
ixs	= ((:) (reorderindex (# netinput div 4)) ixs);
ms	= ((:) (# netinput div 4) ms);
ns	= ((:) 0 xxa23);
xxa11	= (map_7 fftstep2 ns ms ixs bs cs ds as);
xxa15	= (map_6 fftstep3 ns ms ixs ds cs bs);
xxa23	= (map_1 incmod5 ns);
xxa3	= (map_6 fftstep0 ns ms ixs as bs cs);
xxa7	= (map_7 fftstep1 ns ms ixs cs bs as ds);
end
cat - <<'end' > fft.dir/v5.m
|| fft.dir v5 = t5 v3
||
%include "~pieter/lib/fast2mira.m"
%include "~pieter/mira/synch/misc.m"
%include "~pieter/mira/fft/fftaux.m"
%include "~pieter/mira/fft/fftnet.m"
||
output	= ((:) (concat4 (hd as) (hd bs) (hd cs) (hd ds)) xxv1);
as	= ((:) xs0 xxa3);
bs	= ((:) xs1 xxa7);
cs	= ((:) xs2 xxa11);
ds	= ((:) xs3 xxa15);
ixs	= ((:) (reorderindex (# netinput div 4)) ixs);
ms	= ((:) (# netinput div 4) ms);
ns	= ((:) 0 xxa23);
xxv1	= (map_4 concat4 xxa3 xxa7 xxa11 xxa15);
xxa11	= (map_7 fftstep2 ns ms ixs bs cs ds as);
xxa15	= (map_6 fftstep3 ns ms ixs ds cs bs);
xxa23	= (map_1 incmod5 ns);
xxa3	= (map_6 fftstep0 ns ms ixs as bs cs);
xxa7	= (map_7 fftstep1 ns ms ixs cs bs as ds);
end
cat - <<'end' > fft.dir/v6.m
|| fft.dir v6 = t6 v5
||
%include "~pieter/lib/fast2mira.m"
%include "~pieter/mira/synch/misc.m"
%include "~pieter/mira/fft/fftaux.m"
%include "~pieter/mira/fft/fftnet.m"
||
output1	= (map_1 sel_8 (maps_0 id_1 nextstate ((concat4 (hd as) (hd bs) (hd cs) (hd ds)),xs0,xs1,xs2,xs3,(reorderindex (# netinput div 4)),(# netinput div 4),0) ));
nextstate s
= (xxv1,xxa3,xxa7,xxa11,xxa15,ixs,ms,xxa23)
  where
  (output,as,bs,cs,ds,ixs,ms,ns)	= s;
  xxa11	= (fftstep2 ns ms ixs bs cs ds as);
  xxa15	= (fftstep3 ns ms ixs ds cs bs);
  xxa23	= (incmod5 ns);
  xxa3	= (fftstep0 ns ms ixs as bs cs);
  xxa7	= (fftstep1 ns ms ixs cs bs as ds);
  xxv1	= (concat4 xxa3 xxa7 xxa11 xxa15);;
output	= ((:) (concat4 (hd as) (hd bs) (hd cs) (hd ds)) xxv1);
as	= ((:) xs0 xxa3);
bs	= ((:) xs1 xxa7);
cs	= ((:) xs2 xxa11);
ds	= ((:) xs3 xxa15);
ixs	= ((:) (reorderindex (# netinput div 4)) ixs);
ms	= ((:) (# netinput div 4) ms);
ns	= ((:) 0 xxa23);
xxv1	= (map_4 concat4 xxa3 xxa7 xxa11 xxa15);
xxa11	= (map_7 fftstep2 ns ms ixs bs cs ds as);
xxa15	= (map_6 fftstep3 ns ms ixs ds cs bs);
xxa23	= (map_1 incmod5 ns);
xxa3	= (map_6 fftstep0 ns ms ixs as bs cs);
xxa7	= (map_7 fftstep1 ns ms ixs cs bs as ds);
end
