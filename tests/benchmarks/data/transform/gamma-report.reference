p2	= (map_1 map_divides p1);
p3	= (map_2 select p2 p1);
p4	= (map_2 (--) p0 p3);
p5	= (map_1 remove1 p3);
p6	= (map_2 (++) p5 p4);
p7	= (map_1 or p2);
p8	= (map_1 (~) p7);
p9	= (map_2 mkpair p8 p0);
map_divides xs	= (map1 divides xs);
mkpair a b	= (a,b);
perm_2 xs	= (perm 2 xs);
end
