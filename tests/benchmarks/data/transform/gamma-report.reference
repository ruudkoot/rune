cat - <<'end' > gamma.dir/v5.m
|| gamma.dir v5 = t5 v3
||
%include "~pieter/lib/fast2mira.m"
%include "~pieter/mira/synch/misc.m"
%include "~pieter/mira/gamma/gamma.m"
||
output	= ((:) dummy_output p9);
p0	= ((:) lownumbers p6);
p1	= (map_1 perm_2 p0);
p2	= (map_1 map_divides p1);
p3	= (map_2 select p2 p1);
p4	= (map_2 (--) p0 p3);
p5	= (map_1 remove1 p3);
p6	= (map_2 (++) p5 p4);
p7	= (map_1 or p2);
p8	= (map_1 (~) p7);
