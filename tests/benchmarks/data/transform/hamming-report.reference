cat - <<'end' > hamming.dir/v.m
|| hamming.dir v = v
||
%include "~pieter/lib/fast2mira.m"
%include "~pieter/mira/synch/misc.m"
%include "~pieter/mira/hamming/hamming.m"
||
output	= ((:) 1 (maps_2 hamFo hamFs hams0 ham2s ham3s));
ham2s	= (map ((*) 2) output);
ham3s	= (map ((*) 3) output);
hamFo s a b	= (fst (hamstat s a b));
hamFs s a b	= (snd (hamstat s a b));
end
cat - <<'end' > hamming.dir/v0.m
|| hamming.dir v0 = inl v
||
%include "~pieter/lib/fast2mira.m"
%include "~pieter/mira/synch/misc.m"
%include "~pieter/mira/hamming/hamming.m"
||
output	= ((:) 1 (maps_2 hamFo hamFs hams0 ham2s ham3s));
ham2s	= (map ((*) 2) output);
ham3s	= (map ((*) 3) output);
hamFo s a b	= (fst (hamstat s a b));
hamFs s a b	= (snd (hamstat s a b));
end
cat - <<'end' > hamming.dir/v1.m
|| hamming.dir v1 = t1 v0
||
%include "~pieter/lib/fast2mira.m"
%include "~pieter/mira/synch/misc.m"
%include "~pieter/mira/hamming/hamming.m"
||
output	= ((:) 1 xxa1);
ham2s	= (map ((*) 2) output);
ham3s	= (map ((*) 3) output);
xxa1	= (maps_2 hamFo hamFs hams0 ham2s ham3s);
hamFo s a b	= (fst (hamstat s a b));
hamFs s a b	= (snd (hamstat s a b));
end
cat - <<'end' > hamming.dir/v3.m
|| hamming.dir v3 = t3 v1
||
%include "~pieter/lib/fast2mira.m"
%include "~pieter/mira/synch/misc.m"
%include "~pieter/mira/hamming/hamming.m"
||
output	= ((:) 1 xxa1);
ham2s	= (map ((*) 2) output);
ham3s	= (map ((*) 3) output);
xxa1	= (map_3 hamFo xxb3 ham2s ham3s);
xxb3	= ((:) hams0 xxc3);
xxc3	= (map_3 hamFs xxb3 ham2s ham3s);
hamFo s a b	= (fst (hamstat s a b));
hamFs s a b	= (snd (hamstat s a b));
end
cat - <<'end' > hamming.dir/v5.m
|| hamming.dir v5 = t5 v3
||
%include "~pieter/lib/fast2mira.m"
%include "~pieter/mira/synch/misc.m"
%include "~pieter/mira/hamming/hamming.m"
||
output	= ((:) 1 xxa1);
xxb3	= ((:) hams0 xxc3);
xxa1	= (map_3 hamFo xxb3 ham2s ham3s);
xxc3	= (map_3 hamFs xxb3 ham2s ham3s);
ham2s	= (map ((*) 2) output);
ham3s	= (map ((*) 3) output);
hamFo s a b	= (fst (hamstat s a b));
hamFs s a b	= (snd (hamstat s a b));
end
cat - <<'end' > hamming.dir/v6.m
|| hamming.dir v6 = t6 v5
||
%include "~pieter/lib/fast2mira.m"
%include "~pieter/mira/synch/misc.m"
%include "~pieter/mira/hamming/hamming.m"
||
output1	= (map_1 sel_2 (maps_2 id_3 nextstate (1,hams0) ham2s ham3s));
nextstate s ham2s ham3s
= (xxa1,xxc3)
  where
  (output,xxb3)	= s;
  xxa1	= (fst (hamstat xxb3 ham2s ham3s));
  xxc3	= (snd (hamstat xxb3 ham2s ham3s));;
output	= ((:) 1 xxa1);
xxb3	= ((:) hams0 xxc3);
xxa1	= (map_3 hamFo xxb3 ham2s ham3s);
xxc3	= (map_3 hamFs xxb3 ham2s ham3s);
ham2s	= (map ((*) 2) output);
ham3s	= (map ((*) 3) output);
hamFo s a b	= (fst (hamstat s a b));
hamFs s a b	= (snd (hamstat s a b));
end
