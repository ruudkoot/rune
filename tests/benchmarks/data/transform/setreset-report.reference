cat - <<'end' > setreset.dir/v.m
|| setreset.dir v = v
||
%include "~pieter/lib/fast2mira.m"
%include "~pieter/mira/synch/misc.m"
%include "~pieter/mira/setreset/setreset.m"
||
output	= ((:) 1 as);
as	= (nand 0 ds bs);
bs	= (nand 1 as cs);
nand s xs ys	= (maps_2 one_of_three notand s xs ys);
notand s a b	= (bnot (band a b));
one_of_three x y z	= x;
end
cat - <<'end' > setreset.dir/v0.m
|| setreset.dir v0 = inl v
||
%include "~pieter/lib/fast2mira.m"
%include "~pieter/mira/synch/misc.m"
%include "~pieter/mira/setreset/setreset.m"
||
output	= ((:) 1 as);
as	= (maps_2 one_of_three notand 0 ds bs);
bs	= (maps_2 one_of_three notand 1 as cs);
nand s xs ys	= (maps_2 one_of_three notand s xs ys);
notand s a b	= (bnot (band a b));
one_of_three x y z	= x;
end
cat - <<'end' > setreset.dir/v1.m
|| setreset.dir v1 = t1 v0
||
%include "~pieter/lib/fast2mira.m"
%include "~pieter/mira/synch/misc.m"
%include "~pieter/mira/setreset/setreset.m"
||
output	= ((:) 1 as);
as	= (maps_2 one_of_three notand 0 ds bs);
bs	= (maps_2 one_of_three notand 1 as cs);
nand s xs ys	= (maps_2 one_of_three notand s xs ys);
notand s a b	= (bnot (band a b));
one_of_three x y z	= x;
end
cat - <<'end' > setreset.dir/v3.m
|| setreset.dir v3 = t3 v1
||
%include "~pieter/lib/fast2mira.m"
%include "~pieter/mira/synch/misc.m"
%include "~pieter/mira/setreset/setreset.m"
||
output	= ((:) 1 as);
as	= (map_3 one_of_three xxb3 ds bs);
bs	= (map_3 one_of_three xxb5 as cs);
xxb3	= ((:) 0 xxc3);
xxb5	= ((:) 1 xxc5);
xxc3	= (map_3 notand xxb3 ds bs);
xxc5	= (map_3 notand xxb5 as cs);
nand s xs ys	= (maps_2 one_of_three notand s xs ys);
notand s a b	= (bnot (band a b));
one_of_three x y z	= x;
end
cat - <<'end' > setreset.dir/v5.m
|| setreset.dir v5 = t5 v3
||
%include "~pieter/lib/fast2mira.m"
%include "~pieter/mira/synch/misc.m"
%include "~pieter/mira/setreset/setreset.m"
||
output	= ((:) 1 as);
xxb3	= ((:) 0 xxc3);
xxb5	= ((:) 1 xxc5);
as	= (map_3 one_of_three xxb3 ds bs);
bs	= (map_3 one_of_three xxb5 as cs);
xxc3	= (map_3 notand xxb3 ds bs);
xxc5	= (map_3 notand xxb5 as cs);
nand s xs ys	= (maps_2 one_of_three notand s xs ys);
notand s a b	= (bnot (band a b));
one_of_three x y z	= x;
end
cat - <<'end' > setreset.dir/v6.m
|| setreset.dir v6 = t6 v5
||
%include "~pieter/lib/fast2mira.m"
%include "~pieter/mira/synch/misc.m"
%include "~pieter/mira/setreset/setreset.m"
||
output1	= (map_1 sel_3 (maps_2 id_3 nextstate (1,0,1) cs ds));
nextstate s cs ds
= (as,xxc3,xxc5)
  where
  (output,xxb3,xxb5)	= s;
  as	= xxb3;
  bs	= xxb5;
  xxc3	= (bnot (band ds bs));
  xxc5	= (bnot (band as cs));;
output	= ((:) 1 as);
xxb3	= ((:) 0 xxc3);
xxb5	= ((:) 1 xxc5);
as	= (map_3 one_of_three xxb3 ds bs);
bs	= (map_3 one_of_three xxb5 as cs);
xxc3	= (map_3 notand xxb3 ds bs);
xxc5	= (map_3 notand xxb5 as cs);
nand s xs ys	= (maps_2 one_of_three notand s xs ys);
notand s a b	= (bnot (band a b));
one_of_three x y z	= x;
end
