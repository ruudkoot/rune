.file "guess.c"
f:
	pushfl
	addl $1,cacheprof_icount
	adcl $0,4+cacheprof_icount
	popfl
	pushl %eax
	pushl %ebx
	leal (%eax),%eax
	movl $.Lcacheprof_magic_buckets+0,%ebx
	call cacheprof_hook_Rd4
	popl %ebx
	popl %eax
	movl (%eax),%ebx
	# 
	# ---- start of the cost centers ----
	# file names:
	#    dir/source_file.c
	# canonicalised function names:
	#    fn(dir/source_file.c)
	# raw source points:
	#    CC "dir/source_file.c" 123 "fn"
	# cooked source points:
	#    (0,123,0)
	.data
	.align 4
.Lcacheprof_magic_table:
	# number of filenames, funcnames, points, cc addr
	.long 1
	.long 1
	.long 1
	.long .Lcacheprof_magic_buckets
	# "dir/source_file.c"
	.byte 100
	.byte 105
	.byte 114
	.byte 47
	.byte 115
	.byte 111
	.byte 117
	.byte 114
	.byte 99
	.byte 101
	.byte 95
	.byte 102
	.byte 105
	.byte 108
	.byte 101
	.byte 46
	.byte 99
	.byte 0
	# "fn(dir/source_file.c)"
	.byte 102
	.byte 110
	.byte 40
	.byte 100
	.byte 105
	.byte 114
	.byte 47
	.byte 115
	.byte 111
	.byte 117
	.byte 114
	.byte 99
	.byte 101
	.byte 95
	.byte 102
	.byte 105
	.byte 108
	.byte 101
	.byte 46
	.byte 99
	.byte 41
	.byte 0
	.align 4
.Lcacheprof_magic_buckets:
	# (0,123,0)
	.long 0
	.long 123
	.long 0
	.long 0
	.long 0
	.long 0
	.long 0
	# 
	# ---- end of the cost centers ----
