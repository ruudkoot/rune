structure SymalgTests=struct
 structure N=BenchSymalgFn(BenchNeed)
 structure E=BenchSymalgFn(BenchStrict)
 structure NC=BenchSymalgCheckFn(N)
 structure EC=BenchSymalgCheckFn(E)
 fun check name f=T.check("symalg/"^name,f)
 fun read file=let val f=TextIO.openIn file in TextIO.inputAll f before TextIO.closeIn f end
 val commands=String.fields(fn c=>c= #"\n")(read"commands.stdin")
 val _=check"original-commands/N"(fn()=>N.transcript commands=read"commands.stdout")
 val _=check"full-original-smoke/N"(fn()=>NC.run["smoke.stdin","smoke.numbers.reference","smoke.stdout"]="11:242")
 val _=check"zero-product-skips-msd-zero/N"(fn()=>N.B.R.eval(N.B.R.multiply(N.B.R.fromInteger 0)(N.B.R.fromInteger 0))(~10)=0)
 val _=check"memoized-approximation-tree/N"(fn()=>
 let val count=ref 0
     val tree=N.B.R.mapTree(fn x=>(count:= !count+1;x))N.B.R.numberTree
     val real=N.B.R.Real tree
     val first=N.B.R.eval real(~4)
     val once= !count
     val second=N.B.R.eval real(~4)
 in first=second andalso once>0 andalso !count=once end)
 val _=check"original-commands/E"(fn()=>E.transcript commands=read"commands.stdout")
 val _=check"full-original-smoke/E"(fn()=>EC.run["smoke.stdin","smoke.numbers.reference","smoke.stdout"]="11:242")
 val _=check"zero-product-skips-msd-zero/E"(fn()=>E.B.R.eval(E.B.R.multiply(E.B.R.fromInteger 0)(E.B.R.fromInteger 0))(~10)=0)
 val _=check"memoized-approximation-tree/E"(fn()=>
 let val count=ref 0
     val tree=E.B.R.mapTree(fn x=>(count:= !count+1;x))E.B.R.numberTree
     val real=E.B.R.Real tree
     val first=E.B.R.eval real(~4)
     val once= !count
     val second=E.B.R.eval real(~4)
 in first=second andalso once>0 andalso !count=once end)
 val _=check"reject-smoke-corrupt.numbers.reference"(fn()=>((NC.run["smoke.stdin","smoke-corrupt.numbers.reference","smoke.stdout"];false)handle Fail why=>String.isPrefix"incorrect result:"why))
 val _=check"reject-smoke-corrupt.stdout"(fn()=>((NC.run["smoke.stdin","smoke.numbers.reference","smoke-corrupt.stdout"];false)handle Fail why=>String.isPrefix"incorrect result:"why))
end
