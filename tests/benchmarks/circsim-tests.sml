structure NeedCircuit=BenchCircsimFn(BenchNeed)
structure StrictCircuit=BenchCircsimFn(BenchStrict)
structure NeedDriver=BenchCircsimDriverFn(NeedCircuit)
structure StrictDriver=BenchCircsimDriverFn(StrictCircuit)
structure CircuitTests =
struct
  structure N=NeedCircuit
  structure R=StrictCircuit
  structure L=BenchLazy
  structure S=BenchStream
  fun read name=let val f=TextIO.openIn name val value=TextIO.inputAll f val _=TextIO.closeIn f in value end
  fun sourceCode s=CharVector.foldl(fn(c,sum)=>sum+Char.ord c)0 s+String.size s
  fun valuesN xs=(case BenchNeed.force xs of N.Nil=>[]|N.Cons(x,rest)=>BenchNeed.force x::valuesN rest)
  fun valuesR xs=(case BenchStrict.force xs of R.Nil=>[]|R.Cons(x,rest)=>BenchStrict.force x::valuesR rest)
  fun matrixN xs=(case BenchNeed.force xs of N.Nil=>[]|N.Cons(row,rest)=>valuesN row::matrixN rest)
  fun matrixR xs=(case BenchStrict.force xs of R.Nil=>[]|R.Cons(row,rest)=>valuesR row::matrixR rest)
  fun rowsN path=N.cells(List.map(fn row=>N.cells(List.map(fn c=>BenchNeed.delay(fn()=>if c= #"T"then N.T else N.F))(String.explode row)))(String.tokens Char.isSpace(read path)))
  fun rowsR path=R.cells(List.map(fn row=>R.cells(List.map(fn c=>BenchStrict.delay(fn()=>if c= #"T"then R.T else R.F))(String.explode row)))(String.tokens Char.isSpace(read path)))
