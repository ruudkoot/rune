  val _=T.check("circuit/unused-label-names",fn()=>
    let val {size,inputs,outputs,states}=BenchNeed.force(N.regs 8)
        fun poison labels=N.map(fn label=>BenchNeed.delay(fn()=>
          let val(_,pid)=BenchNeed.force label in(BenchNeed.delay(fn()=>raise Fail "unused label"),pid)end))labels
        val circuit=BenchNeed.delay(fn()=>{size=size,inputs=poison inputs,outputs=poison outputs,states=states})
        val trace=N.circuitSimulate(N.replicate 4(N.replicate 9 N.one))(N.pad circuit)
    in N.consume false(N.renderChecked(read "smoke.show")trace)=(73,0)end)
  val _=T.check("circuit/unused-upsweep-root-summary",fn()=>
    let val input=N.cells(List.tabulate(4,fn _=>BenchNeed.delay(fn()=>1)))
        fun up(a,b)=BenchNeed.delay(fn()=>let val n=BenchNeed.force a+BenchNeed.force b in if n=4 then raise Fail "unused root"else n end)
        fun down(left,right,seed)=BenchNeed.delay(fn()=>(seed,BenchNeed.delay(fn()=>BenchNeed.force seed+BenchNeed.force left)))
        val result=N.sweep up down(BenchNeed.delay(fn()=>0))(N.put input)
    in valuesN(N.get(N.second result))=[0,1,2,3]end)
