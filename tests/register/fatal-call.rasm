# A fatal error of compiled code (scripts/check-jit.sh): a call of a value
# that is no closure, in a function the JIT compiles.
const start string "start\n"
globals 1

function main 6
  CONST 1 %start
  PRIM print 2 1
  INT 1 5
  CALLK &callit 1 1
  RESULT 3
  HALT

function callit 4
  INT 1 7
  PRIM int_add 2 0 1
  CALL 2 1
  RESULT 3
  RET 3
