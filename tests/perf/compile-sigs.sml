(* Names ten signatures of the library, so that the compiler loads their
   files, which carry the library's documentation: what doc comments cost a
   program that uses signatures (docs/plans/docgen.md, D1). *)
signature S01 = LIST
signature S02 = STRING
signature S03 = CHAR
signature S04 = INTEGER
signature S05 = WORD
signature S06 = REAL
signature S07 = OPTION
signature S08 = ARRAY
signature S09 = VECTOR
signature S10 = TEXT_IO
