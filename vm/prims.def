# Rune VM primitives. Single source of truth.
# Format:  NAME  ARITY  TYPE  DESCRIPTION
# Primitive numbers are assigned in order starting at 0 by scripts/gen-opcodes.sh.
# TYPE is documentation only (the prelude supplies the SML type via `_prim "name" : ty`).
# Primitives that return an option rely on the prelude declaring
#   datatype 'a option = NONE | SOME of 'a   (NONE = tag 0, SOME = tag 1).
# Changing this file requires updating docs/bytecode.md (checked by make check-docs).

# --- polymorphic ---
poly_eq          2  'a * 'a -> bool          Structural equality (refs/arrays by identity).
ptr_eq           2  'a * 'a -> bool          Identity comparison of heap values.

# --- int (64-bit, Overflow checked) ---
int_add          2  int * int -> int         Addition; raises Overflow.
int_sub          2  int * int -> int         Subtraction; raises Overflow.
int_mul          2  int * int -> int         Multiplication; raises Overflow.
int_div          2  int * int -> int         Floor division; raises Div, Overflow.
int_mod          2  int * int -> int         Floor modulus; raises Div.
int_quot         2  int * int -> int         Truncating division; raises Div, Overflow.
int_rem          2  int * int -> int         Truncating remainder; raises Div.
int_neg          1  int -> int               Negation; raises Overflow.
int_abs          1  int -> int               Absolute value; raises Overflow.
int_lt           2  int * int -> bool        Less than.
int_le           2  int * int -> bool        Less or equal.
int_gt           2  int * int -> bool        Greater than.
int_ge           2  int * int -> bool        Greater or equal.
int_to_string    1  int -> string            Decimal rendering with ~ for negative.
int_from_string  1  string -> int option     Parse an SML integer literal (decimal).
int_to_char      1  int -> char              Raises Chr if out of range 0..255.
int_to_real      1  int -> real              Conversion.

# --- word (64-bit unsigned) ---
word_add         2  word * word -> word      Wrapping addition.
word_sub         2  word * word -> word      Wrapping subtraction.
word_mul         2  word * word -> word      Wrapping multiplication.
word_div         2  word * word -> word      Division; raises Div.
word_mod         2  word * word -> word      Modulus; raises Div.
word_lt          2  word * word -> bool      Unsigned less than.
word_le          2  word * word -> bool      Unsigned less or equal.
word_gt          2  word * word -> bool      Unsigned greater than.
word_ge          2  word * word -> bool      Unsigned greater or equal.
word_andb        2  word * word -> word      Bitwise and.
word_orb         2  word * word -> word      Bitwise or.
word_xorb        2  word * word -> word      Bitwise xor.
word_notb        1  word -> word             Bitwise complement.
word_lsl         2  word * word -> word      Logical shift left.
word_lsr         2  word * word -> word      Logical shift right.
word_to_int      1  word -> int              Raises Overflow if it does not fit.
word_to_int_x    1  word -> int              Two's complement reinterpretation.
word_from_int    1  int -> word              Two's complement reinterpretation.
word_to_string   1  word -> string           Uppercase hexadecimal.

# --- real (IEEE double) ---
real_add         2  real * real -> real      Addition.
real_sub         2  real * real -> real      Subtraction.
real_mul         2  real * real -> real      Multiplication.
real_div         2  real * real -> real      Division.
real_neg         1  real -> real             Negation.
real_abs         1  real -> real             Absolute value.
real_lt          2  real * real -> bool      Less than.
real_le          2  real * real -> bool      Less or equal.
real_gt          2  real * real -> bool      Greater than.
real_ge          2  real * real -> bool      Greater or equal.
real_eq          2  real * real -> bool      IEEE equality.
real_floor       1  real -> int              Raises Overflow/Domain.
real_ceil        1  real -> int              Raises Overflow/Domain.
real_round       1  real -> int              Round to nearest even; raises Overflow/Domain.
real_trunc       1  real -> int              Raises Overflow/Domain.
real_to_string   1  real -> string           SML formatting (~ for negative, E exponent).
real_from_string 1  string -> real option    Parse a real literal.
real_sqrt        1  real -> real             Square root.
real_exp         1  real -> real             Exponential.
real_ln          1  real -> real             Natural logarithm.
real_sin         1  real -> real             Sine.
real_cos         1  real -> real             Cosine.
real_tan         1  real -> real             Tangent.
real_atan        1  real -> real             Arc tangent.
real_atan2       2  real * real -> real      Two argument arc tangent.
real_pow         2  real * real -> real      Power.
real_is_nan      1  real -> bool             NaN test.

# --- char ---
char_ord         1  char -> int              Code point.
char_lt          2  char * char -> bool      Less than.
char_le          2  char * char -> bool      Less or equal.
char_gt          2  char * char -> bool      Greater than.
char_ge          2  char * char -> bool      Greater or equal.

# --- string (8-bit byte strings) ---
string_size      1  string -> int            Length in bytes.
string_sub       2  string * int -> char     Indexing; raises Subscript.
string_concat    2  string * string -> string  Concatenation; raises Size above 1073741823 characters (String.maxSize).
string_extract   3  string * int * int -> string  extract(s, i, n): substring of length n; raises Subscript.
string_lt        2  string * string -> bool  Lexicographic less than.
string_le        2  string * string -> bool  Lexicographic less or equal.
string_gt        2  string * string -> bool  Lexicographic greater than.
string_ge        2  string * string -> bool  Lexicographic greater or equal.
string_compare   2  string * string -> int   Returns ~1, 0 or 1.
string_from_char 1  char -> string           One character string.
string_implode   1  char list -> string      Build a string from a list; raises Size above 1073741823 characters.
string_explode   1  string -> char list      List of characters.
string_concat_list 1 string list -> string   Concatenate a list of strings; raises Size above 1073741823 characters.

# --- ref / array / vector ---
ref_new          1  'a -> 'a ref             Allocate a reference cell.
ref_get          1  'a ref -> 'a             Dereference.
ref_set          2  'a ref * 'a -> unit      Assignment.
array_new        2  int * 'a -> 'a array     Allocate; raises Size if the length is negative or above 100000000.
array_length     1  'a array -> int          Length.
array_sub        2  'a array * int -> 'a     Indexing; raises Subscript.
array_update     3  'a array * int * 'a -> unit  Update; raises Subscript.
array_from_list  1  'a list -> 'a array      Build from a list; raises Size above 100000000 elements.
vector_from_list 1  'a list -> 'a vector     Build from a list; raises Size above 100000000 elements.
vector_length    1  'a vector -> int         Length.
vector_sub       2  'a vector * int -> 'a    Indexing; raises Subscript.

# --- I/O and system ---
print            1  string -> unit           Write to stdout.
print_err        1  string -> unit           Write to stderr.
flush_out        1  unit -> unit             Flush stdout.
input_line       1  unit -> string option    Read a line (including newline) from stdin.
input_all        1  unit -> string           Read the rest of stdin.
exit             1  int -> 'a                Terminate the process with the given status.
command_args     1  unit -> string list      Command line arguments after the bytecode file.
command_name     1  unit -> string           The bytecode file name.

# --- files (handles: 0 stdin, 1 stdout, 2 stderr, others from file_open) ---
file_open        2  string * int -> int option  Open a file (mode 0 read, 1 write/truncate, 2 append); NONE on failure.
file_close       1  int -> unit               Close a handle (no-op for 0-2 and already closed handles).
file_write       2  int * string -> bool      Write bytes; false if the handle is invalid or the write fails.
file_flush       1  int -> unit               Flush a handle.
file_read_line   1  int -> string option      Read a line including its newline (a last line without one gets it); NONE at end of file, and from then on.
file_read_all    1  int -> string             Read the rest of a handle, including what the file has gained since an end of file.
file_error       1  unit -> string            strerror text of the last failed file_open or file_write.

# --- added after the first release of the table (numbers are positions: append only) ---
word_neg         1  word -> word              Two's complement negation: 0 - w.
exn_name         1  exn -> string             The name of the exception constructor of an exception value.
real_floor_r     1  real -> real              Largest integral real not above the argument; zeros, infinities and NaN unchanged.
real_ceil_r      1  real -> real              Smallest integral real not below the argument.
real_trunc_r     1  real -> real              The argument without its fraction.
real_round_r     1  real -> real              Nearest integral real, ties to even; the sign of the argument is kept.
real_sign_bit    1  real -> bool              The sign bit, also of zeros and NaNs.
real_copy_sign   2  real * real -> real       The first argument with the sign of the second.
real_frexp_man   1  real -> real              man of x = man * 2^exp with 0.5 <= |man| < 1; x itself for zeros, infinities and NaN.
real_frexp_exp   1  real -> int               exp of the same; 0 for zeros, infinities and NaN.
real_ldexp       2  real * int -> real        x * 2^n, correctly rounded; overflows to an infinity, underflows to a zero.
real_next_after  2  real * real -> real       The next real after the first argument in the direction of the second.
real_rem         2  real * real -> real       x - n*y for n = trunc (x/y), computed exactly (C fmod).
real_fmt_e       2  real * int -> string      C printf %.*e of a finite real: n digits after the point, e.g. -1.50e+02.
real_fmt_f       2  real * int -> string      C printf %.*f of a finite real: n digits after the point.
real_shortest    1  real -> string            The %.*e rendering of a finite real with the fewest digits that reads back as the same real.
real_set_round   1  int -> unit               Rounding mode of the arithmetic: 0 nearest, 1 downward, 2 upward, 3 toward zero.
real_get_round   1  unit -> int               The current rounding mode, numbered likewise.
real_sinh        1  real -> real              Hyperbolic sine.
real_cosh        1  real -> real              Hyperbolic cosine.
real_tanh        1  real -> real              Hyperbolic tangent.
file_read_vec    2  int * int -> string       Read at most n bytes; "" at end of file. Raises Size for a negative n.
file_avail       1  int -> int                Bytes that can be read without waiting, ~1 when that cannot be told.
sys_errno        1  unit -> int               The errno of the last system call that failed.
sys_error_msg    1  int -> string             The text of an errno value.
sys_error_name   1  int -> string             The name of an errno value ("ENOENT"); "" when it has none.
sys_error_of_name 1 string -> int             The errno value of a name; ~1 when it is not known.
time_now         1  unit -> int               Microseconds since the epoch.
time_user        1  unit -> int               Processor time of this program in user mode, in microseconds.
time_sys         1  unit -> int               The same in system mode.
time_sleep       1  int -> unit               Wait for that many microseconds; a negative time waits not at all.
date_parts       2  int * int -> int list     Broken-down time (second, minute, hour, day, month, year - 1900, weekday, yearday, daylight saving) of a time in seconds, local when the second argument is 1; [] on failure.
date_seconds     2  int list * int -> int list  The reverse: the seconds, followed by the parts normalised; [] on failure.
date_offset      1  int -> int                Seconds by which local time is ahead of UTC at that time; raises Domain on failure.
date_format      3  string * int list * int -> string  strftime of the parts.
os_system        1  string -> int             Run a command with the shell and wait; what it exited with, or 128 plus the signal that ended it, or ~1.
os_getenv        1  string -> string option   The value of an environment variable.
file_errno       1  unit -> int               The errno of the last file_open or file_write that failed.
