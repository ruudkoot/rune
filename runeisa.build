(* The build file of the sources of runeisa, the generator of the
  instruction sets (docs/plans/middle-end.md, M1): the compiler's ordered
  maps, the language of the descriptions, the descriptions themselves, and
  what writes the files. scripts/gen-build-files.sh makes the build files of
  every host from this file -- edit only this file. The rules of rune.build
  hold here too. *)
build/config.sml
files
  lib/compiler/util/ordmap.sml
  src/isa/isa.sml
  src/isa/stack.sml
  src/isa/prims.sml
  src/isa/regs.sml
  src/isa/isagen.sml
  src/isa/reggen.sml
  src/isa/isamain.sml
end
src/main/runeisa-rune-main.sml
