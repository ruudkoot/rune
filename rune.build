(* Compiler libraries followed by the command-line driver. *)
(* build/config.sml, the version and the compiler's identity, is what make
   writes with scripts/gen-version.sh (docs/building.md, The compiler's
   identity) *)
libraries unicode json digest end
build/config.sml
use lib/compiler/internal.build
files
  src/isa/isa.sml
  src/isa/stack.sml
  src/opt/rbc.sml
  src/opt/rbccheck.sml
  src/driver/stackcheck.sml
  src/driver/options.sml
  src/driver/parallel.sml
  src/driver/cachecheck.sml
  src/driver/steps.sml
  src/driver/main.sml
  src/driver/serve.sml
end
src/main/rune-main.sml
