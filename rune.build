(* Compiler libraries followed by the command-line driver. *)
(* build/config.sml says the version, git's, and the compiler's identity, a
   hash of rune.plan and its closure (docs/building.md, The compiler's
   identity): scripts/gen-version.sh writes it, here as on the hosts. It
   reads scripts/plan-files.sh, rune.plan and every file the plan names, and
   git, which its stamp asks: the version alone, from --stamp. So it runs
   when one of those changed, and a build that is up to date runs it not at
   all (docs/build.md, Generated sources). *)
generate scripts/gen-version.sh (--config, rune.plan, build/config.sml)
  inputs scripts/plan-files.sh end
  closure rune.plan
  stamp scripts/gen-version.sh (--stamp)
  outputs build/config.sml end
build/config.sml
files
  lib/unicode/utf8_sig.sml
  lib/unicode/utf8.sml
  lib/unicode/width_data.sml
  lib/unicode/display_width_sig.sml
  lib/unicode/display_width.sml
  lib/unicode/grapheme_data.sml
  lib/unicode/grapheme_sig.sml
  lib/unicode/grapheme.sml
  lib/unicode/normalize_data.sml
  lib/unicode/normalize_sig.sml
  lib/unicode/normalize.sml
  lib/unicode/identifier_data.sml
  lib/unicode/identifier_sig.sml
  lib/unicode/identifier.sml
  lib/unicode/security_data.sml
  lib/unicode/security_sig.sml
  lib/unicode/security.sml
  lib/json/json_sig.sml
  lib/json/json.sml
  lib/digest/digest_sig.sml
  lib/digest/sha256.sml
  lib/digest/hex_sig.sml
  lib/digest/hex.sml
end
use lib/compiler/internal.build
files
  src/isa/isa.sml
  src/isa/stack.sml
  src/opt/rbc.sml
  src/opt/rbccheck.sml
  src/driver/stackcheck.sml
  src/driver/options.sml
  src/driver/parallel.sml
  src/driver/cachecheck.sml
  src/driver/steps.sml
  src/driver/main.sml
  src/driver/serve.sml
end
src/main/rune-main.sml
