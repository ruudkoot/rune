--- a/configure.ac
+++ b/configure.ac
@@ -279,8 +279,19 @@
 
 
 tmp_host=`echo $host_cpu | sed 's/\./_/'`
-AC_DEFINE_UNQUOTED(HAVE_HOST_CPU_$tmp_host)
-GMP_DEFINE_RAW("define_not_for_expansion(\`HAVE_HOST_CPU_$tmp_host')", POST)
+# --enable-fat on x86 promises a binary that runs on every CPU of that
+# family. longlong.h still picks lzcnt ("rep; bsr") and mulx from
+# HAVE_HOST_CPU_<model>. Those helpers are not fat-dispatched.
+define_host_cpu=yes
+if test "$enable_fat" = yes; then
+  case $host in
+    X86_PATTERN | X86_64_PATTERN) define_host_cpu=no ;;
+  esac
+fi
+if test "$define_host_cpu" = yes; then
+  AC_DEFINE_UNQUOTED(HAVE_HOST_CPU_$tmp_host)
+  GMP_DEFINE_RAW("define_not_for_expansion(\`HAVE_HOST_CPU_$tmp_host')", POST)
+fi
 
 dnl  The HAVE_HOST_CPU_ list here only needs to have entries for those which
 dnl  are going to be tested, not everything that can possibly be selected.
