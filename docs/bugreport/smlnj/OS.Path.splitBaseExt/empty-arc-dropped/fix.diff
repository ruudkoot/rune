     fun splitBaseExt p = let
-	  val {dir, file} = splitDirFile p
+	  val {file, ...} = splitDirFile p
 	  val (file', ext') = SS.splitr (fn c => c <> #".") (SS.full file)
 	  val fileLen = SS.size file'
-	  val (file, ext) =
-		if (fileLen <= 1) orelse (SS.isEmpty ext')
-		  then (file, NONE)
