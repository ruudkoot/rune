-#if defined(OPSYS_DARWIN) || defined(OPSYS_LINUX)
+/* support for ANSI C Floating-point extensions (Microsoft's C has <fenv.h>
+ * since Visual Studio 2013)
+ */
+#if defined(OPSYS_DARWIN) || defined(OPSYS_LINUX) \
