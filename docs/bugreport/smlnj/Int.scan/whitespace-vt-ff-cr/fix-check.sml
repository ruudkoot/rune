(* The table of ScanUtil (scan-util.sml) before and after fix.diff, copied
   into a standalone program, with its `code` function. After the fix a
   character's code is 128, the code of white space, exactly when Char.isSpace
   holds of it, and every other entry is as before.  Run: sml fix-check.sml *)
structure Old = struct
  val cvtTable = "\
	  \\255\255\255\255\255\255\255\255\255\128\128\255\255\255\255\255\
	  \\255\255\255\255\255\255\255\255\255\255\255\255\255\255\255\255\
	  \\128\255\255\255\255\255\255\255\255\255\255\129\255\130\131\255\
	  \\000\001\002\003\004\005\006\007\008\009\255\255\255\255\255\255\
	  \\255\010\011\012\013\014\015\016\017\018\019\020\021\022\023\024\
	  \\025\026\027\028\029\030\031\255\033\034\035\255\255\255\255\255\
	  \\255\010\011\012\013\014\015\016\017\018\019\020\021\022\023\024\
	  \\025\026\027\028\029\030\031\032\033\034\035\255\255\255\130\255\
	  \\255\255\255\255\255\255\255\255\255\255\255\255\255\255\255\255\
	  \\255\255\255\255\255\255\255\255\255\255\255\255\255\255\255\255\
	  \\255\255\255\255\255\255\255\255\255\255\255\255\255\255\255\255\
	  \\255\255\255\255\255\255\255\255\255\255\255\255\255\255\255\255\
	  \\255\255\255\255\255\255\255\255\255\255\255\255\255\255\255\255\
	  \\255\255\255\255\255\255\255\255\255\255\255\255\255\255\255\255\
	  \\255\255\255\255\255\255\255\255\255\255\255\255\255\255\255\255\
	  \\255\255\255\255\255\255\255\255\255\255\255\255\255\255\255\255\
	\"
  fun code (c : char) = Word.fromInt (Char.ord (String.sub (cvtTable, Char.ord c)))
end
structure New = struct
  val cvtTable = "\
	  \\255\255\255\255\255\255\255\255\255\128\128\128\128\128\255\255\
	  \\255\255\255\255\255\255\255\255\255\255\255\255\255\255\255\255\
	  \\128\255\255\255\255\255\255\255\255\255\255\129\255\130\131\255\
	  \\000\001\002\003\004\005\006\007\008\009\255\255\255\255\255\255\
	  \\255\010\011\012\013\014\015\016\017\018\019\020\021\022\023\024\
	  \\025\026\027\028\029\030\031\255\033\034\035\255\255\255\255\255\
	  \\255\010\011\012\013\014\015\016\017\018\019\020\021\022\023\024\
	  \\025\026\027\028\029\030\031\032\033\034\035\255\255\255\130\255\
	  \\255\255\255\255\255\255\255\255\255\255\255\255\255\255\255\255\
	  \\255\255\255\255\255\255\255\255\255\255\255\255\255\255\255\255\
	  \\255\255\255\255\255\255\255\255\255\255\255\255\255\255\255\255\
	  \\255\255\255\255\255\255\255\255\255\255\255\255\255\255\255\255\
	  \\255\255\255\255\255\255\255\255\255\255\255\255\255\255\255\255\
	  \\255\255\255\255\255\255\255\255\255\255\255\255\255\255\255\255\
	  \\255\255\255\255\255\255\255\255\255\255\255\255\255\255\255\255\
	  \\255\255\255\255\255\255\255\255\255\255\255\255\255\255\255\255\
	\"
  fun code (c : char) = Word.fromInt (Char.ord (String.sub (cvtTable, Char.ord c)))
end
val chars = List.tabulate (256, Char.chr)
val wrongWS = List.filter (fn c => (New.code c = 0w128) <> Char.isSpace c) chars
val changed = List.filter (fn c => New.code c <> Old.code c) chars
val oldWS = List.filter (fn c => (Old.code c = 0w128) <> Char.isSpace c) chars
fun names cs = String.concatWith " " (map Char.toString cs)
val () = print ("old table: white-space code differs from Char.isSpace for: " ^ names oldWS ^ "\n")
val () = print ("new table: white-space code differs from Char.isSpace for: " ^ (if null wrongWS then "none" else names wrongWS) ^ "\n")
val () = print ("entries changed: " ^ names changed ^ "\n")
val () = OS.Process.exit OS.Process.success
