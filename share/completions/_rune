#compdef rune

_arguments -s \
  '-o[write bytecode to FILE]:output file:_files' \
  '-i[start the REPL, rune-repl, with the files that follow]' \
  '--lib[directory holding the basis library in DIR/basis]:library directory:_files -/' \
  '--no-prelude[do not compile the basis library before the inputs]' \
  '--basis[which files of the basis library to compile]:mode:(demand all)' \
  '--basis-deps[print the basis library files the inputs load and exit]' \
  '--basis-check[check the MANIFEST of the basis library and exit]' \
  '--allow-prim[allow the _prim extension in the inputs]' \
  '--or-patterns[allow or-patterns (p1 | p2), which are not Standard ML]' \
  '*--default-type=[the type an open int or word constant defaults to in the inputs]:type:(int int64 word word64)' \
  '--units[compile every file as a unit of its own, and link them]' \
  '--emit-units[with --units, write the files of every unit into DIR]:directory:_files -/' \
  '--cache-dir[with --units, the cache of units]:directory:_files -/' \
  '--no-cache[with --units, compile every unit]' \
  '--explain-rebuild[with --units, say why each unit was compiled]' \
  '--typecheck-only[stop after type checking]' \
  '--no-warnings[do not print match warnings]' \
  '--dump-tokens[print the token stream]' \
  '--dump-ast[print the parsed program]' \
  '--dump-lambda[print the intermediate representation]' \
  '--dump-code[print the generated bytecode]' \
  '--target=[the bytecode to make]:target:(registers stack)' \
  '--version[print the version and exit]' \
  '(- *)'{-h,--help}'[print a usage summary and exit]' \
  '*:Standard ML source:_files -g "*.sml"'
