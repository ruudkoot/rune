(* Documentation generation reuses the compiler frontend. *)
(* build/config.sml, the version and the compiler's identity, is what make
   writes with scripts/gen-version.sh (docs/building.md, The compiler's
   identity) *)
libraries unicode json end
build/config.sml
use lib/compiler/frontend.build
files
  src/doc/docsource.sml
  src/doc/docdiag.sml
  src/doc/doccomments.sml
  src/doc/doctext.sml
  src/doc/dochead.sml
  src/doc/docir.sml
  src/doc/docextract.sml
  src/doc/docanchor.sml
  src/doc/docmarkdown.sml
  src/doc/docclaims.sml
  src/doc/docelab.sml
  src/doc/doctests.sml
  src/doc/docnotes.sml
  src/doc/docannot.sml
  src/doc/docresolve.sml
  src/doc/docpage.sml
  src/doc/docexamples.sml
  src/doc/doclaws.sml
  src/doc/docsite.sml
  src/doc/docmain.sml
end
src/main/runedoc-rune-main.sml
